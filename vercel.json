{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?(neotonestudio\\.app|neotone-studio\\.app|playneotone\\.app)$"
        }
      ],
      "destination": "https://www.lesagedavid.fr/neotone/",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?(handpanstudio\\.app|handpan-studio\\.app)$"
        }
      ],
      "destination": "https://www.lesagedavid.fr/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?(playhandpan\\.app|playhandpanstudio\\.app)$"
        }
      ],
      "destination": "https://play.handpanstudio.app/",
      "statusCode": 301
    },
    {
      "source": "/le-neotone{/}?",
      "has": [
        {
          "type": "host",
          "value": "^(lesagedavid\\.fr|project-a5vpj\\.vercel\\.app)$"
        }
      ],
      "destination": "https://www.lesagedavid.fr/neotone/",
      "statusCode": 301
    },
    {
      "source": "/:lang(en|es)/le-neotone{/}?",
      "has": [
        {
          "type": "host",
          "value": "^(lesagedavid\\.fr|project-a5vpj\\.vercel\\.app)$"
        }
      ],
      "destination": "https://www.lesagedavid.fr/:lang/neotone/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api(?:/|$))(?!_vercel(?:/|$))(?:[^/]+/)*[^/.]+)",
      "has": [
        {
          "type": "host",
          "value": "^(lesagedavid\\.fr|project-a5vpj\\.vercel\\.app)$"
        }
      ],
      "destination": "https://www.lesagedavid.fr/:path/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api(?:/|$))(?!_vercel(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "^(lesagedavid\\.fr|project-a5vpj\\.vercel\\.app)$"
        }
      ],
      "destination": "https://www.lesagedavid.fr/:path",
      "statusCode": 301
    },
    {
      "source": "/le-neotone",
      "destination": "/neotone/",
      "statusCode": 301
    },
    {
      "source": "/le-neotone/",
      "destination": "/neotone/",
      "statusCode": 301
    },
    {
      "source": "/en/le-neotone",
      "destination": "/en/neotone/",
      "statusCode": 301
    },
    {
      "source": "/en/le-neotone/",
      "destination": "/en/neotone/",
      "statusCode": 301
    },
    {
      "source": "/es/le-neotone",
      "destination": "/es/neotone/",
      "statusCode": 301
    },
    {
      "source": "/es/le-neotone/",
      "destination": "/es/neotone/",
      "statusCode": 301
    },
    {
      "source": "/handpan-studio",
      "destination": "/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/handpan-studio/",
      "destination": "/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/handpan-compagnon",
      "destination": "/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/handpan-compagnon/",
      "destination": "/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/en/handpan-studio",
      "destination": "/en/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/en/handpan-studio/",
      "destination": "/en/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/en/handpan-compagnon",
      "destination": "/en/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/en/handpan-compagnon/",
      "destination": "/en/handpan-app/",
      "statusCode": 301
    },
    {
      "source": "/en/pieds-atlas",
      "destination": "/en/handpan-stands/",
      "statusCode": 301
    },
    {
      "source": "/en/pieds-atlas/",
      "destination": "/en/handpan-stands/",
      "statusCode": 301
    },
    {
      "source": "/es/blog/:slug",
      "destination": "/blog/:slug/",
      "statusCode": 301
    },
    {
      "source": "/es/blog/:slug/",
      "destination": "/blog/:slug/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api(?:/|$))(?!_vercel(?:/|$))(?:[^/]+/)*[^/.]+)",
      "destination": "/:path/",
      "statusCode": 301
    }
  ]
}
