---
// ════════════════════════════════════════════════════════════════════════════
// BLOG ALLEMAND (06/11/2026, chantier 44) — MÊME DISPOSITIF QUE /es/blog
// ════════════════════════════════════════════════════════════════════════════
// Aucun article n'est traduit en allemand. Comme pour l'espagnol (voir
// `src/pages/es/blog/index.astro`, qui explique le pourquoi en détail), cette
// page liste les articles FRANÇAIS, chacun badgé « Auf Französisch », et pointe
// vers la route française `/blog/<permalink>`. Seul l'habillage est traduit.
//
// ⚠️ Pas de `src/pages/de/blog/[slug].astro`, délibérément : une URL `/de/`
// qui servirait du texte français serait mensongère. Les anciennes adresses
// `/de/blog/<slug>` sont redirigées vers le français dans vercel.json.
//
// LE JOUR OÙ des articles allemands existeront (frontmatter `lang: "de"`,
// accepté par `src/content.config.ts`), repasser cette page sur le modèle de
// `src/pages/en/blog/index.astro` et ajouter le `[slug]`.
// ════════════════════════════════════════════════════════════════════════════
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import BlogFilter from '@/components/BlogFilter.astro'
import { localizePath } from '@/i18n/utils'
import { breadcrumbLdJson } from '@/lib/ldJson'
import { categoryLabel } from '@/lib/blogCategories'

const lang = 'de' as const

// Articles FRANÇAIS : ce sont eux qu'on présente, faute de version allemande.
const posts = (await getCollection('blog', (e) => e.data.lang === 'fr' && !e.data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
)

const dateFmt = new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })
const title = 'Handpan-Blog: mit Farben lernen · David Lesage'
const description =
  'Der Blog von David Lesage: die ChromaKeys-Methode, der elektronische Handpan Neotone, eigene Tonleitern erstellen und Tipps, um Handpan anders zu lernen, ohne Notenlesen und Musiktheorie.'

const ldJSON = breadcrumbLdJson([
  { name: 'Start', url: '/de' },
  { name: 'Blog', url: '/de/blog' },
])
---

<Layout title={title} description={description} ldJSON={ldJSON}>
  <Section>
    <SectionHeading
      level={1}
      eyebrow="Blog"
      title="Handpan lernen, anders"
      intro="Farben, Formen und Emotionen: die Methode von David Lesage, der elektronische Handpan Neotone und Tutorials, mit denen du in deinem Tempo vorankommst."
      align="center"
    />

    <!-- L'avertissement est posé AVANT la liste, pas en bas de page : le lecteur
         doit savoir dans quelle langue il s'engage avant de choisir un article. -->
    <p
      class="mx-auto mt-8 max-w-2xl rounded-card border border-copper/30 bg-copper/5 px-5 py-4 text-center text-sm leading-relaxed text-ink-soft"
    >
      Die Blogartikel sind noch nicht ins Deutsche übersetzt: Du liest sie vorerst
      <strong class="font-700 text-ink">auf Französisch</strong>. Die Übersetzung ist in Arbeit.
    </p>

    <BlogFilter lang={lang} posts={posts} />

    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-blog-grid>
      {posts.map((post) => (
        <article
          data-category={post.data.category}
          class="group flex flex-col overflow-hidden rounded-card border border-ink/10 bg-cream-deep shadow-sm transition hover:-translate-y-1 hover:shadow-md"
        >
          {/* Lien vers la route FRANÇAISE : c'est là que vit l'article. */}
          <a href={localizePath(`/blog/${post.data.permalink}`, 'fr')} class="block">
            <img
              src={post.data.cover}
              alt={post.data.title}
              width="480"
              height="300"
              loading="lazy"
              class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </a>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex flex-wrap items-center gap-2 text-xs font-600 uppercase tracking-[0.12em] text-copper">
              <span>{categoryLabel(post.data.category, lang)}</span>
              <span class="text-ink-soft/60">· {dateFmt.format(post.data.pubDate)}</span>
              <span class="rounded-full bg-ink/8 px-2 py-0.5 normal-case tracking-normal text-ink-soft/80">
                🇫🇷 Auf Französisch
              </span>
            </div>
            <h2 class="mt-3 font-display text-xl font-700 leading-snug text-ink">
              <a
                href={localizePath(`/blog/${post.data.permalink}`, 'fr')}
                class="transition-colors group-hover:text-rust"
              >
                {post.data.title}
              </a>
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft/85">{post.data.description}</p>
            <span class="mt-4 text-sm font-700 text-rust">Artikel lesen (auf Französisch) →</span>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-10 text-center text-ink-soft/70" style="display:none" data-blog-empty>
      In dieser Kategorie gibt es noch keine Artikel.
    </p>
  </Section>
</Layout>
