---
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import Button from '@/components/Button.astro'
import YouTube from '@/components/YouTube.astro'
// 🖼️ Depuis le 27/08/2026 : les articles peuvent contenir des <figure> avec
//    <img data-lb data-lb-wide>. La lightbox est donc incluse sur TOUS les
//    articles — sans image marquée `data-lb`, elle reste invisible et inerte
//    (le <div id="lightbox"> est masqué par défaut). Ajout strictement additif.
import Lightbox from '@/components/Lightbox.astro'
import { localizePath } from '@/i18n/utils'
import { articleLdJson, breadcrumbLdJson, videoLdJson } from '@/lib/ldJson'
import { categoryLabel } from '@/lib/blogCategories'

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.data.lang === 'fr' && !e.data.draft)
  return posts.map((post) => ({
    params: { slug: post.data.permalink },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const d = post.data
const url = `/blog/${post.data.permalink}`

const dateFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
const iso = (date: Date) => date.toISOString()

const ldJSON: unknown[] = [
  articleLdJson({
    title: d.title,
    description: d.description,
    url,
    image: d.cover,
    datePublished: iso(d.pubDate),
    dateModified: d.updatedDate ? iso(d.updatedDate) : undefined,
  }),
  breadcrumbLdJson([
    { name: 'Accueil', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: d.title, url },
  ]),
]
if (d.youtubeId) ldJSON.push(...videoLdJson([{ id: d.youtubeId, name: d.title, description: d.description }]))
---

<Layout title={`${d.title} · David Lesage`} description={d.description} image={d.cover} ogType="article" ldJSON={ldJSON}>
  <Section width="narrow">
    <nav aria-label="Fil d'ariane" class="text-sm text-ink-soft/70">
      <a href={localizePath('/', 'fr')} class="hover:text-rust">Accueil</a>
      <span class="mx-1.5">/</span>
      <a href={localizePath('/blog', 'fr')} class="hover:text-rust">Blog</a>
      <span class="mx-1.5">/</span>
      <span class="text-ink-soft">{d.title}</span>
    </nav>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-2 text-xs font-600 uppercase tracking-[0.12em] text-copper">
        <a
          href={`${localizePath('/blog', 'fr')}?c=${d.category}`}
          class="rounded-full bg-copper/15 px-3 py-1 transition-colors hover:bg-copper hover:text-cream"
        >
          {categoryLabel(d.category, 'fr')}
        </a>
        {d.tags.map((tag) => <span class="rounded-full bg-ink/5 px-3 py-1">{tag}</span>)}
        <time datetime={iso(d.pubDate)} class="text-ink-soft/70">{dateFmt.format(d.pubDate)}</time>
      </div>
      <h1 class="mt-4 font-display text-3xl font-700 leading-tight text-ink md:text-4xl">{d.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft/85">{d.description}</p>
    </header>

    <img
      src={d.cover}
      alt={d.title}
      width="768"
      height="432"
      class="mt-8 aspect-[16/9] w-full rounded-card object-cover shadow-sm"
    />

    {d.youtubeId && (
      <div class="mt-8">
        <YouTube id={d.youtubeId} title={d.title} />
      </div>
    )}

    <div class="prose-blog mt-10">
      <Content />
    </div>

    <script>
      // Les liens externes d'un article s'ouvrent dans un nouvel onglet :
      // le visiteur garde le site ouvert derrière lui.
      document.querySelectorAll<HTMLAnchorElement>('.prose-blog a[href^="http"]').forEach((a) => {
        if (a.hostname && a.hostname !== window.location.hostname) {
          a.target = '_blank'
          a.rel = 'noopener'
        }
      })
    </script>

    <div class="mt-14 rounded-card border border-ink/10 bg-cream-deep p-8 text-center shadow-sm">
      <p class="font-display text-xl font-700 text-ink">Prêt à faire sonner tes couleurs ?</p>
      <p class="mt-2 text-ink-soft/85">Essaie l'application gratuitement, ou découvre le handpan électronique Neotone.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={localizePath('/handpan-app', 'fr')} variant="primary">Découvrir Handpan Constellation Studio</Button>
        <Button href={localizePath('/le-neotone', 'fr')} variant="ghost">Le Neotone</Button>
      </div>
    </div>
  </Section>

  <Lightbox labels={{ close: 'Fermer', prev: 'Image précédente', next: 'Image suivante', zoom: 'Agrandir la capture' }} />
</Layout>

<style>
  .prose-blog :global(h2) {
    font-family: var(--font-display, inherit);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-ink);
  }
  .prose-blog :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--color-ink);
  }
  .prose-blog :global(p) {
    margin-top: 1rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .prose-blog :global(ul),
  .prose-blog :global(ol) {
    margin-top: 1rem;
    padding-left: 1.5rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .prose-blog :global(ul) { list-style: disc; }
  .prose-blog :global(ol) { list-style: decimal; }
  .prose-blog :global(li) { margin-top: 0.4rem; }
  .prose-blog :global(li)::marker { color: var(--color-copper); }
  .prose-blog :global(a) {
    color: var(--color-rust);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-blog :global(a:hover) { color: var(--color-copper); }
  .prose-blog :global(strong) { color: var(--color-ink); font-weight: 700; }
  .prose-blog :global(blockquote) {
    margin-top: 1.5rem;
    border-left: 3px solid var(--color-copper);
    padding-left: 1.25rem;
    font-style: italic;
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }

  /* ════════ 🖼️ IMAGES LÉGENDÉES DANS UN ARTICLE — ajouté le 27/08/2026 ════════
     Le gabarit du blog n'avait AUCUN style de <figure> : une image posée dans un
     `.md` s'affichait nue, pleine largeur, sans légende distincte. Le vocabulaire
     visuel repris ici est celui, déjà déployé, de `/yishama` et `/cours` — coins
     `rounded-card`, filet `border-ink/10`, ombre portée, légende centrée en
     `text-sm text-ink-soft/70`. Rien n'est inventé.
     ⚠️ Strictement ADDITIF : aucun autre article ne contient de <figure>, leur
     rendu est donc inchangé (vérifié article par article le 27/08/2026). */
  .prose-blog :global(figure) {
    margin-top: 2.25rem;
    margin-bottom: 2.25rem;
  }
  .prose-blog :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    box-shadow: 0 18px 40px -22px rgba(31, 22, 17, 0.55);
  }
  .prose-blog :global(figcaption) {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink-soft) 78%, transparent);
  }
  /* 🔍 La ligne « clique pour agrandir » est une LIGNE À PART, jamais un bout de
     légende : la légende est la voix de David, on n'y colle pas un mode d'emploi.
     (Même règle que `insAppZoomHint` sur /yishama.) */
  .prose-blog :global(.figure-hint) {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-ink-soft) 62%, transparent);
  }
  .prose-blog :global(.figure-hint svg) {
    width: 0.9rem;
    height: 0.9rem;
    flex: none;
    color: var(--color-copper);
  }

  /* ════════ 📊 TABLEAUX — ajouté le 27/08/2026 ════════
     `prose-blog` ne stylait pas les tableaux alors que QUATRE articles en
     contiennent déjà (`setup-nomade-neotone-bose-s1` et `quel-casque-choisir-neotone`,
     FR + EN) : colonnes collées, aucune séparation, en-tête indistinct.
     Le texte des cellules revient à la ligne (pas de défilement horizontal) :
     ces tableaux sont des tableaux de PRIX, pas de données larges, et une page
     qui déborde latéralement sur un téléphone est pire qu'une cellule haute. */
  .prose-blog :global(table) {
    width: 100%;
    margin-top: 1.5rem;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .prose-blog :global(thead) { background: var(--color-cream-deep); }
  .prose-blog :global(th) {
    text-align: left;
    font-weight: 700;
    color: var(--color-ink);
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid color-mix(in srgb, var(--color-copper) 45%, transparent);
  }
  .prose-blog :global(td) {
    padding: 0.6rem 0.75rem;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .prose-blog :global(tbody tr:last-child td) { border-bottom: 0; }

  /* ════════ 🛰️ MAQUETTE INTERACTIVE EMBARQUÉE — ajouté le 06/09/2026 ════════
     UN SEUL article s'en sert : `la-carte-des-joueurs` (FR + EN), qui embarque
     le prototype de la carte des joueurs servi par l'app
     (`play.handpanstudio.app/prototypes/…`). Aucune copie locale : une seule
     source, donc aucune divergence possible.
     ⚠️ Le bandeau « maquette » n'est PAS décoratif. Le prototype montre DOUZE
     joueurs FICTIFS (Lena, Kenji, Aïcha…) alors que l'article se termine sur un
     fait vérifié : l'application comptait UNE étoile le 1er septembre 2026.
     Ne jamais retirer ni alléger ce bandeau.
     📱 Sous 900 px le cadre est masqué et remplacé par un lien plein écran :
     le prototype est une mise en page de bureau (carte 2,65:1 + panneau
     latéral) ; dans un iframe de ~343 px la carte tombe à ~125 px de haut et
     les étiquettes des étoiles deviennent illisibles. Le lecteur mobile garde
     l'image légendée, qui elle reste nette.
     Strictement ADDITIF : aucun autre article ne contient `.embed-maquette`. */
  .prose-blog :global(.embed-maquette) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-copper) 50%, transparent);
    overflow: hidden;
    background: var(--color-cream-deep);
  }
  .prose-blog :global(.embed-maquette-bandeau) {
    margin: 0;
    padding: 0.65rem 0.95rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-copper) 35%, transparent);
  }
  .prose-blog :global(.embed-maquette-bandeau strong) {
    color: var(--color-rust, var(--color-copper));
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.74rem;
  }
  .prose-blog :global(.embed-maquette iframe) {
    display: block;
    width: 100%;
    height: 1000px;
    max-width: 100%;
    border: 0;
    background: #0d1b2a;
  }
  /* Le bac à sable du profil public est plus haut que la carte : deux colonnes
     (formulaire + aperçu) suivies d'une section technique. */
  .prose-blog :global(.embed-maquette-haute iframe) { height: 1500px; }
  .prose-blog :global(.embed-maquette-pied) {
    margin: 0;
    padding: 0.55rem 0.95rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-ink-soft) 62%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  /* Le repli mobile : affiché UNIQUEMENT quand le cadre ne l'est pas. */
  .prose-blog :global(.embed-maquette-mobile) { display: none; }
  @media (max-width: 900px) {
    .prose-blog :global(.embed-maquette),
    .prose-blog :global(.embed-maquette-intro) { display: none; }
    .prose-blog :global(.embed-maquette-mobile) {
      display: block;
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      padding: 0.85rem 0.95rem;
      border-radius: var(--radius-card);
      border: 1px solid color-mix(in srgb, var(--color-copper) 50%, transparent);
      background: var(--color-cream-deep);
      font-size: 0.85rem;
      line-height: 1.6;
    }
  }
</style>
