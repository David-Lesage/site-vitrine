---
// =============================================================================
// /commande-muling/ : dépôt de la preuve de virement et annulation, depuis le lien personnel
// de l'e-mail (`?t=<jeton>&l=fr|en|es`, `&action=annuler`). Page autonome, jamais indexée.
// Ouvrir le lien ne fait RIEN (les antivirus ouvrent les liens) ; la page lit
// l'état (op 'view'), puis n'agit qu'au clic, par POST. Le jeton est vérifié côté serveur.
// =============================================================================
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>Muling : ma commande</title>
  <style is:global>
    :root { --ink:#1f1a17; --soft:#5b524c; --rust:#b4462a; --cream:#faf6f0; --line:#e7d9c6; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--cream); color:var(--ink); font:16px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; }
    main { max-width:560px; margin:0 auto; padding:32px 16px 48px; }
    .brand { font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--rust); font-weight:700; margin:0; }
    h1 { font-size:24px; line-height:1.25; margin:8px 0 12px; }
    .card { background:#fff; border:1px solid var(--line); border-radius:14px; padding:20px; margin-top:16px; }
    dl { margin:0; display:grid; grid-template-columns:auto 1fr; gap:4px 14px; font-size:15px; }
    dt { color:var(--soft); } dd { margin:0; font-weight:700; overflow-wrap:anywhere; }
    label { display:block; font-weight:600; font-size:14px; margin-top:14px; }
    input { width:100%; margin-top:4px; padding:11px 12px; border:1px solid #cdbfae; border-radius:10px; font:inherit; background:#fff; }
    button, .btn { display:block; width:100%; margin-top:16px; padding:13px 20px; min-height:44px; border-radius:999px; border:1px solid var(--rust); background:var(--rust); color:#fff; font:inherit; font-weight:700; cursor:pointer; }
    button:disabled { opacity:.6; cursor:default; }
    button.sec { background:#fff; color:#7a3a26; border-color:#c9b6a8; }
    button:focus-visible, input:focus-visible { outline:3px solid #d08a4a; outline-offset:2px; }
    .note { font-size:13px; color:var(--soft); margin:10px 0 0; }
    .err { color:#a3261a; font-weight:600; font-size:14px; margin:12px 0 0; }
  </style>
</head>
<body>
  <main>
    <p class="brand">David Lesage · Muling</p>
    <div id="app" aria-live="polite"><p>…</p></div>
  </main>
  <script is:inline src="/muling-preparer-fichier.js"></script>
  <script is:inline>
  (function () {
    var q = new URLSearchParams(location.search)
    var token = q.get('t') || ''
    var wantCancel = q.get('action') === 'annuler'
    var lang = ['fr', 'en', 'es', 'de'].indexOf(q.get('l')) >= 0 ? q.get('l') : 'fr'
    // Test local seulement : ?api=http://localhost:… (ignoré en production).
    var api = (/^(localhost|127\.0\.0\.1)$/.test(location.hostname) && q.get('api')) || '/api/muling-proof-link'
    var MAX = 3 * 1024 * 1024
    var app = document.getElementById('app')
    var T = {
      fr: {
        title: 'Déposer ma preuve de virement', ref: 'Référence', amount: 'Montant de la commande',
        file: 'Preuve de virement', fileNote: 'Photo, capture d’écran ou PDF. Une photo lourde est réduite automatiquement ; un PDF ne doit pas dépasser 3 Mo.',
        send: 'Envoyer ma preuve', sending: 'Envoi…', toCancel: 'Annuler ma commande',
        doneT: 'Ta preuve est bien reçue', done: 'Elle est transmise à Muling avec les informations de ta commande. Un e-mail de confirmation arrive : garde-le. Muling vérifie le virement avant toute expédition.',
        doneShowroom: 'Elle est transmise à Muling. Un e-mail de confirmation arrive : garde-le. Ton micro t’attend au showroom, rien ne sera expédié. Réponds à cet e-mail pour proposer une date de retrait.',
        cancelT: 'Annuler ma commande ?', cancelText: 'Cette action annule définitivement la commande. Rien n’est annulé tant que tu n’as pas confirmé ci-dessous.', cancelYes: 'Oui, annuler ma commande', cancelNo: 'Non, garder ma commande',
        cancelledT: 'Ta commande est annulée', cancelled: 'C’est fait. Un e-mail de confirmation arrive.',
        badT: 'Ce lien n’est plus valable', bad: 'Il a expiré, ou il a déjà servi. Indique l’e-mail de ta commande : si elle attend encore ta preuve, tu recevras un nouveau lien.',
        email: 'Adresse e-mail de la commande', newLink: 'Recevoir un nouveau lien', linkSent: 'Si une commande attend une preuve sur cette adresse, un nouveau lien vient de partir. Regarde ta boîte e-mail.',
        eMissing: 'Choisis un fichier.', eType: 'Format non lu : envoie une photo, une capture d’écran ou un PDF.', eBig: 'Fichier trop lourd : 3 Mo maximum pour un PDF.', eMany: 'Trop de tentatives. Réessaie dans une heure.', eLocked: 'Cette commande ne peut plus être modifiée ici. Écris à contact@lesagedavid.fr.', eGen: 'Une erreur est survenue. Réessaie dans quelques minutes.', eEmail: 'Indique une adresse e-mail valide.',
      },
      en: {
        title: 'Upload my proof of transfer', ref: 'Reference', amount: 'Order amount',
        file: 'Proof of transfer', fileNote: 'Photo, screenshot or PDF. A large photo is reduced automatically; a PDF must not exceed 3 MB.',
        send: 'Send my proof', sending: 'Sending…', toCancel: 'Cancel my order',
        doneT: 'Your proof has been received', done: 'It has been sent to Muling with your order details. A confirmation email is on its way: keep it. Muling checks the transfer before shipping anything.',
        doneShowroom: 'It has been sent to Muling. A confirmation email is on its way: keep it. Your mic is waiting at the showroom, nothing will be shipped. Reply to that email to suggest a pick-up date.',
        cancelT: 'Cancel my order?', cancelText: 'This permanently cancels the order. Nothing is cancelled until you confirm below.', cancelYes: 'Yes, cancel my order', cancelNo: 'No, keep my order',
        cancelledT: 'Your order is cancelled', cancelled: 'Done. A confirmation email is on its way.',
        badT: 'This link is no longer valid', bad: 'It has expired or already been used. Enter your order’s email: if it is still waiting for your proof, you’ll get a new link.',
        email: 'Order email address', newLink: 'Get a new link', linkSent: 'If an order is waiting for a proof at this address, a new link has just been sent. Check your inbox.',
        eMissing: 'Choose a file.', eType: 'Format not readable: send a photo, a screenshot or a PDF.', eBig: 'File too large: 3 MB max for a PDF.', eMany: 'Too many attempts. Try again in an hour.', eLocked: 'This order can no longer be changed here. Please write to contact@lesagedavid.fr.', eGen: 'Something went wrong. Try again in a few minutes.', eEmail: 'Enter a valid email address.',
      },
      es: {
        title: 'Subir mi comprobante de transferencia', ref: 'Referencia', amount: 'Importe del pedido',
        file: 'Comprobante de transferencia', fileNote: 'Foto, captura de pantalla o PDF. Una foto pesada se reduce automáticamente; un PDF no debe superar 3 MB.',
        send: 'Enviar mi comprobante', sending: 'Enviando…', toCancel: 'Cancelar mi pedido',
        doneT: 'Hemos recibido tu comprobante', done: 'Se ha enviado a Muling con los datos de tu pedido. Te llegará un correo de confirmación: guárdalo. Muling comprueba la transferencia antes de cualquier envío.',
        doneShowroom: 'Se ha enviado a Muling. Te llegará un correo de confirmación: guárdalo. Tu micrófono te espera en el showroom, no se enviará nada. Responde a ese correo para proponer una fecha de recogida.',
        cancelT: '¿Cancelar mi pedido?', cancelText: 'Esta acción cancela el pedido definitivamente. No se cancela nada hasta que confirmes abajo.', cancelYes: 'Sí, cancelar mi pedido', cancelNo: 'No, conservar mi pedido',
        cancelledT: 'Tu pedido está cancelado', cancelled: 'Listo. Te llegará un correo de confirmación.',
        badT: 'Este enlace ya no es válido', bad: 'Ha caducado o ya se ha usado. Indica el correo de tu pedido: si aún espera tu comprobante, recibirás un enlace nuevo.',
        email: 'Correo del pedido', newLink: 'Recibir un enlace nuevo', linkSent: 'Si hay un pedido a la espera de comprobante en esta dirección, acaba de salir un enlace nuevo. Revisa tu correo.',
        eMissing: 'Elige un archivo.', eType: 'Formato no legible: envía una foto, una captura o un PDF.', eBig: 'Archivo demasiado grande: 3 MB máximo.', eMany: 'Demasiados intentos. Inténtalo dentro de una hora.', eLocked: 'Este pedido ya no se puede modificar aquí. Escribe a contact@lesagedavid.fr.', eGen: 'Se ha producido un error. Inténtalo de nuevo en unos minutos.', eEmail: 'Indica un correo válido.',
      },
      de: {
        title: 'Überweisungsnachweis hochladen', ref: 'Referenz', amount: 'Bestellbetrag',
        file: 'Überweisungsnachweis', fileNote: 'Foto, Screenshot oder PDF. Ein großes Foto wird automatisch verkleinert; ein PDF darf höchstens 3 MB groß sein.',
        send: 'Nachweis senden', sending: 'Wird gesendet …', toCancel: 'Bestellung stornieren',
        doneT: 'Dein Nachweis ist angekommen', done: 'Er wurde mit den Angaben zu deiner Bestellung an Muling weitergeleitet. Du bekommst gleich eine Bestätigung per E-Mail: Bewahre sie auf. Muling prüft die Überweisung, bevor etwas verschickt wird.',
        doneShowroom: 'Er wurde an Muling weitergeleitet. Du bekommst gleich eine Bestätigung per E-Mail: Bewahre sie auf. Dein Mikrofon wartet im Showroom auf dich, es wird nichts verschickt. Antworte auf diese E-Mail, um einen Abholtermin vorzuschlagen.',
        cancelT: 'Bestellung stornieren?', cancelText: 'Damit wird die Bestellung endgültig storniert. Es wird nichts storniert, solange du es unten nicht bestätigst.', cancelYes: 'Ja, Bestellung stornieren', cancelNo: 'Nein, Bestellung behalten',
        cancelledT: 'Deine Bestellung ist storniert', cancelled: 'Erledigt. Du bekommst gleich eine Bestätigung per E-Mail.',
        badT: 'Dieser Link ist nicht mehr gültig', bad: 'Er ist abgelaufen oder wurde schon benutzt. Gib die E-Mail-Adresse deiner Bestellung ein: Wartet sie noch auf deinen Nachweis, bekommst du einen neuen Link.',
        email: 'E-Mail-Adresse der Bestellung', newLink: 'Neuen Link anfordern', linkSent: 'Wenn zu dieser Adresse eine Bestellung auf einen Nachweis wartet, ist gerade ein neuer Link verschickt worden. Schau in dein Postfach.',
        eMissing: 'Wähle eine Datei.', eType: 'Format nicht lesbar: Schick ein Foto, einen Screenshot oder ein PDF.', eBig: 'Datei zu groß: maximal 3 MB für ein PDF.', eMany: 'Zu viele Versuche. Versuch es in einer Stunde noch einmal.', eLocked: 'Diese Bestellung lässt sich hier nicht mehr ändern. Schreib an contact@lesagedavid.fr.', eGen: 'Es ist ein Fehler aufgetreten. Versuch es in ein paar Minuten noch einmal.', eEmail: 'Gib eine gültige E-Mail-Adresse ein.',
      },
    }
    var t = T[lang]
    document.documentElement.lang = lang
    var order = null

    function el(tag, attrs, kids) {
      var n = document.createElement(tag)
      Object.keys(attrs || {}).forEach(function (k) {
        if (k === 'text') n.textContent = attrs[k]
        else if (k.slice(0, 2) === 'on') n.addEventListener(k.slice(2), attrs[k])
        else n.setAttribute(k, attrs[k])
      })
      ;(kids || []).forEach(function (c) { if (c) n.appendChild(c) })
      return n
    }
    function show(nodes) { app.textContent = ''; nodes.forEach(function (x) { if (x) app.appendChild(x) }) }
    function post(body) {
      return fetch(api, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function (r) { return r.json().catch(function () { return {} }).then(function (d) { return { status: r.status, ok: r.ok, data: d } }) })
    }
    function message(res) {
      if (res.status === 429) return t.eMany
      if (res.status === 409) return t.eLocked
      if (res.data && res.data.error === 'file_too_large' || res.status === 413) return t.eBig
      if (res.data && res.data.error === 'invalid_file_type') return t.eType
      return t.eGen
    }
    function recap() {
      return el('dl', {}, [
        el('dt', { text: t.ref }), el('dd', { text: order.ref }),
        el('dt', { text: t.amount }), el('dd', { text: order.amount + ' EUR' }),
      ])
    }
    function ecranMessage(titre, texte) { show([el('h1', { text: titre }), el('p', { text: texte })]) }

    function ecranInvalide() {
      var err = el('p', { class: 'err', hidden: 'hidden' })
      var input = el('input', { type: 'email', id: 'e', autocomplete: 'email' })
      var btn = el('button', { type: 'submit', text: t.newLink })
      show([el('h1', { text: t.badT }), el('p', { text: t.bad }), el('form', { class: 'card', novalidate: 'novalidate', onsubmit: function (e) {
        e.preventDefault(); err.hidden = true
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(input.value.trim())) { err.textContent = t.eEmail; err.hidden = false; return }
        btn.disabled = true
        post({ op: 'resume', email: input.value.trim(), lang: lang }).then(function (r) {
          if (r.ok) { ecranMessage(t.badT, t.linkSent); return }
          err.textContent = message(r); err.hidden = false; btn.disabled = false
        }).catch(function () { err.textContent = t.eGen; err.hidden = false; btn.disabled = false })
      } }, [el('label', { for: 'e', text: t.email }), input, btn, err])])
    }

    function ecranAnnuler() {
      var err = el('p', { class: 'err', hidden: 'hidden' })
      var oui = el('button', { type: 'button', text: t.cancelYes, onclick: function () {
        oui.disabled = true; err.hidden = true
        post({ op: 'cancel', t: token, confirm: true }).then(function (r) {
          if (r.ok) return ecranMessage(t.cancelledT, t.cancelled)
          if (r.status === 404) return ecranInvalide()
          err.textContent = message(r); err.hidden = false; oui.disabled = false
        }).catch(function () { err.textContent = t.eGen; err.hidden = false; oui.disabled = false })
      } })
      show([el('h1', { text: t.cancelT }), el('p', { text: t.cancelText }), el('div', { class: 'card' }, [recap(), oui,
        el('button', { type: 'button', class: 'sec', text: t.cancelNo, onclick: ecranDepot }), err])])
    }

    function ecranDepot() {
      var err = el('p', { class: 'err', hidden: 'hidden' })
      var file = el('input', { type: 'file', id: 'f', accept: 'image/*,application/pdf' })
      var btn = el('button', { type: 'submit', text: t.send })
      function dire(m) { err.textContent = m; err.hidden = false }
      show([el('h1', { text: t.title }), el('form', { class: 'card', novalidate: 'novalidate', onsubmit: function (e) {
        e.preventDefault(); err.hidden = true
        var f = file.files && file.files[0]
        if (!f) return dire(t.eMissing)
        if (f.type !== 'application/pdf' && f.type.indexOf('image/') !== 0) return dire(t.eType)
        if (f.type === 'application/pdf' && f.size > MAX) return dire(t.eBig)
        btn.disabled = true; btn.textContent = t.sending
        function rendre(m) { dire(m); btn.disabled = false; btn.textContent = t.send }
        // Le serveur reste seul juge du type réel (signature PDF, PNG, JPEG) et du poids.
        window.mulingPreparerFichier(f, MAX).then(function (pret) { envoyer(pret) }).catch(function (e) {
          rendre(e && e.message === 'trop_lourd' ? t.eBig : t.eType)
        })
        function envoyer(pret) {
        var rd = new FileReader()
        rd.onerror = function () { rendre(t.eGen) }
        rd.onload = function () {
          post({ op: 'deposit', t: token, fileBase64: String(rd.result).split(',')[1] || '', lang: lang }).then(function (r) {
            if (r.ok) return ecranMessage(t.doneT, order.showroom ? t.doneShowroom : t.done)
            if (r.status === 404) return ecranInvalide()
            dire(message(r)); btn.disabled = false; btn.textContent = t.send
          }).catch(function () { dire(t.eGen); btn.disabled = false; btn.textContent = t.send })
        }
        rd.readAsDataURL(pret)
        }
      } }, [recap(), el('label', { for: 'f', text: t.file }), file, el('p', { class: 'note', text: t.fileNote }),
        btn, err,
        el('button', { type: 'button', class: 'sec', text: t.toCancel, onclick: ecranAnnuler })])])
    }

    if (!token) { ecranInvalide(); return }
    post({ op: 'view', t: token }).then(function (r) {
      if (r.status === 429) return ecranMessage(t.badT, t.eMany)
      if (!r.ok) return r.status === 404 ? ecranInvalide() : ecranMessage(t.badT, t.eGen)
      order = r.data
      if (wantCancel) ecranAnnuler(); else ecranDepot()
    }).catch(function () { ecranMessage(t.badT, t.eGen) })
  })()
  </script>
</body>
</html>
