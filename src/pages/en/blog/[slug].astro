---
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import Button from '@/components/Button.astro'
import YouTube from '@/components/YouTube.astro'
// 🖼️ Since 27/08/2026: articles may contain <figure> blocks with
//    <img data-lb data-lb-wide>. The lightbox is therefore included on EVERY
//    article — with no `data-lb` image it stays invisible and inert (the
//    <div id="lightbox"> is hidden by default). Strictly additive.
import Lightbox from '@/components/Lightbox.astro'
import { localizePath } from '@/i18n/utils'
import { articleLdJson, breadcrumbLdJson, videoLdJson } from '@/lib/ldJson'
import { categoryLabel } from '@/lib/blogCategories'

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.data.lang === 'en' && !e.data.draft)
  return posts.map((post) => ({
    params: { slug: post.data.permalink },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const d = post.data
const url = `/en/blog/${post.data.permalink}`

const dateFmt = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', year: 'numeric' })
const iso = (date: Date) => date.toISOString()

const ldJSON: unknown[] = [
  articleLdJson({
    title: d.title,
    description: d.description,
    url,
    image: d.cover,
    datePublished: iso(d.pubDate),
    dateModified: d.updatedDate ? iso(d.updatedDate) : undefined,
  }),
  breadcrumbLdJson([
    { name: 'Home', url: '/en' },
    { name: 'Blog', url: '/en/blog' },
    { name: d.title, url },
  ]),
]
if (d.youtubeId) ldJSON.push(...videoLdJson([{ id: d.youtubeId, name: d.title, description: d.description }]))
---

<Layout title={`${d.title} · David Lesage`} description={d.description} image={d.cover} ogType="article" ldJSON={ldJSON}>
  <Section width="narrow">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-soft/70">
      <a href={localizePath('/', 'en')} class="hover:text-rust">Home</a>
      <span class="mx-1.5">/</span>
      <a href={localizePath('/blog', 'en')} class="hover:text-rust">Blog</a>
      <span class="mx-1.5">/</span>
      <span class="text-ink-soft">{d.title}</span>
    </nav>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-2 text-xs font-600 uppercase tracking-[0.12em] text-copper">
        <a
          href={`${localizePath('/blog', 'en')}?c=${d.category}`}
          class="rounded-full bg-copper/15 px-3 py-1 transition-colors hover:bg-copper hover:text-cream"
        >
          {categoryLabel(d.category, 'en')}
        </a>
        {d.tags.map((tag) => <span class="rounded-full bg-ink/5 px-3 py-1">{tag}</span>)}
        <time datetime={iso(d.pubDate)} class="text-ink-soft/70">{dateFmt.format(d.pubDate)}</time>
      </div>
      <h1 class="mt-4 font-display text-3xl font-700 leading-tight text-ink md:text-4xl">{d.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft/85">{d.description}</p>
    </header>

    <img
      src={d.cover}
      alt={d.title}
      width="768"
      height="432"
      class="mt-8 aspect-[16/9] w-full rounded-card object-cover shadow-sm"
    />

    {d.youtubeId && (
      <div class="mt-8">
        <YouTube id={d.youtubeId} title={d.title} />
      </div>
    )}

    <div class="prose-blog mt-10">
      <Content />
    </div>

    <script>
      // External links inside an article open in a new tab: the visitor keeps the site open.
      document.querySelectorAll<HTMLAnchorElement>('.prose-blog a[href^="http"]').forEach((a) => {
        if (a.hostname && a.hostname !== window.location.hostname) {
          a.target = '_blank'
          a.rel = 'noopener'
        }
      })
    </script>

    <div class="mt-14 rounded-card border border-ink/10 bg-cream-deep p-8 text-center shadow-sm">
      <p class="font-display text-xl font-700 text-ink">Ready to make your colours sing?</p>
      <p class="mt-2 text-ink-soft/85">Try the app for free, or discover the electronic Neotone handpan.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={localizePath('/handpan-app', 'en')} variant="primary">Discover Handpan Constellation Studio</Button>
        <Button href={localizePath('/le-neotone', 'en')} variant="ghost">The Neotone</Button>
      </div>
    </div>
  </Section>

  <Lightbox labels={{ close: 'Close', prev: 'Previous image', next: 'Next image', zoom: 'Enlarge screenshot' }} />
</Layout>

<style>
  .prose-blog :global(h2) {
    font-family: var(--font-display, inherit);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-ink);
  }
  .prose-blog :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--color-ink);
  }
  .prose-blog :global(p) {
    margin-top: 1rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .prose-blog :global(ul),
  .prose-blog :global(ol) {
    margin-top: 1rem;
    padding-left: 1.5rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .prose-blog :global(ul) { list-style: disc; }
  .prose-blog :global(ol) { list-style: decimal; }
  .prose-blog :global(li) { margin-top: 0.4rem; }
  .prose-blog :global(li)::marker { color: var(--color-copper); }
  .prose-blog :global(a) {
    color: var(--color-rust);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-blog :global(a:hover) { color: var(--color-copper); }
  .prose-blog :global(strong) { color: var(--color-ink); font-weight: 700; }
  .prose-blog :global(blockquote) {
    margin-top: 1.5rem;
    border-left: 3px solid var(--color-copper);
    padding-left: 1.25rem;
    font-style: italic;
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }

  /* ════════ 🖼️ IMAGES LÉGENDÉES DANS UN ARTICLE — ajouté le 27/08/2026 ════════
     Le gabarit du blog n'avait AUCUN style de <figure> : une image posée dans un
     `.md` s'affichait nue, pleine largeur, sans légende distincte. Le vocabulaire
     visuel repris ici est celui, déjà déployé, de `/yishama` et `/cours` — coins
     `rounded-card`, filet `border-ink/10`, ombre portée, légende centrée en
     `text-sm text-ink-soft/70`. Rien n'est inventé.
     ⚠️ Strictement ADDITIF : aucun autre article ne contient de <figure>, leur
     rendu est donc inchangé (vérifié article par article le 27/08/2026). */
  .prose-blog :global(figure) {
    margin-top: 2.25rem;
    margin-bottom: 2.25rem;
  }
  .prose-blog :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    box-shadow: 0 18px 40px -22px rgba(31, 22, 17, 0.55);
  }
  .prose-blog :global(figcaption) {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink-soft) 78%, transparent);
  }
  /* 🔍 La ligne « clique pour agrandir » est une LIGNE À PART, jamais un bout de
     légende : la légende est la voix de David, on n'y colle pas un mode d'emploi.
     (Même règle que `insAppZoomHint` sur /yishama.) */
  .prose-blog :global(.figure-hint) {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-ink-soft) 62%, transparent);
  }
  .prose-blog :global(.figure-hint svg) {
    width: 0.9rem;
    height: 0.9rem;
    flex: none;
    color: var(--color-copper);
  }

  /* ════════ 📊 TABLEAUX — ajouté le 27/08/2026 ════════
     `prose-blog` ne stylait pas les tableaux alors que QUATRE articles en
     contiennent déjà (`setup-nomade-neotone-bose-s1` et `quel-casque-choisir-neotone`,
     FR + EN) : colonnes collées, aucune séparation, en-tête indistinct.
     Le texte des cellules revient à la ligne (pas de défilement horizontal) :
     ces tableaux sont des tableaux de PRIX, pas de données larges, et une page
     qui déborde latéralement sur un téléphone est pire qu'une cellule haute. */
  .prose-blog :global(table) {
    width: 100%;
    margin-top: 1.5rem;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }
  .prose-blog :global(thead) { background: var(--color-cream-deep); }
  .prose-blog :global(th) {
    text-align: left;
    font-weight: 700;
    color: var(--color-ink);
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid color-mix(in srgb, var(--color-copper) 45%, transparent);
  }
  .prose-blog :global(td) {
    padding: 0.6rem 0.75rem;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .prose-blog :global(tbody tr:last-child td) { border-bottom: 0; }
</style>
