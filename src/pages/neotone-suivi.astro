---
// =============================================================================
// /neotone-suivi/ — page des liens « en un clic » du processus d'achat Neotone
// (25/10/2026). Ouverte depuis les mails (David ou client) avec `?t=<jeton>`.
// Page AUTONOME (pas de Layout : pas de redirection de langue, pas d'en-tête),
// jamais indexée. Elle ne fait RIEN à l'ouverture : elle lit la demande
// (op 'view'), puis n'agit qu'au clic sur un bouton (op 'do') — un aperçu de
// messagerie qui « visite » le lien ne déclenche donc aucune action.
// Le jeton est vérifié par l'Edge Function `neotone-purchase-action`.
// FR / EN (`?l=en`) ; les pages de David sont en français.
// =============================================================================
const API = 'https://zqcuhnjjrgmybftppkcl.supabase.co/functions/v1/neotone-purchase-action'
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>Neotone — suivi</title>
  <style is:global>
    :root { --ink:#1f1a17; --soft:#5b524c; --rust:#b4462a; --cream:#faf6f0; --line:#e7d9c6; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--cream); color:var(--ink); font:16px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; }
    main { max-width:560px; margin:0 auto; padding:32px 16px 48px; }
    .brand { font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--rust); font-weight:700; }
    h1 { font-size:24px; line-height:1.25; margin:8px 0 12px; }
    .card { background:#fff; border:1px solid var(--line); border-radius:14px; padding:20px; margin-top:16px; }
    dl { margin:0; display:grid; grid-template-columns:auto 1fr; gap:4px 14px; font-size:14px; }
    dt { color:var(--soft); } dd { margin:0; overflow-wrap:anywhere; }
    label.f { display:block; font-weight:600; font-size:14px; margin-top:12px; }
    input[type=text] { width:100%; margin-top:6px; padding:12px; font-size:16px; border:1px solid #cfc3b3; border-radius:10px; background:#fff; }
    input[readonly] { background:#f3eee7; }
    .opt { display:flex; gap:10px; align-items:flex-start; padding:12px; border:1px solid var(--line); border-radius:10px; margin-top:8px; cursor:pointer; min-height:44px; }
    .opt input { margin-top:4px; width:18px; height:18px; accent-color:var(--rust); }
    button { min-height:44px; padding:12px 22px; border-radius:999px; font-weight:700; font-size:15px; cursor:pointer; border:2px solid var(--rust); margin:14px 8px 0 0; }
    .primary { background:var(--rust); color:#fff; } .secondary { background:#fff; color:var(--rust); }
    button:disabled { opacity:.55; cursor:wait; }
    button:focus-visible, input:focus-visible { outline:3px solid #d08a4a; outline-offset:2px; }
    .note { font-size:13px; color:var(--soft); margin-top:10px; }
    .warn { background:#fff4e5; border:1px solid #f0c48a; border-radius:10px; padding:10px 12px; font-size:14px; margin-top:12px; }
    .ok { font-size:40px; }
  </style>
</head>
<body>
  <main>
    <p class="brand">David Lesage · Neotone</p>
    <div id="app" aria-live="polite"><p id="loading">…</p></div>
  </main>
  <script is:inline define:vars={{ API }}>
  (function () {
    var q = new URLSearchParams(location.search)
    var token = q.get('t') || ''
    var lang = q.get('l') === 'en' ? 'en' : 'fr'
    // Test local seulement : ?api=http://localhost:… (ignoré en production).
    var api = (/^(localhost|127\.0\.0\.1)$/.test(location.hostname) && q.get('api')) || API
    var app = document.getElementById('app')
    var T = {
      fr: {
        loading: 'Chargement…', invalid: 'Ce lien n’est pas valable ou a expiré.', error: 'Une erreur est survenue. Réessaie dans un instant, ou réponds simplement à l’e-mail.',
        superseded: 'Une nouvelle date t’a été proposée depuis : utilise le bouton du dernier e-mail.',
        confirmTitle: 'Une date pour ton Neotone', confirmQ: function (d, p) { return 'Ton Neotone (' + p + ') sera au showroom vers le ' + d + '. Ça te convient ?' },
        confirmBtn: 'Oui, je confirme', confirmOther: 'Une autre date t’arrangerait ? Réponds simplement à l’e-mail.',
        confirmed: function (d) { return 'Merci, c’est noté ! Ton Neotone t’attend vers le ' + d + '. Neotone va t’envoyer la facture et le lien de paiement (szamlazz.hu, en semaine) : pense à vérifier tes spams. Tu paies avant ta venue.' },
        already: 'C’est déjà fait : rien de plus à faire.',
      },
      en: {
        loading: 'Loading…', invalid: 'This link is not valid or has expired.', error: 'Something went wrong. Please try again in a moment, or simply reply to the email.',
        superseded: 'A new date has been proposed since: please use the button in the latest email.',
        confirmTitle: 'A date for your Neotone', confirmQ: function (d, p) { return 'Your Neotone (' + p + ') will be at the showroom around ' + d + '. Does that work for you?' },
        confirmBtn: 'Yes, I confirm', confirmOther: 'Another date would suit you better? Just reply to the email.',
        confirmed: function (d) { return 'Thank you, noted! Your Neotone will be waiting for you around ' + d + '. Neotone will send you the invoice and the payment link (szamlazz.hu, on weekdays): check your spam folder. You pay before coming.' },
        already: 'Already done: nothing more to do.',
      },
    }
    var t = T[lang]
    document.documentElement.lang = lang
    function el(tag, attrs, text) {
      var e = document.createElement(tag)
      for (var k in (attrs || {})) e.setAttribute(k, attrs[k])
      if (text != null) e.textContent = text
      return e
    }
    function show(nodes) { app.replaceChildren.apply(app, nodes) }
    function msg(icon, title, text) { show([el('p', { class: 'ok', 'aria-hidden': 'true' }, icon), el('h1', null, title), el('p', null, text || '')]) }
    function call(body) {
      return fetch(api, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.assign({ t: token }, body)) })
        .then(function (r) { return r.json().catch(function () { return { error: 'bad_json' } }) })
    }
    function recap(rows) {
      var dl = el('dl')
      rows.forEach(function (r) { if (!r[1]) return; dl.append(el('dt', null, r[0]), el('dd', null, r[1])) })
      return dl
    }
    function doAction(btn, extra, onDone) {
      btn.disabled = true
      call(Object.assign({ op: 'do' }, extra)).then(function (r) {
        if (r && r.ok) return onDone(r)
        btn.disabled = false
        var e = (r && r.error) || 'error'
        var known = {
          date_required: 'Écris une date.', serial_required: 'Choisis un n° de série.', serial_not_in_list: 'Ce n° de série n’est pas dans la liste des pièces disponibles.',
          not_allowed: 'Action impossible dans l’état actuel de la demande (' + ((r && r.stateLabel) || '?') + ').', conflict: 'La demande vient de changer : recharge la page.',
          superseded: t.superseded, invalid_link: t.invalid,
        }
        alert(known[e] || t.error)
      }).catch(function () { btn.disabled = false; alert(t.error) })
    }
    if (!token) return msg('⚠️', t.invalid)
    document.getElementById('loading').textContent = t.loading
    call({ op: 'view' }).then(function (v) {
      if (!v || v.error === 'invalid_link' || v.error === 'not_found') return msg('⚠️', t.invalid)
      if (v.error === 'superseded') return msg('↻', t.superseded)
      if (!v.ok) return msg('⚠️', t.error)
      var who = recap([['Client', v.name], ['E-mail', v.email], ['Téléphone', v.phone], ['Société', v.company], ['N° TVA', v.vatNumber], ['Instrument', v.pair], ['Retrait souhaité', v.pickupDate], ['État', v.stateLabel], ['N° de série', v.serial]])

      if (v.action === 'confirm') {
        if (!v.allowed) return msg('✓', t.confirmTitle, v.state === 'client_confirmed' || v.state === 'invoicing' || v.state === 'paid' || v.state === 'delivered' ? t.already : t.error)
        var b = el('button', { class: 'primary', type: 'button' }, t.confirmBtn)
        b.onclick = function () { doAction(b, {}, function (r) { msg('✅', t.confirmTitle, t.confirmed(r.date || v.proposedDate)) }) }
        return show([el('h1', null, t.confirmTitle), el('p', null, t.confirmQ(v.proposedDate, v.pair)), b, el('p', { class: 'note' }, t.confirmOther)])
      }

      if (!v.allowed) return show([el('h1', null, 'Rien à faire ici'), el('p', null, 'Cette action n’est plus possible : la demande est « ' + v.stateLabel + ' ».'), el('div', { class: 'card' }).appendChild(who).parentNode])

      if (v.action === 'reply') {
        var input = el('input', { type: 'text', id: 'd', maxlength: '60', autocomplete: 'off', placeholder: 'ex. 9-13 novembre, vers le 14/11' })
        input.value = v.prefillDate || ''
        if (input.value) input.readOnly = true
        var send = el('button', { class: 'primary', type: 'button' }, 'Envoyer cette date au client')
        var other = el('button', { class: 'secondary', type: 'button' }, 'Proposer une autre date')
        other.onclick = function () { input.readOnly = false; input.select(); input.focus() }
        send.onclick = function () {
          doAction(send, { date: input.value.trim() }, function (r) {
            msg('✅', 'Date envoyée au client', 'Mail parti' + (r.mailSent ? '' : ' (⚠️ SMTP non configuré : rien n’est parti)') + ' : « Ton Neotone sera au showroom vers le ' + r.date + '. Ça te convient ? », avec le bouton « Oui, je confirme ». Tu es en copie et tu seras prévenu de sa réponse.')
          })
        }
        var lab = el('label', { class: 'f', for: 'd' }, v.caseNo === 2 ? 'Date d’arrivée au showroom (colonne L du Sheet, modifiable)' : 'Date à proposer (d’après la réponse de Neotone)')
        var card2 = el('div', { class: 'card' })
        card2.append(lab, input, send, other, el('p', { class: 'note' }, 'Le client reçoit : « Ton Neotone sera au showroom vers le <date>. Ça te convient ? » + un bouton « Oui, je confirme ». Une nouvelle date rend l’ancien bouton caduc.'))
        return show([el('h1', null, 'Répondre au client'), el('div', { class: 'card' }).appendChild(who).parentNode, card2])
      }

      if (v.action === 'invoice') {
        var box = el('div', { class: 'card' })
        box.append(el('p', { style: 'margin:0;font-weight:700' }, 'N° de série attribué à ce client'))
        var list = v.serials || []
        if (list.length) {
          list.forEach(function (s, i) {
            var lab2 = el('label', { class: 'opt' })
            var r = el('input', { type: 'radio', name: 'sn', value: s.serial })
            if (list.length === 1) r.checked = true
            lab2.append(r, el('span', null, '#' + s.serial + ' — ' + (s.status === 'Available' ? 'disponible au showroom' : 'en route' + (s.arrival ? ' (' + s.arrival + ')' : ''))))
            box.append(lab2)
          })
        } else {
          box.append(el('p', { class: 'warn' }, v.serialsError ? 'Liste des n° de série indisponible (' + v.serialsError + '). Vérifie le Sheet et écris le n° à la main.' : 'Aucune pièce de ce modèle et de ce bois n’est « Available » ou « In transit » dans le Sheet. Écris le n° à la main seulement si tu en es sûr.'))
          var man = el('input', { type: 'text', id: 'snm', maxlength: '20', placeholder: 'ex. 977' })
          box.append(el('label', { class: 'f', for: 'snm' }, 'N° de série'), man)
        }
        if (!v.neotoneEnabled) box.append(el('p', { class: 'warn' }, '⛔ Interrupteur NEOTONE_INVOICE_EMAIL_ENABLED à false : tu recevras un APERÇU du mail, rien ne part chez Neotone et rien n’est écrit dans le Sheet.'))
        var go = el('button', { class: 'primary', type: 'button' }, 'Lancer la facturation chez Neotone')
        go.onclick = function () {
          var picked = app.querySelector('input[name=sn]:checked')
          var manual = app.querySelector('#snm')
          var sn = picked ? picked.value : (manual ? manual.value.trim() : '')
          doAction(go, { serial: sn }, function (r) {
            if (r.done === 'preview_only') return msg('👀', 'Aperçu envoyé (à toi seul)', 'Le mail de facturation pour #' + r.serial + ' est dans ta boîte, marqué « APERÇU ». Rien n’est parti chez Neotone, l’état n’a pas changé.')
            msg('✅', 'Facturation lancée : #' + r.serial, 'Mail à Neotone : ' + (r.mailSent ? 'envoyé (toi et le client en copie)' : '⚠️ non envoyé (SMTP)') + '. Sheet : ' + r.sheet + '. Tu reçois un récapitulatif avec les boutons « Marquer payée » et « Marquer remise ».')
          })
        }
        box.append(go, el('p', { class: 'note' }, 'Le mail part à neotone@digitalhandpan.com avec la facturation complète, le modèle, le bois, le n° de série et le prix (−7 % showroom).'))
        return show([el('h1', null, 'Lancer la facturation'), el('div', { class: 'card' }).appendChild(who).parentNode, box])
      }

      var labels = { paid: ['Marquer la demande « payée »', 'Marquer payée', 'Demande marquée payée'], delivered: ['Marquer le Neotone « remis »', 'Marquer remise', 'Neotone marqué remis'], cancel: ['Annuler la demande', 'Oui, annuler', 'Demande annulée'] }
      var L = labels[v.action]
      if (!L) return msg('⚠️', t.error)
      var bt = el('button', { class: v.action === 'cancel' ? 'secondary' : 'primary', type: 'button' }, L[1])
      bt.onclick = function () { doAction(bt, {}, function () { msg('✅', L[2], 'Aucun mail n’est envoyé au client.') }) }
      show([el('h1', null, L[0]), el('div', { class: 'card' }).appendChild(who).parentNode, bt])
    }).catch(function () { msg('⚠️', t.error) })
  })()
  </script>
</body>
</html>
