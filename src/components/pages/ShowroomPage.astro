    {/* ── COMMENT VENIR — sous un filet, dans la même section. */}
    <div id="acces" class="mt-14 scroll-mt-24 border-t border-ink/10 pt-12">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-start">
        <div>
          <SectionHeading align="left" eyebrow={sh.accessEyebrow} title={sh.accessTitle} />
          <p class="mt-4 text-lg font-600">{site.address}</p>
          <div class="mt-4"><Button href={site.mapsUrl} variant="ghost" external>{sh.accessMaps}</Button></div>
        </div>
        <div class="space-y-4">
          {sh.access.map((a) => (
            <div class="flex gap-4 rounded-card border border-ink/10 bg-cream-deep/40 p-4"><span class="text-2xl" aria-hidden="true">{a.icon}</span><div><p class="font-700">{a.t}</p><p class="text-sm text-ink-soft/85">{a.d}</p></div></div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  {/* ═══ 3. L'AGENDA — « je m'inscris. » ══════════════════════════════════
      🎯 C'EST LA SECTION QUI PORTE L'OBJECTIF DE LA PAGE. Remontée le
      20/08/2026 de la 7ᵉ à la 3ᵉ position : elle était derrière le duo
      d'instruments, le bloc « et pas seulement le handpan », les pieds Atlas,
      l'exclusivité commerciale et les quatre formats de session. Quelqu'un qui
      arrivait DÉJÀ DÉCIDÉ devait traverser tout ça pour trouver un bouton.
      ⚠️ LE BLOC PAYANT QUI SUIVAIT CETTE SECTION A ÉTÉ DÉPLACÉ EN BAS DE PAGE
         (#individuel) : proposer un rendez-vous à 50 € juste sous le bouton
         « Réserver ma place » gratuit, c'était mettre les deux en concurrence
         au moment exact de la décision.
      ⓘ L'email de confirmation renvoie ici (`/showroom#agenda`) pour les dates
        gratuites, et `?rdv=prive#agenda` pour le rendez-vous payant — ce
        dernier ouvre la modale TOUT SEUL (BookingForm lit le paramètre), il ne
        dépend donc pas de l'endroit où vit le bloc payant. */}
  <Section id="agenda" tone="cream-deep">
    <div class="mx-auto max-w-3xl rounded-card border-2 border-copper/40 bg-cream p-6 shadow-lg md:p-10">
      <div class="text-center">
        <p class="inline-flex items-center gap-2 rounded-full bg-rust px-4 py-1.5 text-xs font-700 uppercase tracking-widest text-cream">
          <Icon name="lucide:calendar-days" class="h-4 w-4" />
          {sh.agendaEyebrow}
        </p>
        <h2 class="mt-4 font-display text-3xl font-700 md:text-4xl">{sh.agendaTitle}</h2>
        <p class="mx-auto mt-3 max-w-xl text-ink-soft/85">{sh.agendaIntro}</p>
        {agenda.length > 0 && (
          <p data-agenda-count class="mt-4 inline-block rounded-full bg-gold/20 px-4 py-1 text-sm font-700 text-ink">{agendaCount}</p>
        )}
      </div>

      <div data-agenda-list class="mt-8 space-y-4">
        {agenda.map((e) => (
          <div
            data-event-iso={e.iso}
            class="flex flex-col items-center gap-5 rounded-card border border-copper/30 bg-cream-deep/50 p-5 transition-shadow hover:shadow-md sm:flex-row sm:items-center sm:text-left"
          >
            <div class="grid h-20 w-20 shrink-0 place-items-center rounded-2xl bg-ink text-cream">
              <span class="font-display text-3xl font-700 leading-none">{e.day}</span>
              <span class="text-xs font-600 uppercase tracking-widest text-gold">{e.month}</span>
            </div>
            <div class="flex-1 text-center sm:text-left">
              <p class="inline-flex items-center gap-2 rounded-full bg-rust/15 px-3 py-1 text-xs font-700 uppercase tracking-widest text-rust">{sh.agendaEventTag}</p>
              <h3 class="mt-2 font-display text-xl font-700">{sh.agendaEventTitle}</h3>
              <p class="mt-1 text-sm font-600 text-ink-soft first-letter:uppercase">{e.dateLong} · {e.time}</p>
              <p class="mt-1 text-sm text-ink-soft/70">{site.address}</p>
            </div>
            <button
              type="button"
              data-booking="showcase-booking"
              data-event-date={e.iso}
              data-event-start={e.start}
              data-event-end={e.end}
              data-title={bk.showcaseTitle}
              data-intro={bk.showcaseIntro}
              class="block w-full shrink-0 rounded-full bg-rust px-5 py-3 text-center font-700 text-cream transition-colors hover:bg-copper sm:w-auto"
            >{sh.agendaBookCta}</button>
          </div>
        ))}
      </div>

      {/* À SAVOIR AVANT DE VENIR — les trois règles pratiques (16/08/2026).
          Elles ne vivaient que dans l'email de confirmation, donc seules les
          personnes DÉJÀ inscrites les lisaient. Placées ici, juste sous les
          dates : l'horaire ferme se voit AVANT de réserver, pas après. */}
      <div class="mx-auto mt-8 max-w-2xl space-y-3">
        <p class="text-center text-xs font-700 uppercase tracking-widest text-ink-soft/60">{sh.agendaRulesTitle}</p>
        <div class="rounded-card border border-gold/50 bg-gold/10 p-5">
          <p class="font-display text-base font-700">⏱ {sh.agendaRuleTimeTitle}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft/85">{sh.agendaRuleTime}</p>
        </div>
        <div class="rounded-card border border-ink/10 bg-cream-deep/40 p-5">
          <p class="font-display text-base font-700">{sh.agendaRuleDurationTitle}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft/85">{sh.agendaRuleDuration}</p>
        </div>
        <div class="rounded-card border border-ink/10 bg-cream-deep/40 p-5">
          <p class="font-display text-base font-700">🧁 {sh.agendaRuleShareTitle}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft/85">{sh.agendaRuleShare}</p>
        </div>
      </div>

      <div data-agenda-empty class:list={['mt-8 rounded-card border border-dashed border-copper/40 bg-cream-deep/40 p-6 text-center', agenda.length > 0 && 'hidden']}>
        <Icon name="lucide:calendar-clock" class="mx-auto h-8 w-8 text-copper" />
        <h3 class="mt-3 font-display text-xl font-700">{sh.agendaEmpty}</h3>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-soft/85">{sh.agendaEmptyText}</p>
        <div class="mt-5">
          <Button
            href="#agenda"
            variant="primary"
            data-booking="showcase-waitlist"
            data-title={sh.agendaEmptyCta}
            data-intro={sh.agendaEmptyText}
          >{sh.agendaEmptyCta}</Button>
        </div>
      </div>
    </div>
  </Section>

  {/* ═══ 4. LE DÉROULÉ — « qu'est-ce que je vais y faire ? » ═══════════════
      Première question de quelqu'un qui n'a pas réservé tout de suite. Elle
      passe AVANT le catalogue d'instruments : on se demande d'abord comment se
      passe la séance, ensuite ce qu'on pourra toucher.
      🚨 21/08/2026 : ce commentaire disait « l'après-midi » — un showcase peut
         se tenir le matin, l'après-midi ou le soir. Aucun texte de cette page
         ne fixe de moment de la journée ; seul l'agenda porte l'heure.
      📐 Section passée en fond `cream` (elle était en `cream-deep`) pour ne pas
         enchaîner deux fonds sombres avec l'agenda qui la précède désormais ;
         les cartes internes passent donc de `bg-cream` à `bg-cream-deep/40`,
         c'est le couple de contraste utilisé partout ailleurs sur fond crème. */}
  <Section>
    <SectionHeading eyebrow={sh.programEyebrow} title={sh.programTitle} intro={sh.programIntro} />
    {/* Le moment « présentation / démonstration » du déroulé, en image. */}
    <figure class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-card border border-ink/10 bg-cream-deep/40">
      <img
        src={showroomPhotos.presentation.src}
        width={showroomPhotos.presentation.w}
        height={showroomPhotos.presentation.h}
        alt={sh.photoAlt.presentation}
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
      <figcaption class="px-5 py-3 text-center text-sm text-ink-soft/85">{sh.photoCaption.presentation}</figcaption>
    </figure>
    <ol class="mx-auto mt-10 max-w-2xl space-y-4">
      {sh.program.map((s, i) => (
        <li class="flex gap-5 rounded-card border border-ink/10 bg-cream-deep/40 p-5">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-ink font-display text-lg font-700 text-cream">{i + 1}</span>
          <div><h3 class="font-display text-lg font-700">{s.t}</h3><p class="mt-1 text-ink-soft/85">{s.d}</p></div>
        </li>
      ))}
    </ol>
    {/* « Et parfois, ça va plus loin » (18/08/2026) — la démo en situation.
        ⚠️ SELON LE PUBLIC INTÉRESSÉ, jamais promis : voir le commentaire de
        `programBonus` dans dict.ts. Volontairement présenté comme une ouverture
        possible, pas comme une étape du déroulé — d'où le bloc à part, APRÈS la
        liste numérotée, et non une 7ᵉ étape. */}
    <div class="mx-auto mt-6 max-w-2xl rounded-card border border-copper/30 bg-cream-deep/40 p-5">
      <p class="font-display text-base font-700">✨ {sh.programBonusTitle}</p>
      <p class="mt-1.5 text-sm leading-relaxed text-ink-soft/85">{sh.programBonus}</p>
    </div>
    <p class="mx-auto mt-6 max-w-2xl rounded-xl bg-gold/10 px-5 py-4 text-center text-sm font-600 text-ink-soft/90">{sh.programNote}</p>
  </Section>

  {/* ═══ 5. LES INSTRUMENTS — « qu'est-ce que je vais pouvoir toucher ? » ══
      ⚖️ « Le monde du ET », version showroom : ici on ne vend pas un choix,
      on fait ESSAYER. Les deux cartes sont strictement symétriques (même
      gabarit, même nombre de puces, même CTA) — mettre Yishama en avant,
      mais jamais plus que Neotone. La note du bas dit franchement la seule
      asymétrie réelle : seul le Neotone est en stock.
      📐 Section descendue de la 3ᵉ à la 5ᵉ position le 20/08/2026 : c'est la
         plus longue de la page (duo + autres instruments + pieds Atlas ≈ trois
         écrans sur mobile) et elle s'intercalait entre le hero et la moindre
         possibilité de réserver. Son contenu interne n'a PAS bougé. */}
  <Section id="deux-univers">
    <SectionHeading eyebrow={sh.duoEyebrow} title={sh.duoTitle} intro={sh.duoIntro} />
    {/* Les DEUX univers sur la même photo, installés côte à côte : c'est
        exactement ce que les deux cartes ci-dessous décrivent en mots. */}
    <figure class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-card border border-ink/10 bg-cream-deep/40">
      <img
        src={showroomPhotos.instruments.src}
        width={showroomPhotos.instruments.w}
        height={showroomPhotos.instruments.h}
        alt={sh.photoAlt.instruments}
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
      <figcaption class="px-5 py-3 text-center text-sm text-ink-soft/85">{sh.photoCaption.instruments}</figcaption>
    </figure>
    <div class="mt-10 grid items-stretch gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-4">
      {sh.duo.map((d, i) => (
        <Fragment>
          {i === 1 && (
            <div class="flex items-center justify-center md:flex-col" aria-hidden="true">
              <span class="h-px flex-1 bg-ink/15 md:h-full md:w-px md:flex-1"></span>
              <span class="mx-4 grid h-12 w-12 shrink-0 place-items-center rounded-full border border-gold/50 bg-cream font-display text-sm font-700 uppercase tracking-widest text-copper shadow-sm md:mx-0 md:my-4">{lang === 'en' ? 'and' : 'et'}</span>
              <span class="h-px flex-1 bg-ink/15 md:h-full md:w-px md:flex-1"></span>
            </div>
          )}
          <div class:list={['flex flex-col rounded-card border bg-cream-deep/40 p-6 md:p-8', duoMeta[i].ring]}>
            <p class:list={['inline-flex w-fit items-center gap-2 rounded-full px-3 py-1 text-[11px] font-700 uppercase tracking-widest', duoMeta[i].chip]}>
              <Icon name={duoMeta[i].icon} class="h-4 w-4" /> {d.sub}
            </p>
            <h3 class="mt-4 font-display text-2xl font-700">{d.title}</h3>
            <p class="mt-3 text-ink-soft/85">{d.text}</p>
            <ul class="mt-5 flex-1 space-y-2 text-sm text-ink-soft/85">
              {d.points.map((p) => (
                <li class="flex gap-2"><Icon name="lucide:check" class:list={['mt-0.5 h-4 w-4 shrink-0', duoMeta[i].accent]} /> {p}</li>
              ))}
            </ul>
            <a href={L(duoMeta[i].href)} class:list={['mt-6 inline-flex items-center gap-1 font-700 transition-all hover:gap-2', duoMeta[i].accent]}>{d.cta} →</a>
          </div>
        </Fragment>
      ))}
    </div>
    <p class="mx-auto mt-8 max-w-3xl rounded-xl bg-gold/10 px-5 py-4 text-center text-sm text-ink-soft/85">{sh.duoNote}</p>

    {/* ── ET PAS SEULEMENT LE HANDPAN — Gonilélé, calebasse, micros.
        Volontairement dans la MÊME section que le duo handpan, et sous un
        filet de séparation : ça se lit comme « … et il y a aussi ça »,
        jamais comme un quatrième univers concurrent du Neotone.
        Cartes plus sobres que celles du duo (une seule colonne de texte,
        pas de puces) : l'attractivité du Neotone n'est pas diluée. */}
    <div class="mt-14 border-t border-ink/10 pt-12">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-700 uppercase tracking-[0.2em] text-copper">{sh.alsoEyebrow}</p>
        <h2 class="mt-3 font-display text-2xl font-700 md:text-3xl">{sh.alsoTitle}</h2>
        <p class="mt-3 text-ink-soft/85">{sh.alsoIntro}</p>
      </div>
      {/* 🎠 LE CARROUSEL DES AUTRES INSTRUMENTS (20/08/2026, demande de David).
          AVANT : une figure isolée du Gonilélé (max-w-xs), et RIEN pour la
          calebasse ni pour les deux micros — trois cartes de texte annonçaient
          des objets que personne ne pouvait se représenter.
          MAINTENANT : un carrousel (le même composant que « En images » et que
          /pieds-atlas), qui OUVRE sur cette même photo du Gonilélé au showroom.
          ➡️ Rien n'est perdu et le Gonilélé n'est pas montré deux fois.
          📐 `max-w-lg` : le carrousel est carré (aspect-ratio 1/1, global.css).
             Sans bride, il ferait 1152 px de haut au bureau et repousserait les
             trois cartes hors de l'écran.
          🖐️ Défilement au doigt + plein écran au clic : c'est <Lightbox />,
             inclus UNE SEULE FOIS en bas de page — ne pas en rajouter ici. */}
      <div class="mx-auto mt-8 max-w-lg">
        {/* 🚫 PAS DE PHRASE « fais glisser du doigt » ICI : le carrousel
            « En images », plus bas sur la MÊME page, porte déjà exactement
            cette consigne (`galleryIntro`). La répéter, ce serait le doublon
            que David reproche. Les flèches, les points et la démo automatique
            du composant suffisent. */}
        <Carousel id="showroom-also" slides={alsoSlides} alt={sh.alsoTitle} labels={carouselLabels} />
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {sh.also.map((a, i) => (
          <div class="flex flex-col rounded-card border border-ink/10 bg-cream-deep/40 p-6">
            <Icon name={alsoMeta[i].icon} class="h-7 w-7 text-copper" />
            <h3 class="mt-3 font-display text-lg font-700">{a.title}</h3>
            <p class="mt-2 flex-1 text-sm text-ink-soft/85">{a.text}</p>
            <a href={L(alsoMeta[i].href)} class="mt-5 inline-flex items-center gap-1 text-sm font-700 text-copper transition-all hover:gap-2">{a.cta} →</a>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-ink-soft/70">{sh.alsoNote}</p>

      {/* ── 🦵 LES PIEDS ATLAS (20/08/2026) ─────────────────────────────────
          Partenariat d'affiliation validé : Atlas envoie deux pieds de
          démonstration, ils seront donc réellement sur place — d'où leur
          place dans « et pas seulement le handpan ».
          ⚠️ VOLONTAIREMENT SOUS `alsoNote` : la note promet « coche-le au
          moment de réserver », ce qui n'est vrai que pour les 3 instruments
          au-dessus. Les pieds ne sont PAS une case du formulaire (aucune
          colonne ne les attend en base — règle des trois écritures). Pour les
          y ajouter un jour : formulaire → api/subscribe.js → site-lead + colonne.
          Encadré plutôt que 4ᵉ carte : ce n'est pas un instrument, et le
          Neotone ne doit pas perdre de place au profit d'un accessoire. */}
      <div class="mt-12 rounded-card border border-copper/30 bg-cream p-6 md:p-8">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-700 uppercase tracking-[0.2em] text-copper">{sh.atlasEyebrow}</p>
          <h3 class="mt-3 font-display text-xl font-700 md:text-2xl">{sh.atlasTitle}</h3>
          <p class="mt-3 text-sm text-ink-soft/85">{sh.atlasIntro}</p>
        </div>
        {/* 🎠 LES MÊMES CARROUSELS QUE /pieds-atlas (20/08/2026, David : « les
            photos des pieds sont trop petites […] il faudrait utiliser les
            mêmes carrousels que la page qui leur est dédiée »).
            AVANT : une vignette fixe par modèle, haute de 224 px — on voyait un
            pied, jamais le produit (repli, sac, tête, réglage de hauteur).
            MAINTENANT : le composant <Carousel>, avec les mêmes diapositives et
            le même ordre que la fiche dédiée (jeux construits en haut de ce
            fichier). Défilement au doigt, flèches, points, et plein écran au
            clic via <Lightbox /> — inclus une seule fois en bas de page.
            📐 Plus de `bg-white` autour : les photos produit sont détourées sur
               blanc et remplissent maintenant tout le cadre carré du carrousel,
               il n'y a plus de rectangle blanc à masquer. */}
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {sh.atlasModels.map((m, i) => (
            <div class="overflow-hidden rounded-xl border border-ink/10 bg-cream-deep/40 p-4">
              <Carousel id={atlasCarousels[i].id} slides={atlasCarousels[i].slides} alt={m.name} labels={carouselLabels} />
              <div class="mt-4">
                <p class="font-display text-lg font-700">{m.name}</p>
                <p class="mt-1 text-sm text-ink-soft/85">{m.text}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-6 text-center">
          <a href={L('/pieds-atlas')} class="inline-flex items-center gap-1 text-sm font-700 text-copper transition-all hover:gap-2">{sh.atlasCta} →</a>
        </p>
      </div>
    </div>
  </Section>

  {/* ═══ 6. EN IMAGES — « je vais me sentir comment ? » ════════════════════
      📷 Le reste des photos, celles qui ne portent pas un argument à elles
      seules mais qui donnent la matière du lieu. Dernière levée de doute avant
      le rappel de la date qui suit immédiatement : montrer l'ambiance rassure
      plus que n'importe quel paragraphe.
      👉 POUR EN AJOUTER UNE : tout est expliqué en haut de `src/data/showroom.ts`.
      Composant réutilisé tel quel (Carousel + Lightbox), comme sur les pages
      Neotone, Muling, Gonilélé et Boutique : swipe au doigt, flèches, points,
      et plein écran au clic. `<Lightbox />` est inclus une seule fois, plus bas. */}
  <Section id="en-images" tone="cream-deep">
    <SectionHeading eyebrow={sh.galleryEyebrow} title={sh.galleryTitle} intro={sh.galleryIntro} />
    <div class="mx-auto mt-10 max-w-2xl">
      <Carousel id="showroom-gallery" slides={gallerySlides} alt={sh.heroTitle} labels={carouselLabels} />
    </div>
  </Section>

  {/* ═══ 7. RAPPEL DE LA DATE — « bon, j'y vais. » ═════════════════════════
      AJOUTÉ le 20/08/2026. On ne se décide pas tous au même endroit : certains
      réservent sur la date du hero, d'autres après avoir vu les photos. La date
      revient donc ici, à mi-parcours, JUSTE APRÈS la galerie.
      🖱️ Le bouton OUVRE DIRECTEMENT la modale sur la prochaine date
         (`nextBookAttrs`, mêmes attributs que les cartes de l'agenda) : pas de
         remontée de page, pas de clic perdu.
      🚫 AUCUN TEXTE NOUVEAU N'A ÉTÉ INVENTÉ pour ce bloc : il n'utilise que des
         clés déjà écrites et validées (`agendaNextLabel`, `agendaSeats`,
         `agendaBookCta`).
      🧹 Il disparaît tout seul si la date est passée ou s'il n'y en a plus
         (attribut `data-next-reminder`, filet <script> en bas de page). */}
  {next && (
    <section data-next-reminder data-event-iso={next.iso} class="bg-ink text-cream">
      <div class="mx-auto max-w-3xl px-4 py-14 lg:px-8 lg:py-16">
        <div class="flex flex-col items-center gap-5 rounded-card border-2 border-gold/60 bg-cream/10 p-5 text-center sm:flex-row sm:p-6 sm:text-left">
          <div class="grid h-20 w-20 shrink-0 place-items-center rounded-2xl bg-gold text-ink">
            <span class="font-display text-3xl font-700 leading-none">{next.day}</span>
            <span class="text-[10px] font-700 uppercase tracking-widest">{next.month}</span>
          </div>
          <div class="flex-1">
            <p class="text-xs font-700 uppercase tracking-widest text-gold">{sh.agendaNextLabel}</p>
            <p class="mt-1 font-display text-xl font-700 leading-snug text-cream first-letter:uppercase">{next.dateLong}</p>
            <p class="text-sm text-cream/80">{next.time}</p>
            <p class="mt-1.5 text-sm font-700 text-gold">{sh.agendaSeats}</p>
          </div>
          <button
            type="button"
            {...nextBookAttrs}
            class="block w-full shrink-0 rounded-full bg-cream px-5 py-3 text-center font-700 text-ink shadow-md transition-colors hover:bg-cream-deep sm:w-auto"
          >{sh.agendaBookCta}</button>
        </div>
      </div>
    </section>
  )}

  {/* ═══ 8. L'EXCLUSIVITÉ — « et si je veux repartir avec ? » ══════════════
      📉 DESCENDUE de la 4ᵉ à la 8ᵉ position le 20/08/2026. C'est un argument
      d'ACHAT (remise 7 %, stock limité, repartir le jour même), pas un argument
      de VENUE. Placé avant l'agenda, il transformait l'annonce d'un événement
      gratuit en tunnel de vente — c'est le pire frein possible sur une page dont
      le seul objectif est une inscription gratuite.
      Ici, après la décision, il se lit pour ce qu'il est : un bonus pour qui est
      déjà convaincu de venir. */}
  <Section tone="cream-deep">
    <div class="rounded-card border border-copper/30 bg-cream p-8 md:p-12">
      <p class="inline-flex items-center gap-2 rounded-full bg-rust/15 px-4 py-1.5 text-xs font-700 uppercase tracking-widest text-rust">{sh.exclBadge}</p>
      <h2 class="mt-5 font-display text-3xl font-700 md:text-4xl">{sh.exclTitle}</h2>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft/90">{sh.exclText}</p>
      <ul class="mt-6 grid gap-3 md:grid-cols-3">
        {sh.exclArgs.map((a) => <li class="flex gap-3 rounded-xl bg-cream-deep/60 p-4 text-sm font-600"><Icon name="lucide:check" class="mt-0.5 h-5 w-5 shrink-0 text-copper" /> {a}</li>)}
      </ul>
    </div>
  </Section>

  {/* ═══ 9. « ET SI JE NE PEUX PAS VENIR ? » — le rendez-vous individuel ═══
      🔗 FUSION DE DEUX BLOCS (20/08/2026) qui vivaient à trois sections d'écart
      et répondaient à la MÊME question :
        · « Ce qu'on y vit » (4 formats, 3 payants) + un bouton PLEIN
          « Réserver un rendez-vous individuel » — c'était le bouton le plus
          voyant de toute la page, et il était PAYANT, placé AVANT l'agenda ;
        · le bloc « Tu ne peux pas venir… » qui suivait l'agenda, avec le même
          bouton, le même tarif et la même modale.
      Ils sont désormais un seul bloc, en toute fin de page. Le créneau payant
      reste parfaitement accessible (David le vend) mais il ne croise plus
      jamais l'inscription gratuite.
      🚨 PAS D'ADRESSE EMAIL EN CLAIR ICI (18/08/2026) : « je ne veux plus que
         les gens voient mon email, je veux qu'ils remplissent le formulaire
         pour que tout soit tracé ». Ne pas réintroduire de `mailto:`.
      🔗 `id="individuel"` est la cible du lien discret du hero. */}
  <Section id="individuel">
    <SectionHeading eyebrow={sh.eventsEyebrow} title={sh.eventsTitle} />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {sh.events.map((e, i) => (
        <div class:list={['flex flex-col rounded-card p-6', i === eventHighlight ? 'border-2 border-copper/50 bg-cream shadow-md' : 'border border-ink/10 bg-cream-deep/40']}>
          {i === eventHighlight && (
            <p class="mb-3 inline-flex w-fit items-center rounded-full bg-gold/25 px-3 py-1 text-[11px] font-700 uppercase tracking-widest text-ink">{sh.eventsHighlight}</p>
          )}
          <Icon name={eventIcons[i]} class="h-7 w-7 text-copper" />
          <h3 class="mt-3 font-display text-xl font-700">{e.t}</h3>
          <p class="mt-2 flex-1 text-ink-soft/85">{e.d}</p>
          <p class="mt-4 font-700 text-rust">{eventPrices[i]}</p>
        </div>
      ))}
    </div>

    {/* Le rendez-vous individuel, en clair : ce pour quoi on peut venir (tout
        instrument de la boutique, un micro, ou simplement un accompagnement),
        le tarif, et le cadre d'annulation. C'est ici qu'atterrit le bouton
        « Réserver un RDV VIP » de l'email de confirmation — via `?rdv=prive`,
        qui ouvre la modale tout seul (BookingForm lit le paramètre). */}
    <div class="mx-auto mt-12 max-w-3xl rounded-card border border-copper/30 bg-cream-deep/40 p-6 text-center md:p-8">
      <h3 class="font-display text-xl font-700">{sh.agendaMoreTitle}</h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-ink-soft/85">{sh.agendaMoreText}</p>
      <p class="mx-auto mt-4 max-w-2xl text-sm text-ink-soft/85">{bk.vipScope}</p>
      <div class="mx-auto mt-5 flex max-w-md flex-col items-center gap-1 rounded-xl bg-gold/15 px-5 py-4">
        <span class="text-[11px] font-700 uppercase tracking-widest text-ink-soft/70">{bk.vipPriceLabel}</span>
        <span class="font-display text-xl font-700 text-rust">{grid}</span>
        <span class="text-xs text-ink-soft/70">{bk.vipPriceNote}</span>
      </div>
      <p class="mx-auto mt-4 max-w-xl text-xs leading-relaxed text-ink-soft/70">{bk.vipPolicyShort}</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <Button href="#individuel" variant="primary" {...privateAttrs}>{sh.bookPrivateCta}</Button>
        <Button href={L('/') + '#communaute'} variant="ghost">{sh.agendaCta}</Button>
      </div>
      <p class="mx-auto mt-5 max-w-xl text-sm text-ink-soft/70">{sh.booking}</p>
    </div>

    {/* 🚨 LA DERNIÈRE PHRASE DE LA PAGE REDIT LA GRATUITÉ. C'est volontaire :
        on vient d'afficher un tarif, et le seul objectif de la page reste
        l'inscription GRATUITE. `ctaBookNote` (mots de David) porte exactement
        les deux informations — « Les showcases publics, eux, sont gratuits —
        nombre de places limitées · réservation nécessaire » — et le lien
        ramène aux dates. Ne pas retirer ce filet. */}
    <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-ink-soft/75">
      {sh.ctaBookNote.replace('{grid}', grid)}
      {' '}
      <a href="#agenda" class="font-700 text-copper underline underline-offset-4 hover:text-rust">{sh.agendaBookCta} →</a>
    </p>
  </Section>

  <BookingForm lang={lang} />
  {/* Une seule fois par page : porte la lightbox ET la logique des carrousels. */}
  <Lightbox />
</Layout>

<script>
  // Filet de sécurité : la page est statique, donc une date déjà passée pourrait
  // rester affichée si le site n'a pas été rebuildé. On la retire à l'affichage,
  // et on bascule sur l'état « prochaines dates en préparation » s'il ne reste rien.
  const today = new Date().toISOString().slice(0, 10)
  const list = document.querySelector('[data-agenda-list]')
  const empty = document.querySelector('[data-agenda-empty]')
  const count = document.querySelector('[data-agenda-count]')
  const banner = document.querySelector('[data-next-banner]')
  // Rappel de milieu de page (20/08/2026) : il affiche LA MÊME date que la
  // bannière du hero, il doit donc disparaître dans exactement les mêmes cas —
  // sinon la page annoncerait encore une date morte à mi-parcours.
  const reminder = document.querySelector('[data-next-reminder]')
  // Repli du hero : si la date mise en avant disparaît, le hero ne doit pas se
  // retrouver avec le seul lien PAYANT en tête (cf. commentaire du hero).
  const fallback = document.querySelector('[data-next-fallback]')

  list?.querySelectorAll<HTMLElement>('[data-event-iso]').forEach((card) => {
    if ((card.dataset.eventIso || '') < today) card.remove()
  })
  if (banner instanceof HTMLElement && (banner.dataset.eventIso || '') < today) {
    banner.remove()
    fallback?.classList.remove('hidden')
  }
  if (reminder instanceof HTMLElement && (reminder.dataset.eventIso || '') < today) reminder.remove()

  const remaining = list?.querySelectorAll('[data-event-iso]').length ?? 0
  if (remaining === 0) {
    empty?.classList.remove('hidden')
    count?.remove()
    banner?.remove()
    reminder?.remove()
    fallback?.classList.remove('hidden')
  }
</script>
