        <figcaption class="px-5 py-3 text-center text-sm text-ink-soft/85">{sh.photoCaption.vueEnsemble}</figcaption>
      </figure>
      <figure class="overflow-hidden rounded-card border border-ink/10 bg-cream-deep/40">
        <img
          src={showroomPhotos.grandePiece.src}
          width={showroomPhotos.grandePiece.w}
          height={showroomPhotos.grandePiece.h}
