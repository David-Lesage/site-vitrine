---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Button from '@/components/Button.astro'
import { Icon } from 'astro-icon/components'
import { site } from '@/data/site'
import { getDict } from '@/i18n/dict'
import { localizePath } from '@/i18n/utils'
import { localBusinessLdJson, breadcrumbLdJson } from '@/lib/ldJson'
import { upcomingShowcases } from '@/lib/agenda'
import { priceForKind, priceGrid } from '@/lib/sessions'
import BookingForm from '@/components/BookingForm.astro'
import Carousel from '@/components/Carousel.astro'
import Lightbox from '@/components/Lightbox.astro'
import { showroomGallery, showroomAlsoGallery, showroomHeroGallery, showroomPhotos, FRANCE_EXCLUSIVITY_ACTIVE } from '@/data/showroom'
import { atlasProPhotos, atlasAllPhotos, atlasProHeightSquare } from '@/data/atlas'
import type { Lang } from '@/i18n/config'

// ════════════════════════════════════════════════════════════════════════════
// 🎯 CETTE PAGE A UN SEUL OBJECTIF : L'INSCRIPTION À UNE DATE DE SHOWCASE
//    (gratuite). Tout le reste lui est subordonné. Mots de David, 20/08/2026 :
//    « La finalité c'est qu'elle s'inscrive à une date, c'est le seul objectif. »
//
// 📐 ORDRE DES SECTIONS — refondu le 20/08/2026. Chaque section répond à UNE
//    question du visiteur, dans l'ordre où elle se pose :
//
//    0. CARROUSEL D'OUVERTURE ..... « à quoi ça ressemble, là-bas ? »  (21/08)
//    1. HERO ...................... « c'est quoi, c'est quand, c'est gratuit ? »
//    2. #le-lieu (+ l'accès) ...... « je débarque où, et j'y arrive comment ? »
//    3. #agenda ................... « je m'inscris. »            ← LE BUT
//    4. le déroulé ................ « comment ça se PASSE ? »
//    5. #deux-univers ............. « qu'est-ce qu'il Y A, sur place ? »
//       └─ 4ᵉ chapitre : « En images » (ancre `#en-images` conservée)
//    6. rappel de la date ......... « bon, j'y vais. »            ← LE BUT (2)
//    7. exclusivité ............... « et si je veux repartir avec ? »
//    8. #individuel ............... « et si je ne peux pas venir ? »
//
// ════════════════════════════════════════════════════════════════════════════
// 🖼️ 21/08/2026 (soir) — « EN IMAGES » N'EST PLUS UNE SECTION, C'EST UN
//    CHAPITRE. Mot de David : « ce que je trouve un peu bordélique, c'est le
//    côté plusieurs endroits. "Le showroom, en photos" fait un peu doublon
//    avec le carrousel du début, non ? »
//
//    ⚖️ VÉRIFIÉ AVANT DE CODER — LA CAUSE N'ÉTAIT PAS CELLE QU'ON CROIT.
//       Les deux carrousels n'ont AUCUNE photo en commun :
//         · ouverture (4) = LE LIEU ET LES GENS (accueil, vue d'ensemble,
//           présentation, grande pièce) ;
//         · « En images » (7) = LES INSTRUMENTS ET LE MATÉRIEL (micros Hisong,
//           Yishama micré, sono Bose, tablette, coin salon, démo).
//       Le doublon était dans le TITRE — « Le showroom, en photos » annonçait
//       ce que le haut de page montre déjà — pas dans le contenu.
//
//    ✅ CE QUI A ÉTÉ FAIT : la galerie descend d'un cran dans la hiérarchie et
//       rejoint la section qu'elle illustre (5, les instruments), en 4ᵉ
//       chapitre, avec le MÊME gabarit que les trois autres (eyebrow copper ·
//       h3 · intro · filet au-dessus). Son titre dit maintenant ce qu'on y
//       voit. Une section = un sujet : la page passe de 10 blocs à 9, et plus
//       aucun bloc n'annonce « des photos du showroom ».
//       🔗 L'ANCRE `#en-images` EST CONSERVÉE, posée sur le chapitre : rien
//          dans ce dépôt n'y pointait, mais un lien partagé hors dépôt
//          continue de tomber sur les photos. `#agenda` et `#acces` (cibles
//          du site de l'association) sont intacts.
//       📏 L'agenda ne bouge PAS d'un pixel : il est AVANT cette section.
//
// ════════════════════════════════════════════════════════════════════════════
// 🧲 21/08/2026 — LE RASSEMBLEMENT. Mots de David : « il y en a un peu partout
//    dans tous les sens […] il y a besoin de rassembler les choses entre elles. »
//    L'ORDRE des sections n'a PAS bougé : c'est la HIÉRARCHIE qui a changé.
//
//    ① UNE SEULE SECTION D'INSTRUMENTS (5), TROIS CHAPITRES — QUATRE DEPUIS
//       LE SOIR DU 21/08/2026 (la galerie « En images » les a rejoints).
//       Avant, quatre blocs « eyebrow + titre + intro » de MÊME poids visuel
//       s'enchaînaient sur le même sujet : le déroulé, « Handpan acoustique et
//       électronique », « Le reste de ce que je joue est là aussi », et les
//       pieds Atlas. Quatre repères concurrents = plus de repère du tout.
//       Maintenant : la section 5 porte UN titre (`onsiteTitle`) et ses trois
//       chapitres sont en <h3>, avec le MÊME gabarit tous les trois.
//
//    ② LE DÉROULÉ RESTE SÉPARÉ DU CATALOGUE (4 ≠ 5).
//       « Au programme d'une session » raconte ce qui SE PASSE (dans quel
//       ordre, combien de temps, ce qu'on fait). La section 5 dit ce qu'il Y A.
//       C'est la distinction que la page avait perdue : les deux se
//       ressemblaient parce que les deux énuméraient les mêmes instruments.
//       🚫 Le texte des 6 étapes est INTOUCHABLE : ce sont les mots de David et
//          il doit rester identique à l'email de confirmation
//          (supabase/functions/_shared/showcase-email.ts). On sépare les blocs,
//          on ne réécrit pas les étapes.
//
//    ③ LES PHOTOS SONT REGROUPÉES, PLUS DE DOUBLON.
//       Trois des quatre photos du carrousel d'ouverture étaient RE-AFFICHÉES
//       en figures isolées plus bas (`vueEnsemble`, `presentation`,
//       `grandePiece`). Il ne reste qu'UNE figure avant l'agenda (`vueEnsemble`,
//       la seule preuve « il y a du monde ») et UNE dans la section 5
//       (`instruments`, la seule photo qui n'est dans aucun carrousel).
//       Surfaces photo restantes, chacune avec un rôle distinct :
//         carrousel d'ouverture = LE LIEU · figure `vueEnsemble` = LA PREUVE ·
//         figure `instruments` = CE QUI EST INSTALLÉ · carrousel `also` = LES
//         AUTRES INSTRUMENTS · 2 carrousels Atlas = LE PRODUIT PARTENAIRE ·
//         carrousel « En images » = LA MATIÈRE DU LIEU.
//
//    ④ L'AGENDA : LA DATE EST DEVENUE LE TITRE DE CHAQUE LIGNE.
//       Les cinq lignes portaient le même <h3>, le même tag et la même adresse.
//       Détail et mode d'emploi : `agendaEventTitle` (dict.ts) et `agendaEvents`
//       (src/data/site.ts, champ `note` facultatif).
//
//    ⑤ LA SECTION DU BAS DIT ENFIN CE QU'ELLE EST.
//       « Ce qu'on y vit · Tester, rencontrer, repartir avec » + 4 cartes dont
//       une gratuite → `individualEyebrow` + `agendaMoreTitle` + 3 cartes
//       payantes. Un seul titre au lieu de deux, une énumération d'instruments
//       en moins, et plus de pastille « Gratuit » perdue dans des tarifs.
// ════════════════════════════════════════════════════════════════════════════
//
// 🚨 CE QUI A CHANGÉ, ET POURQUOI (ne pas défaire sans relire ceci) :
//    · L'AGENDA EST REMONTÉ de la 7ᵉ à la 3ᵉ position. Il était derrière CINQ
//      sections d'argumentaire : quelqu'un qui arrivait déjà décidé (lien
//      d'email, Facebook, bouche-à-oreille) devait traverser toute la page
//      avant de trouver un bouton. Sur mobile, c'était quatre écrans.
//    · L'ACCÈS EST REMONTÉ du bas de page juste sous « le lieu ». « C'est où
//      dans Paris ? » est un frein dur, il se levait après la décision.
//    · LE CRÉNEAU PAYANT NE PARAÎT PLUS QU'UNE FOIS, tout en bas (#individuel).
//      Avant, il apparaissait TROIS fois — dont un bouton PLEIN (le plus
//      voyant de la page) et un prix de 50 € dans le hero, avant même que la
//      gratuité du showcase soit établie. David a tranché : « ça va trop
//      freiner les gens dès le démarrage et ça porte à confusion ».
//    · « CE QU'ON Y VIT » (4 formats) ET LE BLOC RDV INDIVIDUEL SONT FUSIONNÉS :
//      ils répondaient tous les deux à « et si je ne peux pas venir / je veux
//      plus », à trois sections d'écart, avec le même bouton.
//    · L'EXCLUSIVITÉ (« repars avec ton Neotone ») EST DESCENDUE après la
//      décision : c'est un argument d'ACHAT, pas de VENUE. Placé en 4ᵉ position
//      il transformait un événement gratuit en tunnel de vente.
//    · UN RAPPEL DE LA DATE EST AJOUTÉ au milieu de la page (7). On ne se
//      décide pas tous au même endroit ; la date doit revenir.
// ════════════════════════════════════════════════════════════════════════════

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const sh = t.showroom
const bk = t.booking
const L = (p: string) => localizePath(p, lang)
// 🎫 Icônes des TROIS formats payants (section 9). L'icône `lucide:presentation`
// a disparu avec la carte du showcase gratuit — voir `paidEvents` plus bas.
const eventIcons = ['lucide:compass', 'lucide:hand', 'lucide:graduation-cap']
// 🦵 PIEDS ATLAS — LES MÊMES CARROUSELS QUE /pieds-atlas (20/08/2026).
// David : « les photos des pieds sont trop petites sur la page showroom, ils ne
// sont pas bien mis en valeur, il faudrait utiliser les mêmes carrousels que la
// page qui leur est dédiée. »
// AVANT : deux vignettes fixes (une photo par modèle), hautes de 224 px.
// MAINTENANT : deux <Carousel>, avec EXACTEMENT les mêmes diapositives, dans le
// même ordre, que les carrousels de la fiche dédiée (AtlasPage.astro) — Pro =
// photo de couverture, puis la vue carrée « deux hauteurs », puis le reste ;
// All = ses sept photos. Si tu changes l'un, change l'autre : c'est le même
// produit, il ne doit pas se raconter en deux jeux d'images différents.
// ⚠️ Les `id` de carrousel sont préfixés `showroom-` : ils doivent rester
//    uniques dans la page (le script du carrousel les indexe par `data-carousel`).
// Les textes alternatifs restent ceux de la fiche dédiée (`atlas.alt`), jamais
// réécrits ici, pour qu'ils ne divergent pas entre les deux pages.
const atlasAlt = t.atlas.alt as Record<string, string>
const atlasSlides = (photos: { id: string; src: string; w: number; h: number }[]) =>
  photos.map((p) => ({ src: p.src, alt: atlasAlt[p.id], w: p.w, h: p.h }))
const atlasCarousels = [
  {
    id: 'showroom-atlas-pro',
    slides: [
      atlasSlides(atlasProPhotos)[0],
      { src: atlasProHeightSquare.src, alt: atlasAlt[atlasProHeightSquare.id], w: atlasProHeightSquare.w, h: atlasProHeightSquare.h },
      ...atlasSlides(atlasProPhotos).slice(1),
    ],
  },
  { id: 'showroom-atlas-all', slides: atlasSlides(atlasAllPhotos) },
]
// Les deux univers essayables sur place — mêmes accents que sur l'accueil,
// mêmes destinations. L'ordre suit le titre (acoustique puis électronique)
// et n'exprime aucune préférence.
const duoMeta = [
  { icon: 'lucide:circle-dot', href: '/yishama', accent: 'text-copper', ring: 'border-copper/30', chip: 'bg-copper/10 text-copper' },
  { icon: 'lucide:audio-waveform', href: '/le-neotone', accent: 'text-rust', ring: 'border-rust/30', chip: 'bg-rust/10 text-rust' },
]
// 🚨 « ET PAS SEULEMENT LE HANDPAN » (18/08/2026, demande de David).
// Un joueur de N'Goni a réservé un showcase : il venait pour le GONILÉLÉ, et
// la page n'en parlait nulle part — il pouvait croire s'être trompé
// d'événement. Ce bloc s'ajoute APRÈS le duo handpan, sans lui prendre sa
// place : le Neotone reste le fer de lance, on élargit seulement.
// Destinations : la harpe a sa fiche dédiée ; la calebasse et les micros
// vivent dans la boutique (ancres `#creations` et `#micros` = `Section id`
// de ShopPage, alimentées par les catégories de src/data/shop.ts).
const alsoMeta = [
  { icon: 'lucide:music-2', href: '/gonilele' },
  { icon: 'lucide:drum', href: '/boutique#creations' },
  { icon: 'lucide:mic', href: '/boutique#micros' },
]
// 🎫 LES TROIS FORMATS PAYANTS — et eux seuls (21/08/2026).
// `sh.events[0]` est la carte du SHOWCASE PUBLIC GRATUIT : elle n'est plus
// rendue. Elle décrivait, tout en bas de page et au milieu de trois cartes
// payantes, l'événement dont la page entière parle depuis son premier écran —
// avec, au passage, la 6ᵉ énumération des instruments de la page. Et sa
// pastille « Gratuit » était le seul libellé non tarifaire d'une rangée de
// prix : exactement la confusion gratuit/payant que David fait retirer depuis
// le 16/08. La clé reste dans les deux dictionnaires (rien n'est supprimé) ;
// le mode d'emploi pour la remettre est écrit au-dessus de `events` (dict.ts).
const paidEvents = sh.events.slice(1)
// Les 3 cartes payantes affichent le tarif de site.ts (sessionTypes), comme le
// formulaire de réservation — impossible qu'elles annoncent deux prix différents.
const eventPrices = [priceForKind('onboarding'), priceForKind('demo'), priceForKind('lesson')]
// La grille du rendez-vous individuel (« 1h · 50 € — 1h30 · 70 € »), annoncée
// UNIQUEMENT dans le bloc #individuel (bas de page) et dans la modale.
// 🚨 Elle n'apparaît plus dans le hero : c'était le PREMIER prix lisible de la
//    page, sur une page dont l'objet est un événement GRATUIT.
const grid = priceGrid()
// La prise en main est mise en avant : c'est le moment où quelqu'un qui vient
// d'acheter décroche ou s'attache. Elle est passée de l'indice 1 à l'indice 0
// le 21/08/2026 avec le retrait de la carte du showcase gratuit — c'est
// TOUJOURS la même carte (« Prise en main de ton instrument »).
const eventHighlight = 0

// Seules les dates À VENIR sont affichées : une date passée dans le calendrier
// donnait l'impression d'un agenda mort. Le tri se fait au build (voir
// `upcomingShowcases`), et un filet côté client (<script> plus bas) protège
// d'une page mise en cache.
const agenda = upcomingShowcases(lang).map((e) => ({
  ...e,
  dateLong: e.long,
  time: sh.agendaEventTime.replace('{start}', e.start).replace('{end}', e.end),
}))
const next = agenda[0]
const agendaCount = (agenda.length > 1 ? sh.agendaCountPlural : sh.agendaCount).replace('{n}', String(agenda.length))
// Attributs du bouton qui ouvre DIRECTEMENT la modale sur la prochaine date.
// Utilisés par le rappel de milieu de page : au lieu de renvoyer le visiteur
// remonter jusqu'à l'agenda, on lui ouvre le formulaire sur place.
const nextBookAttrs = next
  ? {
      'data-booking': 'showcase-booking',
      'data-event-date': next.iso,
      'data-event-start': next.start,
      'data-event-end': next.end,
      'data-title': bk.showcaseTitle,
      'data-intro': bk.showcaseIntro,
    }
  : {}

// Attributs du déclencheur de la modale de réservation PAYANTE.
// 🚨 UN SEUL PARCOURS PAYANT (18/08/2026, demande de David : « on voit qu'il y a
// 2 boutons […] ça fait doublon et j'ai l'impression que ça mène au même
// formulaire »), et depuis le 20/08/2026 UN SEUL ENDROIT SUR LA PAGE : le bloc
// #individuel, tout en bas. `private-session` est le parcours COMPLET
// (motif → format → instruments → durée).
// La source `showroom-visit` reste connue de l'Edge Function (lignes déjà en
// base, pages encore en cache) : rien à retirer côté serveur.
// ⓘ Les clés `booking.visitTitle` / `booking.visitIntro` ne sont PLUS utilisées
//   sur cette page depuis que le hero ne déclenche plus la modale payante
//   (c'est un simple lien vers #individuel). Elles restent dans les deux
//   dictionnaires — aucune clé supprimée.
const privateAttrs = { 'data-booking': 'private-session', 'data-title': bk.privateTitle, 'data-intro': bk.privateIntro }

const ld = [localBusinessLdJson(), breadcrumbLdJson([{ name: t.common.nav.home, url: L('/') }, { name: sh.heroTitle, url: L('/showroom') }])]

// 📷 CARROUSEL « En images » — la liste des photos vit dans `src/data/showroom.ts`
// (mode d'emploi complet en haut de ce fichier : ajouter une photo = 3 étapes).
// Le texte alternatif est cherché par `id` dans les dicos ; s'il manque, on
// retombe sur un libellé générique plutôt que de casser le build.
const galleryAlt = sh.galleryAlt as Record<string, string | undefined>
const gallerySlides = showroomGallery.map((p) => ({
  src: p.src,
  w: p.w,
  h: p.h,
  // `wide` = image affichée ENTIÈRE (object-fit: contain) : indispensable ici,
  // le carrousel mélange des photos paysage et portrait — en `cover` les
  // portraits seraient rognés de moitié.
  wide: true,
  alt: galleryAlt[p.id] ?? sh.galleryAltFallback,
}))
// `undefined` = les libellés français par défaut du composant.
const carouselLabels =
  lang === 'en'
    ? { prev: 'Previous photo', next: 'Next photo', photo: 'Photo', photosOf: 'Photos of' }
    : lang === 'es'
      ? { prev: 'Foto anterior', next: 'Foto siguiente', photo: 'Foto', photosOf: 'Fotos de' }
      : undefined

// 🎠 CARROUSEL « Le reste de ce que je joue est là aussi » (20/08/2026, David :
// « il faudrait créer un carrousel où on voit des images de calebasse / micro
// Hisong / micro Muling / Gonilélé »). La section annonçait ces instruments EN
// MOTS : seule la harpe avait une image, et les micros et la calebasse
// n'existaient nulle part en photo sur la page.
// Le CHOIX des cinq visuels et la raison de chacun sont documentés dans
// `showroomAlsoGallery` (src/data/showroom.ts). Tous les fichiers sont
// réutilisés tels quels depuis les pages dédiées.
// ⓘ La 1ʳᵉ diapositive est l'ancienne figure isolée du Gonilélé : elle n'est pas
//   perdue, elle a rejoint le carrousel — donc le Gonilélé n'apparaît pas deux
//   fois dans la même section. Son alt reste `photoAlt.gonilele`.
const alsoAlt = sh.alsoAlt as Record<string, string | undefined>
// 🎠 CARROUSEL D'OUVERTURE (21/08/2026, David : « il faudrait simplement
// intégrer un gros carrousel tout en haut qui fait défiler les photos du
// lieu »). LA SÉQUENCE ET SA RAISON D'ÊTRE SONT DOCUMENTÉES DANS
// `showroomHeroGallery` (src/data/showroom.ts) : quatre photos, quatre
// questions muettes, dans l'ordre. Ce n'est pas une galerie décorative.
// 🖼️ `cover` (donc PAS `wide`) : on veut une bande pleine, sans bandes vides
//    autour des images — les quatre photos sont toutes en paysage et de
//    rapports proches, le cadre les épouse (voir `.hero-carousel`, global.css).
// 🔤 Les alt viennent de `sh.photoAlt`, sous la même clé que l'`id` : ce sont
//    les textes déjà écrits pour ces mêmes photos ailleurs sur la page.
const heroAlt = sh.photoAlt as Record<string, string | undefined>
const heroSlides = showroomHeroGallery.map((p) => ({
  src: p.src,
  w: p.w,
  h: p.h,
  alt: heroAlt[p.id] ?? sh.galleryAltFallback,
}))
const alsoSlides = showroomAlsoGallery.map((p) => ({
  src: p.src,
  w: p.w,
  h: p.h,
  // `wide` (object-fit: contain) comme le carrousel « En images » : la série
  // mélange portrait (harpe, micro Hisong), carré (calebasse) et paysage
  // (Muling). En `cover`, la calebasse et le préampli seraient coupés.
  wide: true,
  alt: (p.id === 'gonileleShowroom' ? sh.photoAlt.gonilele : alsoAlt[p.id]) ?? sh.galleryAltFallback,
}))
---

<Layout title={sh.title} description={sh.description} ldJSON={ld}>
  {/* ═══ 0. LE LIEU, TOUT DE SUITE — le carrousel d'ouverture ═════════════
      21/08/2026, mots de David : « il faudrait simplement intégrer un gros
      carrousel tout en haut qui fait défiler les photos du lieu. »

      🚨 CE N'EST PAS UNE GALERIE, C'EST UNE SÉQUENCE — quatre photos, quatre
         questions muettes, dans cet ordre exact (détail dans
         `showroomHeroGallery`, src/data/showroom.ts) :
           qui est-ce et où je vais · est-ce que j'y serai seul ·
           qu'est-ce que je vais y faire · à quoi ressemble le lieu.
         N'y ajouter aucune photo « parce qu'elle est belle ».

      📐 POURQUOI ICI ET PAS DANS LE HERO : le fond du hero est une VIDÉO DE
         CARTE (Google Earth qui zoome sur l'adresse), pas des photos — les
         deux ne se doublonnent pas, ils se complètent. Et posé au-dessus, le
         carrousel garde au hero son ordre de lecture, documenté plus bas et
         plusieurs fois corrigé par David (date d'abord, jamais de prix).

      🚨 CONTRAINTE DE HAUTEUR, LA PLUS IMPORTANTE DE LA PAGE : l'agenda a été
         remonté à ~2 500 px du haut sur mobile le 20/08/2026. Mesure du
         21/08 : le carrousel ne l'a repoussé que de ~190 px (2 533 → 2 723 px
         à 375 px de large), parce qu'il est bridé en 16/10 sur mobile
         (`.hero-carousel`, global.css) ET que le hero a rendu 48 px de son
         rembourrage haut (`pt-12 md:pt-24` au lieu de `py-24`) — il n'a plus
         besoin d'autant de noir avant le titre, l'image le précède.
         👉 Si tu grossis ce carrousel, remesure : au-delà de ~600 px de
            décalage, l'agenda repasse hors de portée et le gain du 20/08 est
            perdu.

      🖐️ Défilement au doigt, flèches, points, démo automatique et plein écran
         au clic : tout vient de <Carousel> + <Lightbox /> (incluse UNE seule
         fois, en bas de page). Fond `bg-ink` : le bloc et le hero sombre qui
         suit ne font qu'un seul aplat. */}
  <div class="hero-carousel bg-ink sm:px-4 sm:pt-4 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <Carousel id="showroom-hero" slides={heroSlides} alt={sh.heroTitle} labels={carouselLabels} eager />
    </div>
  </div>

  {/* ═══ 1. HERO — « c'est quoi · c'est quand · c'est gratuit » ═══════════ */}
  <section class="relative overflow-hidden bg-ink text-cream">
    <video class="absolute inset-0 h-full w-full object-cover opacity-65" autoplay muted loop playsinline poster="/images/localisation-showroom-poster.webp"><source src="/images/localisation-showroom.mp4" type="video/mp4" /></video>
    {/* 🚨 `veil-hero-y` (global.css) et non `bg-gradient-to-t` : le dégradé
        Tailwind v4 disparaît en silence sur les moteurs qui ignorent « in oklab »
        ou @property, et le texte crème se retrouve nu sur la vidéo. */}
    <div class="veil-hero-y absolute inset-0"></div>
    {/* `pt-12 md:pt-24` (21/08/2026) : le carrousel d'ouverture précède
        maintenant le hero, il n'y a plus besoin de 96 px de noir avant le
        surtitre sur mobile — et ces 48 px rendus compensent en partie la
        hauteur du carrousel dans la course de l'agenda vers le haut. */}
