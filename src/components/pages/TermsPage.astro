---
// Page « Conditions générales » (/conditions-generales · /en/conditions-generales).
//
// Pourquoi un composant à part et pas LegalPage : les mentions légales sont
// quatre paragraphes ({h, p}) ; les conditions générales ont besoin de listes
// (données collectées formulaire par formulaire, outils tiers, droits) et d'un
// bandeau version + date — c'est ce numéro de version qui est enregistré avec
// chaque consentement.
//
// 🚨 Le contenu vit dans le bloc `terms` de src/i18n/dict.ts (FR) et
// src/i18n/en.ts (EN). Chaque affirmation y est sourcée en commentaire :
// ne rien y ajouter qui ne soit pas vérifiable dans le dépôt ou dans les faits.
// ⚠️ `terms.version` doit rester égal à TERMS_VERSION dans
// supabase/functions/site-lead/index.ts.
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import Button from '@/components/Button.astro'
import { getDict } from '@/i18n/dict'
import { localizePath } from '@/i18n/utils'
import { site } from '@/data/site'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const cg = t.terms
const legalHref = localizePath('/mentions-legales', lang)
---

<Layout title={cg.title} description={cg.description}>
  <Section width="narrow">
    <h1 class="font-display text-3xl font-700 lg:text-4xl">{cg.h1}</h1>

    <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-600 uppercase tracking-wide text-ink-soft/70">
      <span>{cg.versionLabel} {cg.version}</span>
      {/* Le séparateur disparaît en dessous de sm : à 375 px la ligne passe sur
          deux lignes et le point resterait suspendu en fin de première ligne. */}
      <span aria-hidden="true" class="hidden text-copper sm:inline">·</span>
      <span>{cg.updatedLabel} : {cg.updated}</span>
    </p>

    <p class="mt-6 text-lg leading-relaxed text-ink-soft">{cg.lead}</p>

    <div class="mt-12 space-y-10 text-ink-soft/90">
      {cg.sections.map((s) => (
        <div>
          <h2 class="font-display text-xl font-700 text-ink">{s.h}</h2>
          <p class="mt-2 leading-relaxed">{s.p}</p>
          {s.items.length > 0 && (
            <ul class="mt-4 space-y-3">
              {s.items.map((it) => (
                <li class="flex gap-3 leading-relaxed">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-copper"></span>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <div class="mt-14 rounded-card border border-copper/25 bg-copper/5 p-6">
      <h2 class="font-display text-xl font-700 text-ink">{cg.contactTitle}</h2>
      <p class="mt-2 leading-relaxed text-ink-soft/90">{cg.contactText}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <Button href={`mailto:${site.email}`}>{cg.contactCta}</Button>
        <a href={legalHref} class="text-sm font-600 underline decoration-copper/50 underline-offset-4 hover:text-rust">{cg.legalLink}</a>
      </div>
    </div>
  </Section>
</Layout>
