      <figcaption
        class="border-t border-cream/10 px-4 py-3 text-sm leading-relaxed text-cream/75"
        set:html={mesh(a.showroomPhotoCaption)}
      />
    </figure>

    <ul class="mx-auto mt-10 grid max-w-4xl gap-3 md:grid-cols-3">
      {a.showroomPoints.map((p) => (
        <li class="flex items-start gap-3 rounded-card border border-cream/15 bg-cream/5 p-5 text-sm leading-relaxed text-cream/85">
          <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-gold" />
          <span>{p}</span>
        </li>
      ))}
    </ul>

    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <Button href={tryHref} variant="primary">{a.ctaTry}</Button>
      <Button href={L('/showroom')} variant="light">{a.showroomAgendaCta}</Button>
    </div>

    {/* ── ET SI TU PRÉFÈRES COMMANDER EN LIGNE ──────────────────────────────
        Volontairement SOUS l'essai, en carte discrète, sans bouton plein.
        🚧 Ce qu'Atlas ne dit pas (délai, garantie) est annoncé comme inconnu,
           pas comblé par une estimation. */}
    <div class="mx-auto mt-14 max-w-3xl rounded-card border border-cream/15 bg-cream/5 p-6 md:p-8">
      <h3 class="font-display text-xl font-700 text-cream">{a.buyTitle}</h3>
      <p class="mt-3 text-cream/80">{a.buyText}</p>
      <p class="mt-4 rounded-lg border border-gold/30 bg-gold/10 p-4 text-sm text-cream/80">{a.buyNote}</p>

      {ATLAS_PROMO_ACTIVE && ATLAS_DISCOUNT_CODE && (
        <div class="mt-6 rounded-card border border-gold/40 bg-gold/10 p-5 md:p-6">
          <p class="inline-flex items-center gap-2 text-xs font-700 uppercase tracking-[0.2em] text-gold">
            <Icon name="lucide:ticket-percent" class="h-4 w-4" />
            {a.promoTitle}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-cream/85">{a.promoText}</p>
          {/* Même mécanique que la carte ÖKO de la boutique (ShopCard.astro) :
              le code reste LISIBLE à l'écran, le bouton ne fait que l'économie
              d'une sélection à la souris. Si le presse-papier est indisponible,
              rien ne casse — le code est déjà écrit. */}
          <div class="mt-4 flex flex-wrap items-center gap-3 rounded-lg border border-cream/20 bg-ink/40 px-4 py-3">
            <code class="font-display text-lg font-700 tracking-widest text-gold">{ATLAS_DISCOUNT_CODE}</code>
            <button
              type="button"
              class="shop-copy-code ml-auto shrink-0 rounded-full bg-gold/20 px-4 py-1.5 text-xs font-700 text-gold transition-colors hover:bg-gold hover:text-ink"
              data-code={ATLAS_DISCOUNT_CODE}
              data-copy-label={t.shop.copyCode}
              data-copied-label={t.shop.codeCopied}
            >{t.shop.copyCode}</button>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-cream/65">{a.promoDisclosure}</p>
        </div>
      )}

      <p class="mt-6">
        <a href={atlasLink(atlasSite)} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-600 text-cream/70 underline decoration-cream/25 underline-offset-4 hover:text-gold">
          {a.ctaSite}
          <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
        </a>
      </p>
    </div>
  </Section>

  {/* 🖼️ UNE SEULE lightbox pour toute la page : les carrousels y envoient leurs
      diapositives, et les images hors carrousel via `data-lb` (hero, tête
      Atlas Body, photos de scène de David). */}
  <Lightbox labels={{ close: a.lightbox.close, prev: a.carousel.prev, next: a.carousel.next, zoom: a.lightbox.zoom }} />
</Layout>

<script>
  // Bouton « copier le code » du bloc de réduction Atlas — même comportement
  // que celui de la boutique (ShopPage.astro). Le sélecteur ne trouve rien tant
  // que `ATLAS_PROMO_ACTIVE` est `false` : la boucle ne fait alors rien du tout.
  document.querySelectorAll('.shop-copy-code').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') || ''
      const copyLabel = btn.getAttribute('data-copy-label') || ''
      const copiedLabel = btn.getAttribute('data-copied-label') || ''
      try {
        await navigator.clipboard.writeText(code)
        btn.textContent = copiedLabel
        window.setTimeout(() => { btn.textContent = copyLabel }, 1800)
      } catch {
        // Presse-papier indisponible (contexte non sécurisé…) : le code reste lisible.
      }
    })
  })
</script>
