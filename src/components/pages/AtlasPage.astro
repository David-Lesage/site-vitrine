---
// ============================================================
// PAGE PRODUIT — LES PIEDS ATLAS (/pieds-atlas et /en/pieds-atlas)
//
// Bâtie sur le MÊME gabarit que les autres fiches produit du site
// (GonilelePage, MulingPage) : hero sombre + fil d'Ariane vers la boutique,
// sections alternées cream / cream-deep / ink, <Carousel> + <Lightbox> pour
// les photos, données neutres dans src/data/atlas.ts, prose dans src/i18n.
//
// 🎯 LA PAGE EST UN TUNNEL, ET SA DESTINATION EST LE SHOWROOM (20/08/2026).
//    Cap donné par David après relecture : « ça renvoie tout vers le site
//    d'Atlas, et moi ce que je veux c'est que les gens viennent l'essayer au
//    showroom ». Donc, PARTOUT sur cette page :
//      · action PRINCIPALE (bouton plein, rust)  → /showroom#agenda
//      · action SECONDAIRE (lien discret, ghost) → la fiche officielle Atlas
//    Ne pas ré-inverser ces deux rôles sans une demande explicite de David.
//
//    Ordre des sections, dans cet ordre et pas un autre :
//      1. hero                — les deux pieds, et « viens les essayer »
//      2. #debout   MON EXPÉRIENCE — pourquoi je joue debout (récit + scène)
//      3. #probleme LE PROBLÈME    — les pieds que j'ai usés avant Atlas
//      4. #solution LA SOLUTION    — pourquoi Atlas répond à ça
//      5. partenariat + vérification + vidéo (l'honnêteté, en un seul bloc)
//      6. #modeles  les deux modèles
//      7. #tete     la tête du pied
//      8. #essayer  VENIR LES ESSAYER (+ commander, en second)
//
// 🚨 CE QUI NE DOIT PAS BOUGER SANS SOURCE :
//    · tous les chiffres viennent des fiches officielles Atlas (voir l'en-tête
//      de src/data/atlas.ts, qui liste aussi ce qu'Atlas ne dit PAS) ;
//    · David n'a pas encore reçu les pieds → aucun avis d'usage sur la page ;
//    · aucune promesse acoustique endossée par David : ce qu'Atlas dit du son
//      est entre guillemets et signé Atlas, jamais repris à son compte.
//
// 🖼️ RÈGLE D'IMAGE (David, 20/08/2026 : « ça fait brouillon ») : une image ne
//    reste sur cette page que si elle DÉMONTRE quelque chose que le texte ne
//    démontre pas. Trois visuels ont sauté à ce titre — voir les commentaires
//    « PHOTO RETIRÉE » plus bas. Avant d'en rajouter une, se demander ce
//    qu'elle prouve.
//
// 🚧 TROIS EMPLACEMENTS RÉSERVÉS, tous pilotés depuis src/data/atlas.ts :
//    · la vidéo de démonstration de David  → `atlasDemoVideoId`
//    · le lien d'affiliation               → `ATLAS_AFFILIATE_URL`
//    · le code de réduction                → `ATLAS_PROMO_ACTIVE` (éteint)
// ============================================================
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Button from '@/components/Button.astro'
import Carousel from '@/components/Carousel.astro'
import Lightbox from '@/components/Lightbox.astro'
import YouTube from '@/components/YouTube.astro'
import { Icon } from 'astro-icon/components'
import {
  atlasProPhotos, atlasAllPhotos, atlasBodyPhotos, atlasProHeightPhoto, atlasProHeightSquare,
  atlasAllHeightPhotos, atlasAllHeightPct,
  atlasPrices, atlasRegularPrices, atlasSpecs, ATLAS_PRICES_READ_AT, ATLAS_SALE_ON,
  atlasProUrl, atlasAllUrl, atlasBodyUrl, atlasSite, atlasLink, atlasDemoVideoId,
  atlasTheVoiceVideoId,
  ATLAS_AFFILIATE_URL, ATLAS_PROMO_ACTIVE, ATLAS_DISCOUNT_CODE, ATLAS_BODY_STATUS, type AtlasPhoto,
} from '@/data/atlas'
import { getDict } from '@/i18n/dict'
import { localizePath, numberLocale } from '@/i18n/utils'
import { breadcrumbLdJson } from '@/lib/ldJson'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const a = t.atlas
const L = (p: string) => localizePath(p, lang)
const locale = numberLocale(lang)
const eur = (n: number) => n.toLocaleString(locale) + ' €'
const alt = a.alt as Record<string, string>

// 🎯 LA destination de la page. Le lien pointe sur l'agenda du showroom (et pas
// sur le haut de /showroom) : c'est là que se trouvent les dates et le bouton
// de réservation. Si l'ancre `#agenda` disparaissait de ShowroomPage.astro,
// c'est ici qu'il faudrait le voir.
const tryHref = L('/showroom') + '#agenda'

// 🔗 MAILLAGE INTERNE — YISHAMA & NEOTONE (David, 20/08/2026)
//    « dès que tu as l'occasion de citer Yishama ou Neotone […], fais en sorte
//      que le mot renvoie vers la page de mon site dédiée, pour faire un
//      maillage. »
//    Les URL ne vivent PAS dans les dictionnaires : le texte i18n porte un
//    jeton `{yishama}` / `{neotone}`, remplacé ici par un vrai lien construit
//    avec `L()`. Conséquence : `/yishama` en FR et `/en/yishama` en EN, sans
//    qu'aucune traduction ait à connaître le préfixe de langue.
//
// ⚠️ DEUX RÈGLES, ET ELLES SONT LA RAISON D'ÊTRE DE CE HELPER :
//    1. UN SEUL LIEN PAR DESTINATION SUR LA PAGE. Aujourd'hui : Yishama dans
//       la légende du festival (#probleme), Neotone dans la légende de la photo
//       du showroom (#essayer). Les autres mentions restent en TEXTE SIMPLE —
//       un semis de liens internes nuit à la lecture ET au référencement.
//    2. ON NE RÉÉCRIT PAS UNE PHRASE POUR Y CASER UN LIEN. Le jeton ne se pose
//       que là où le mot était déjà là (ou devait y être : David a demandé que
//       les Yishama soient NOMMÉS dans la légende du festival).
const mesh = (s: string) =>
  s
    .replace('{yishama}', `<a href="${L('/yishama')}" class="font-600 text-cream underline decoration-cream/40 underline-offset-4 transition-colors hover:text-gold">Yishama</a>`)
    .replace('{neotone}', `<a href="${L('/le-neotone')}" class="font-600 text-cream underline decoration-cream/40 underline-offset-4 transition-colors hover:text-gold">Neotone</a>`)

// Les photos passent au carrousel avec leur VRAI texte alternatif et leurs
// dimensions : la place est réservée au chargement, la page ne saute pas.
const slides = (photos: AtlasPhoto[]) => photos.map((p) => ({ src: p.src, alt: alt[p.id], w: p.w, h: p.h }))
const carouselLabels = a.carousel

// Valeurs chiffrées construites depuis src/data/atlas.ts : le FR et l'EN ne
// peuvent pas afficher deux nombres différents.
const height = (min: number, max: number) => a.heightValue.replace('{min}', String(min)).replace('{max}', String(max))
const weight = (w: number) => a.weightValue.replace('{w}', w.toLocaleString(locale))

// 💶 Le PRIX sort du tableau de caractéristiques : il a son propre bloc, parce
// qu'une promotion est en cours et qu'un prix barré demande du balisage (<s>),
// pas une chaîne de caractères. `ATLAS_SALE_ON` pilote l'affichage du prix barré.
const priceNote = a.priceNote.replace(
  '{date}',
  new Date(ATLAS_PRICES_READ_AT).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' }),
)

const proRows = [
  { t: a.specs.height, d: height(atlasSpecs.pro.heightMinCm, atlasSpecs.pro.heightMaxCm) },
  { t: a.specs.weight, d: weight(atlasSpecs.pro.weightKg) },
  { t: a.specs.material, d: a.pro.material },
  { t: a.specs.mount, d: a.pro.mount },
  { t: a.specs.positions, d: a.pro.positions },
  { t: a.specs.bag, d: a.pro.bag },
  // ⚠️ LIGNE DÉLIBÉRÉMENT PRÉSENTE : le créateur d'Atlas a confirmé que la
  // partie bois n'est PAS comprise avec le Pro. La mettre dans le tableau, à
  // côté du prix, c'est ce qui évite qu'un acheteur le découvre au colis.
  { t: a.specs.bodyOption, d: a.pro.body },
]
// 🚧 L'Atlas All n'a NI ligne « Poids » NI ligne « Transport » : Atlas ne donne
// ni son poids, ni l'essence du bois, ni l'existence d'un sac pour ce modèle.
// Ne pas ajouter ces lignes tant qu'Atlas ne les a pas confirmées à David.
// ✅ En revanche il A une ligne « Tête Atlas Body → incluse », et le Pro ne l'a
// PAS : cette asymétrie est voulue et sourcée (voir ATLAS_BODY_STATUS).
const allRows = [
  { t: a.specs.height, d: height(atlasSpecs.all.heightMinCm, atlasSpecs.all.heightMaxCm) },
  { t: a.specs.material, d: a.all.material },
  { t: a.specs.mount, d: a.all.mount },
  { t: a.specs.positions, d: a.all.positions },
  ...(ATLAS_BODY_STATUS.includedInAll ? [{ t: a.specs.body, d: a.all.body }] : []),
]

// 📏 LA PHOTO « DEUX HAUTEURS » EST UNE DIAPOSITIVE, PLUS UNE FIGURE.
//    Avant : elle était répétée en grand SOUS le tableau du Pro — d'où une
//    colonne Pro plus longue que la colonne All, et un grand vide sous le
//    tableau du All (défaut relevé par David sur sa capture).
//    Maintenant : elle est la 2ᵉ diapositive du carrousel Pro (juste après la
//    photo de couverture), dans sa version carrée `atlasProHeightSquare` —
//    la raison du fichier carré est expliquée dans src/data/atlas.ts.
//    ➡️ Conséquence directe : les DEUX colonnes ont exactement la même
//       structure (carrousel · prix · texte · tableau · note · boutons), donc
//       plus de déséquilibre. Ne pas remettre de figure sous un seul des deux.
const proSlides = [
  slides(atlasProPhotos)[0],
  { src: atlasProHeightSquare.src, alt: alt[atlasProHeightSquare.id], w: atlasProHeightSquare.w, h: atlasProHeightSquare.h },
  ...slides(atlasProPhotos).slice(1),
]

const models = [
  { key: 'pro', copy: a.pro, rows: proRows, slides: proSlides, href: atlasLink(atlasProUrl), icon: 'lucide:ruler',
    price: atlasPrices.pro, was: atlasRegularPrices.pro },
  { key: 'all', copy: a.all, rows: allRows, slides: slides(atlasAllPhotos), href: atlasLink(atlasAllUrl), icon: 'lucide:trees',
    price: atlasPrices.all, was: atlasRegularPrices.all },
]

const whyIcons = ['lucide:move-vertical', 'lucide:magnet', 'lucide:map-pin']
const factIcons = ['lucide:check-check', 'lucide:shield-check', 'lucide:undo-2']
const headIcons = ['lucide:armchair', 'lucide:hand', 'lucide:wind']
const storyStandIcons = ['lucide:heart-handshake', 'lucide:weight', 'lucide:unlink']
// Les 3 cartes « incluse / non annoncé / vendue à part » : le vert de la 1ʳᵉ et
// le neutre de la 2ᵉ ne sont PAS décoratifs — ils disent au premier coup d'œil
// que l'Atlas All l'a et que le Pro ne l'a pas annoncé. Ne pas uniformiser.
const includedStyle = ['border-copper/40 bg-copper/5', 'border-ink/15 bg-cream', 'border-ink/10 bg-cream']
const includedIcons = ['lucide:check-circle-2', 'lucide:circle-slash', 'lucide:shopping-bag']
const includedAccent = ['text-copper', 'text-ink-soft/50', 'text-ink-soft/70']

const ld = [
  breadcrumbLdJson([
    { name: t.common.nav.home, url: L('/') },
    { name: t.common.nav.shop, url: L('/boutique') },
    { name: a.heroTitle, url: L('/pieds-atlas') },
  ]),
]
---

<Layout title={a.title} description={a.description} image="/images/prod-atlas-all-1.webp" ldJSON={ld}>
  <section class="relative overflow-hidden bg-ink text-cream">
    <div class="chroma-bar absolute inset-x-0 top-0 h-1"></div>
    <div class="mx-auto max-w-7xl px-4 py-16 lg:px-8 lg:py-24">
      <a href={L('/boutique') + '#accessoires'} class="text-sm font-600 text-cream/70 hover:text-gold">{a.back}</a>
      {/* 🖼️ DIPTYQUE — LES DEUX PIEDS, CHACUN À SES DEUX HAUTEURS.
          Demandes successives de David : (1) voir les DEUX modèles sans
          défiler, (2) voir sur chaque photo le même pied haut ET bas.
          ⚠️ `order-1 lg:order-2` : à 375 px les images passent AVANT le texte,
             sinon les pieds tombent sous la ligne de flottaison. Ne pas
             réinverser. Les cartes s'empilent sous 640 px pour que chaque pied
             reste lisible ; côte à côte au-delà.
          ⚠️ ASYMÉTRIE DE CONTENU VOULUE : le Pro a UNE photo (deux pieds réels
             dans un même cliché), le All en a DEUX (cette photo n'existe pas
             chez Atlas, et la composer aurait faussé le rapport de hauteurs —
             la mesure est dans src/data/atlas.ts). Les hauteurs réelles sont
             donc ÉCRITES sous chaque image du All : c'est le texte qui porte
             la comparaison. Ne pas fusionner les deux mises en page.
          📐 EN REVANCHE LE CADRE EST IDENTIQUE (David, 20/08/2026 : « il faut
             que l'espace hauteur et largeur de chaque photo soient identiques,
             sinon ce n'est pas équilibré pour l'œil »). Les deux zones image
             partagent EXACTEMENT la même hauteur (`h-44 sm:h-56 lg:h-72`) et le
             même fond blanc ; la grille étire les deux figures à la même
             hauteur, donc les deux légendes tombent sur la même ligne. Si tu
             changes une de ces trois valeurs, change LES DEUX cartes.
             ⚠️ Jamais d'étirement : les deux images restent en `object-contain`,
             c'est l'échelle qui s'ajuste, pas les proportions. */}
      <div class="mt-6 grid items-center gap-10 lg:grid-cols-2">
        <div class="order-1 lg:order-2">
          <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
            {/* Atlas Pro — un seul cliché, les deux hauteurs dedans. */}
            <figure class="overflow-hidden rounded-card border border-cream/15 bg-cream/5">
              {/* ⚠️ FLEX ET PAS GRID — piège vérifié dans le navigateur le
                  20/08/2026 : avec `grid place-items-center`, la hauteur en %
                  de l'image se résout contre la ZONE de grille (indéfinie, car
                  l'item n'est pas étiré) → `h-full` était ignoré, l'image
                  reprenait sa taille naturelle et DÉBORDAIT du cadre (467 px
                  dans une boîte de 288, rognée par `overflow-hidden`). En flex,
                  le bloc conteneur de l'image est le conteneur flex, qui a bien
                  une hauteur définie : `h-full` fonctionne. C'est la même
                  raison qui fait marcher les pourcentages de la carte All. */}
              <div class="flex h-44 items-center justify-center bg-white p-2 sm:h-56 sm:p-3 lg:h-72">
                <img
                  src={atlasProHeightPhoto.src}
                  width={atlasProHeightPhoto.w}
                  height={atlasProHeightPhoto.h}
                  alt={alt[atlasProHeightPhoto.id]}
                  loading="eager"
                  decoding="async"
                  data-lb="atlas-hero"
                  class="h-full w-auto object-contain"
                />
              </div>
              <figcaption class="px-3 py-2.5 text-center">
                <p class="font-display text-sm font-700 text-cream sm:text-base">{a.pro.name}</p>
                <p class="mt-0.5 text-[11px] leading-tight text-cream/65 sm:text-xs">{a.heroProCaption}</p>
              </figcaption>
            </figure>

            {/* Atlas All — deux clichés distincts, chacun étiqueté de sa
                hauteur réelle. L'étiquette n'est pas décorative : c'est elle
                qui empêche de lire une comparaison métrique dans deux photos
                qui n'ont pas été prises dans les mêmes conditions. */}
            <figure class="overflow-hidden rounded-card border border-cream/15 bg-cream/5">
              {/* ⚠️ LES DEUX PIEDS SONT AFFICHÉS AU VRAI RAPPORT 50/96, pas à la
                  même hauteur CSS. Sans ce calcul (`atlasAllHeightPct`), les
                  deux photos s'affichaient à taille identique alors que leurs
                  étiquettes annonçaient 50 cm et 96 cm : l'image démentait le
                  texte. `items-end` pose les deux pieds sur la même ligne de
                  sol, sans quoi la comparaison ne se lit pas. */}
              <div class="flex h-44 items-end justify-center gap-4 bg-white p-2 sm:h-56 sm:p-3 lg:h-72">
                {atlasAllHeightPhotos.map((it, i) => (
                  <div class="flex h-full flex-col items-center justify-end">
                    {/* Zone image = hauteur de la boîte MOINS la ligne
                        d'étiquette, sinon le pied haut (100 %) déborde et se
                        fait rogner la tête. */}
                    <div class="flex h-[calc(100%-1.35rem)] items-end">
                      <img
                        src={it.photo.src}
                        width={it.photo.w}
                        height={it.photo.h}
                        alt={alt[it.photo.id]}
                        loading="eager"
                        decoding="async"
                        data-lb="atlas-hero"
                        class="w-auto object-contain"
                        style={`height:${atlasAllHeightPct[i].toFixed(1)}%`}
                      />
                    </div>
                    <span class="mt-1 flex h-[1.1rem] shrink-0 items-center rounded-full bg-ink/8 px-2 text-[10px] font-700 tracking-wide text-ink-soft/80 sm:text-[11px]">
                      {a.heightCm.replace('{n}', String(it.cm))}
                    </span>
                  </div>
                ))}
              </div>
              <figcaption class="px-3 py-2.5 text-center">
                <p class="font-display text-sm font-700 text-cream sm:text-base">{a.all.name}</p>
                <p class="mt-0.5 text-[11px] leading-tight text-cream/65 sm:text-xs">{a.heroAllCaption}</p>
              </figcaption>
            </figure>
          </div>
        </div>
        <div class="order-2 lg:order-1">
          <p class="text-xs font-700 uppercase tracking-[0.2em] text-gold">{a.eyebrow}</p>
          <h1 class="mt-4 font-display text-4xl font-700 leading-tight md:text-5xl">{a.heroTitle}</h1>
          <p class="mt-5 text-lg text-cream/85">{a.heroLead}</p>
          {/* 🎯 L'ORDRE DES DEUX BOUTONS EST LE SUJET DE TOUTE LA REFONTE :
              l'essai au showroom est le bouton PLEIN, la fiche produit passe en
              second. Ne pas remettre `#modeles` en `primary`. */}
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={tryHref} variant="primary">{a.ctaTry}</Button>
            <Button href="#modeles" variant="light">{a.ctaModels}</Button>
          </div>
          <p class="mt-5 max-w-xl text-sm leading-relaxed text-cream/70">{a.heroTryNote}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── ÉTAPE 1 · MON EXPÉRIENCE ────────────────────────────────────────────
      Le récit n'est plus une section « à part » qu'on lit après coup : c'est
      la PREMIÈRE marche du tunnel. Il pose qui parle et pourquoi un pied de
      handpan est un outil de métier chez lui — sans quoi la section suivante
      (« les pieds que j'ai usés ») ne pèse rien.

      ✅ SEULE SECTION OÙ DAVID PARLE EN SON NOM PLEIN — expérience vécue,
         registre affirmé. Ne pas y remettre de prudence défensive.
      🚨 NE JAMAIS laisser entendre qu'il a déjà utilisé les pieds Atlas. */}
  <Section id="debout">
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr]">
      <div>
        <SectionHeading align="left" eyebrow={a.storyEyebrow} title={a.storyTitle} />
        <p class="mt-5 text-lg text-ink-soft/90">{a.storyIntro}</p>
      </div>
      <figure class="overflow-hidden rounded-card border border-ink/10 bg-ink">
        <img
          src="/images/david-scene-debout-1.webp"
          width="1600"
          height="856"
          alt={alt.stageStanding}
          loading="lazy"
          decoding="async"
          data-lb="atlas-scene"
          class="block h-auto w-full"
        />
      </figure>
    </div>

    {/* 📷 LE SHOWROOM, DANS LA SECTION « POURQUOI JE JOUE DEBOUT » — photo
        choisie par David le 20/08/2026 : « cette photo avec les 2 Yishama sur
        pied est aussi intéressante ».

        POURQUOI ICI, ET PAS DANS #probleme NI DANS #solution :
        1. #probleme nomme les fabricants des pieds que David a usés (Jacomina
           Kistemaker, Meinl, S Pan). Y poser une photo des pieds qu'il utilise
           AUJOURD'HUI, c'est exactement le dénigrement que toute la page évite —
           c'est déjà la raison qui a envoyé la photo du showroom dans #essayer.
        2. #solution s'appelle « Pourquoi Atlas, maintenant ». Les pieds visibles
           sur cette photo ne SONT PAS des Atlas (ils ne sont pas arrivés) : la
           section les ferait lire comme tels. C'est le seul mensonge possible.
        3. Ici, elle démontre quelque chose que la photo au-dessus ne démontre
           pas : celle-là prouve le jeu debout EN CONCERT, sous les projecteurs.
           Celle-ci prouve que ce n'est pas une posture de scène — dans sa propre
           pièce aussi, les instruments vivent montés sur pieds, à hauteur de jeu.
           C'est le pas qui manquait avant « les pieds que j'ai usés ».
        ♻️ Fichier RÉUTILISÉ TEL QUEL : /images/prod-muling-10.jpg (1200×675), il
           sert déjà sur /micro-muling (`mulingPhotos`). Ni copie, ni ré-encodage.
        📐 `max-w-3xl` : la source fait 1200 px de large, on ne la sert jamais
           au-delà. `data-lb="atlas-scene"` = même groupe de lightbox que les
           deux photos de scène, on navigue de l'une à l'autre au clavier. */}
    <figure class="mx-auto mt-12 max-w-3xl overflow-hidden rounded-card border border-ink/10 bg-ink">
      <img
        src="/images/prod-muling-10.jpg"
        width="1200"
        height="675"
        alt={alt.showroomYishama}
        loading="lazy"
        decoding="async"
        data-lb="atlas-scene"
        class="block h-auto w-full"
      />
      <figcaption class="border-t border-cream/10 px-4 py-3 text-sm leading-relaxed text-cream/75">{a.storyShowroomCaption}</figcaption>
    </figure>

    {/* 🗑️ PHOTO RETIRÉE — `david-scene-plateau.webp` (le plateau installé avant
        un concert en Suisse). Elle démontrait « un pied vit au milieu d'une
        installation entière » — mais la photo ci-dessus le montre DÉJÀ, et en
        mieux : David y est, en train de jouer, au milieu du même dispositif.
        C'était donc un doublon d'argument, et David a demandé moins d'images.
        Le fichier reste dans public/images/ et la légende reste dans les deux
        dictionnaires (`storyPlateauCaption`, `alt.stagePlateau`) : rien à
        réécrire si on veut la remettre. */}

    {/* 🎬 « THE VOICE » — LA VIDÉO OFFICIELLE (identifiant `_v60Ow5_axY`, piloté
        depuis src/data/atlas.ts, lire l'avis de droits qui l'accompagne).
        C'est la chaîne TF1 qui l'a publiée : l'INTÉGRER est l'usage prévu,
        ré-afficher des CAPTURES de l'émission ne l'est pas — c'est pourquoi il
        n'y a ici aucune image fixe de The Voice.
        🚫 NE PAS ajouter de photo à côté : la vignette montre déjà David debout
        derrière ses deux handpans avec le N'Goni. La vidéo EST l'illustration.
        Le `&&` reste : si l'identifiant repasse à `null`, le texte se remet
        tout seul sur une colonne étroite, sans trou dans la grille. */}
    <div class:list={['mt-12 grid items-center gap-8', atlasTheVoiceVideoId ? 'lg:grid-cols-[1fr_1.05fr]' : 'max-w-3xl']}>
      {atlasTheVoiceVideoId && (
