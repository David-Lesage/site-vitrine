---
// Page /a-propos — la biographie de David Lesage.
//
// ⚠️ PERSONNE RÉELLE : tout le texte vit dans `dict.about` / `en.about`,
// où chaque fait est sourcé (voir le commentaire en tête de ce bloc i18n).
// Ne jamais ajouter ici de fait qui ne serait pas déjà écrit et sourcé là-bas.
//
// Structure : hero → récit en chapitres (avec deux citations en respiration)
// → jalons datés → ce que je fais aujourd'hui → vision → repères → CTA.
// Composants réutilisés tels quels : Section, SectionHeading, Button.
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Button from '@/components/Button.astro'
import BookingForm from '@/components/BookingForm.astro'
import { Icon } from 'astro-icon/components'
import { site, SITE_LEAD_KNOWS_CONTACT_SOURCES } from '@/data/site'
import { getDict } from '@/i18n/dict'
import { localizePath } from '@/i18n/utils'
import { personLdJson } from '@/lib/ldJson'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const a = t.about
const L = (p: string) => localizePath(p, lang)

// Voir SITE_LEAD_KNOWS_CONTACT_SOURCES (src/data/site.ts) : sans l'Edge Function
// à jour, ce bouton reste le `mailto:` d'aujourd'hui.
const bookingAttrs = SITE_LEAD_KNOWS_CONTACT_SOURCES
  ? {
      'data-booking': 'contact',
      'data-title': a.collabCta2,
      'data-intro': a.collabIntro,
      'data-prefill': t.booking.collabPrefill,
    }
  : {}

const pillarIcons = ['lucide:eye', 'lucide:heart-handshake', 'lucide:award']
const todayIcons = ['lucide:music', 'lucide:graduation-cap', 'lucide:wrench', 'lucide:link']
---

<Layout title={a.title} description={a.description} ldJSON={personLdJson()}>
  {/* ───────────── HERO ───────────── */}
  <Section tone="ink" class="!py-20">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="text-xs font-700 uppercase tracking-[0.2em] text-gold">{a.heroEyebrow}</p>
        <h1 class="mt-4 font-display text-4xl font-700 leading-tight md:text-5xl">{a.heroTitle}</h1>
        <p class="mt-5 text-lg text-cream/80">{a.heroLead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#histoire" variant="primary">{a.heroCtaStory}</Button>
          <Button href="#aujourdhui" variant="light">{a.heroCtaToday}</Button>
        </div>
      </div>
      <div class="aspect-[4/3] overflow-hidden rounded-card">
        <img src="/images/hero-david.jpg" width="2400" height="1350" alt={a.heroImgAlt} class="h-full w-full object-cover object-top" loading="eager" />
      </div>
    </div>
  </Section>

  {/* ───────────── LE RÉCIT ───────────── */}
  <Section id="histoire">
    <div class="mx-auto max-w-3xl">
      <SectionHeading align="left" eyebrow={a.storyEyebrow} title={a.storyTitle} intro={a.storyIntro} />

      <div class="mt-12 space-y-14">
        {a.chapters.map((c, i) => (
          <article>
            <p class="text-xs font-700 uppercase tracking-[0.2em] text-copper">{c.eyebrow}</p>
            <h3 class="mt-3 font-display text-2xl font-700 leading-tight md:text-3xl">{c.title}</h3>
            <div class="mt-5 space-y-4 text-lg leading-relaxed text-ink-soft/90">
              {c.paras.map((p) => <p set:html={p}></p>)}
            </div>

            {/* Respirations : une citation après Naxos, une après les 2 Yishama. */}
            {i === 3 && (
              <blockquote class="mt-8 rounded-card border border-copper/25 bg-copper/5 p-6">
                <p class="font-display text-lg leading-snug text-ink">« {a.quoteNaxos} »</p>
                <footer class="mt-3 text-xs font-700 uppercase tracking-[0.14em] text-copper">{a.quoteNaxosSource}</footer>
              </blockquote>
            )}
            {i === 4 && (
              <>
                <blockquote class="mt-8 rounded-card border border-copper/25 bg-copper/5 p-6">
                  <p class="font-display text-lg leading-snug text-ink">« {a.quoteShips} »</p>
                  <footer class="mt-3 text-xs font-700 uppercase tracking-[0.14em] text-copper">{a.quoteShipsSource}</footer>
                </blockquote>
                <div class="mt-8 flex flex-wrap gap-3">
                  <Button href={L('/yishama')} variant="ghost">{a.linkYishama}</Button>
                  <Button href={L('/handpan-compagnon')} variant="ghost">{a.linkApp}</Button>
                </div>
              </>
            )}
          </article>
        ))}
      </div>
    </div>
  </Section>

  {/* ───────────── JALONS DATÉS ───────────── */}
  <Section tone="cream-deep">
    <SectionHeading align="left" eyebrow={a.milestonesEyebrow} title={a.milestonesTitle} />
    <ol class="mx-auto mt-10 max-w-3xl space-y-0 border-l border-copper/25 pl-6 lg:mx-0">
      {a.milestones.map((m) => (
        <li class="relative py-4">
          <span class="absolute -left-[1.9rem] top-6 h-2.5 w-2.5 rounded-full bg-copper" aria-hidden="true"></span>
          <p class="text-xs font-700 uppercase tracking-[0.14em] text-copper">{m.y}</p>
          <p class="mt-1 text-lg leading-relaxed text-ink-soft/90">{m.t}</p>
        </li>
      ))}
    </ol>
  </Section>

  {/* ───────────── AUJOURD'HUI ───────────── */}
  <Section id="aujourdhui">
    <SectionHeading eyebrow={a.todayEyebrow} title={a.todayTitle} intro={a.todayIntro} />
    <div class="mt-10 grid items-start gap-6 md:grid-cols-2">
      {a.today.map((c, i) => (
        <div class="rounded-card border border-ink/10 bg-cream-deep/40 p-6">
          <Icon name={todayIcons[i]} class="h-7 w-7 text-copper" />
          <h3 class="mt-3 font-display text-xl font-700">{c.t}</h3>
          <p class="mt-2 leading-relaxed text-ink-soft/85">{c.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={L('/showroom')} variant="ghost">{t.common.nav.showroom}</Button>
      <Button href={L('/cours')} variant="ghost">{t.common.nav.lessons}</Button>
    </div>
  </Section>

  {/* ───────────── VISION ───────────── */}
  <Section tone="cream-deep">
    <SectionHeading eyebrow={a.visionEyebrow} title={a.visionTitle} intro={a.visionIntro} />
    <div class="mt-10 grid items-start gap-6 md:grid-cols-3">
      {a.pillars.map((c, i) => (
        <div class="rounded-card border border-ink/10 bg-cream p-6">
          <Icon name={pillarIcons[i]} class="h-7 w-7 text-copper" />
          <h3 class="mt-3 font-display text-xl font-700">{c.t}</h3>
          <p class="mt-2 text-ink-soft/85">{c.d}</p>
        </div>
      ))}
    </div>
  </Section>

  {/* ───────────── REPÈRES ───────────── */}
  <Section>
    <SectionHeading eyebrow={a.proofsEyebrow} title={a.proofsTitle} intro={a.proofsIntro} />
    <div class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-3">
      {a.proofs.map((c) => (
        <span class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-cream-deep/50 px-4 py-2 font-600">
          <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-copper" /> {c}
        </span>
      ))}
    </div>
  </Section>

  {/* ───────────── CTA ───────────── */}
  <Section tone="ink">
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeading tone="light" eyebrow={a.collabEyebrow} title={a.collabTitle} intro={a.collabIntro} />
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={L('/contact')} variant="primary">{a.collabCta1}</Button>
        {/* Proposition de collaboration : ENREGISTRÉE en base (source `contact`).
            L'ancien `mailto:` restait dans la boîte de David — une marque ou un
            organisateur qui écrivait n'apparaissait nulle part. Le `href` est
            conservé en repli si le JS ne s'exécute pas. */}
        <Button href={`mailto:${site.email}?subject=Collaboration`} {...bookingAttrs} variant="light">{a.collabCta2}</Button>
      </div>
    </div>
  </Section>
  <BookingForm lang={lang} />
</Layout>
