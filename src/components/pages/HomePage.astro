---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Button from '@/components/Button.astro'
import VideoModal from '@/components/VideoModal.astro'
import BookingForm from '@/components/BookingForm.astro'
import { newsletterMailto } from '@/lib/booking'
import { Icon } from 'astro-icon/components'
import YouTube from '@/components/YouTube.astro'
import { site, homeVideos, neotonePlaylist } from '@/data/site'
import { yishamaPlaylist } from '@/data/yishama'
import { getDict } from '@/i18n/dict'
import { localizePath } from '@/i18n/utils'
import { personLdJson, websiteLdJson, videoLdJson } from '@/lib/ldJson'
import { upcomingShowcases } from '@/lib/agenda'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const h = t.home
const L = (p: string) => localizePath(p, lang)
// Prochaines dates de showcase (mêmes données que la page showroom, via @/lib/agenda)
const showcases = upcomingShowcases(lang)
// Identifiant de la playlist YouTube, pour l'ouvrir dans la modale (le visiteur reste sur le site)
const playlistId = (neotonePlaylist.match(/list=([\w-]+)/) || [])[1] || ''

// Hero épuré (premium) : le mot-clé en dégradé de marque, les 3 piliers
// en gras doré. Plus de glyphes (notes / smileys / handpan sur les lettres).
const colorWord = lang === 'en' ? 'colours' : 'couleurs'
const geoWord = lang === 'en' ? 'geometry' : 'géométrie'
const emoWord = lang === 'en' ? 'emotions' : 'émotions'
const emphasize = (text: string, words: string[]) =>
  words.reduce((acc, w) => {
    const i = acc.indexOf(w)
    return i === -1 ? acc : `${acc.slice(0, i)}<strong class="font-600 text-gold">${w}</strong>${acc.slice(i + w.length)}`
  }, text)
const heroLeadHtml = emphasize(h.heroLead, [colorWord, geoWord, emoWord])
// ⚖️ La 1ʳᵉ carte ne pointe plus vers /le-neotone mais vers la section
// « deux univers » (#instruments) : sur l'accueil, aucun des deux mondes
// n'entre par la grande porte avant l'autre. Son visuel est volontairement
// SPLIT (acoustique | électronique), les deux moitiés à 50 %.
const universMeta = [
  { img: '/images/yishama-hero-david.webp', img2: '/images/neotone-hero-david.webp', w: 1800, h: 1200, icon: 'lucide:disc-3', href: '#instruments', fit: 'split' },
  { img: '/images/prod-cours-stages.jpg', w: 375, h: 375, icon: 'lucide:graduation-cap', href: '/cours', fit: 'cover-top' },
  { img: '/images/app-acoustique.jpg', w: 1634, h: 902, icon: 'lucide:sparkles', href: '/handpan-compagnon', fit: 'cover' },
]
// Les ancres de la page courante ne se localisent pas (`/en/#…` inutile).
const href = (p: string) => (p.startsWith('#') ? p : L(p))
// Les deux univers : même gabarit, même ordre de lecture, seuls l'accent
// et la destination changent. Acoustique en premier UNIQUEMENT parce que
// c'est l'ordre du titre « Acoustique et électronique ».
const duoMeta = [
  { img: '/images/yishama-hero-david.webp', icon: 'lucide:circle-dot', href: '/yishama', accent: 'text-copper', ring: 'border-copper/30', chip: 'bg-copper/10 text-copper' },
  { img: '/images/neotone-hero-david.webp', icon: 'lucide:audio-waveform', href: '/le-neotone', accent: 'text-rust', ring: 'border-rust/30', chip: 'bg-rust/10 text-rust' },
]
---

<Layout title={h.title} description={h.description} ldJSON={[personLdJson(), websiteLdJson(), ...videoLdJson(homeVideos.map((id, i) => ({ id, name: h.proofVideos[i] })))]}>
  <section class="relative overflow-hidden bg-ink text-cream">
    <!-- Photo de David + handpan, pleinement visible à droite -->
    <div class="absolute inset-0">
      <img src="/images/hero-david.webp" width="2400" height="1351" alt="" class="h-full w-full object-cover object-[75%_center]" loading="eager" fetchpriority="high" />
      <!-- Dégradé horizontal : zone opaque à gauche (texte lisible), image révélée à droite -->
      <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-transparent md:via-ink/70 md:to-ink/0"></div>
      <!-- Renfort vertical léger pour mobile -->
      <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-transparent to-transparent md:hidden"></div>
    </div>
    <!-- Filet arc-en-ciel ChromaKeys : « rendre la musique visible » -->
    <div class="chroma-bar absolute inset-x-0 top-0 h-1"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-24 lg:px-8 lg:py-36">
      <div class="max-w-xl text-center md:text-left">
        <p class="inline-flex items-center gap-2 rounded-full border border-cream/20 bg-cream/5 px-4 py-1.5 text-xs font-600 uppercase tracking-[0.2em] text-gold">{h.heroEyebrow}</p>
        <h1 class="mt-6 font-display text-4xl font-700 leading-[1.05] md:text-6xl">{h.heroTitleA} <span class="text-gradient-brand">{h.heroTitleHighlight}</span> {h.heroTitleB}</h1>
        <p class="mt-6 text-lg text-cream/85 md:text-xl" set:html={heroLeadHtml}></p>
        <div class="mt-9 flex flex-wrap justify-center gap-3 md:justify-start">
          <Button href={L('/showroom')} variant="primary">{h.ctaShowroom}</Button>
          <Button href={L('/handpan-compagnon')} variant="light">{h.ctaMethod}</Button>
        </div>
        <div class="chroma-bar mx-auto mt-12 h-1.5 w-48 rounded-full md:mx-0"></div>
      </div>
    </div>
  </section>

  <div class="border-b border-ink/10 bg-cream-deep">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-3 px-4 py-5 text-sm font-600 text-ink-soft lg:px-8">
      {t.common.credentials.map((c) => (
        <span class="inline-flex items-center gap-2"><Icon name="lucide:badge-check" class="h-4 w-4 text-copper" /> {c}</span>
      ))}
    </div>
  </div>

  <Section>
    <SectionHeading eyebrow={h.universEyebrow} title={h.universHeading} intro={h.universIntro} />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {h.univers.map((u, i) => (
        <a href={href(universMeta[i].href)} class="group flex flex-col overflow-hidden rounded-card border border-ink/10 bg-cream-deep/40 transition-all hover:-translate-y-1 hover:shadow-xl">
          <div class="aspect-video overflow-hidden bg-ink/5">
            {universMeta[i].fit === 'split' ? (
              <div class="flex h-full w-full">
                <img src={universMeta[i].img} width={universMeta[i].w} height={universMeta[i].h} alt="" class="h-full w-1/2 object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                <span class="w-px shrink-0 bg-gold/70" aria-hidden="true"></span>
                <img src={universMeta[i].img2} width={universMeta[i].w} height={universMeta[i].h} alt={u.title} class="h-full w-1/2 object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              </div>
            ) : (
            <img src={universMeta[i].img} width={universMeta[i].w} height={universMeta[i].h} alt={u.title} class:list={['h-full w-full transition-transform duration-500 group-hover:scale-105', universMeta[i].fit === 'contain' ? 'object-contain p-5' : universMeta[i].fit === 'cover-top' ? 'object-cover object-top' : 'object-cover']} loading="lazy" />
            )}
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center gap-2 text-copper"><Icon name={universMeta[i].icon} class="h-5 w-5" /><span class="text-xs font-700 uppercase tracking-widest">{u.sub}</span></div>
            <h3 class="mt-2 font-display text-2xl font-700">{u.title}</h3>
            <p class="mt-2 flex-1 text-ink-soft/85">{u.text}</p>
            <span class="mt-4 inline-flex items-center gap-1 font-700 text-rust transition-all group-hover:gap-2">{u.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </Section>

  {/* ⚖️ « Le monde du ET » — acoustique ET électronique, à poids strictement
      égal : même image (même séance photo), même gabarit de carte, même
      nombre de puces, CTA jumeaux. Ne JAMAIS agrandir, avancer ou enrichir
      un côté plus que l'autre : c'est le fond du propos (complétion, pas
      compétition). Le bandeau final est le trait d'union réel — l'app, avec
      son mode acoustique, son mode électronique, « 🎯 Compléter » et Hybride. */}
  <Section id="instruments" tone="cream-deep">
    <div class="text-center">
      <p class="text-xs font-700 uppercase tracking-[0.2em] text-copper">{h.duoEyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-700 leading-tight md:text-4xl">
        {h.duoTitleA} <span class="text-gradient-brand">{h.duoTitleAnd}</span> {h.duoTitleB}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-soft/85">{h.duoIntro}</p>
      <div class="chroma-bar mx-auto mt-6 h-1 w-32 rounded-full"></div>
    </div>

    <div class="mt-12 grid items-stretch gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-4">
      {h.duo.map((d, i) => (
        <Fragment>
          {i === 1 && (
            <div class="flex items-center justify-center md:flex-col" aria-hidden="true">
              <span class="h-px flex-1 bg-ink/15 md:h-full md:w-px md:flex-1"></span>
              <span class="mx-4 my-0 grid h-12 w-12 shrink-0 place-items-center rounded-full border border-gold/50 bg-cream font-display text-sm font-700 uppercase tracking-widest text-copper shadow-sm md:mx-0 md:my-4">{h.duoTitleAnd}</span>
              <span class="h-px flex-1 bg-ink/15 md:h-full md:w-px md:flex-1"></span>
            </div>
          )}
          <a href={L(duoMeta[i].href)} class:list={['group flex flex-col overflow-hidden rounded-card border bg-cream transition-all hover:-translate-y-1 hover:shadow-xl', duoMeta[i].ring]}>
            <div class="aspect-[3/2] overflow-hidden bg-ink/5">
              <img src={duoMeta[i].img} width="1800" height="1200" alt={d.alt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-6 md:p-8">
              <p class:list={['inline-flex w-fit items-center gap-2 rounded-full px-3 py-1 text-[11px] font-700 uppercase tracking-widest', duoMeta[i].chip]}>
                <Icon name={duoMeta[i].icon} class="h-4 w-4" /> {d.sub}
              </p>
              <h3 class="mt-4 font-display text-2xl font-700">{d.title}</h3>
              <p class="mt-3 text-ink-soft/85">{d.text}</p>
              <ul class="mt-5 space-y-2 text-sm text-ink-soft/85">
                {d.points.map((p) => (
                  <li class="flex gap-2"><Icon name="lucide:check" class:list={['mt-0.5 h-4 w-4 shrink-0', duoMeta[i].accent]} /> {p}</li>
                ))}
              </ul>
              <span class:list={['mt-6 inline-flex items-center gap-1 font-700 transition-all group-hover:gap-2', duoMeta[i].accent]}>{d.cta} →</span>
            </div>
          </a>
        </Fragment>
      ))}
    </div>

    <div class="mt-10 rounded-card border border-gold/40 bg-cream p-6 text-center md:p-8">
      <p class="text-xs font-700 uppercase tracking-[0.2em] text-copper">{h.duoBridgeEyebrow}</p>
      <h3 class="mt-3 font-display text-2xl font-700">{h.duoBridgeTitle}</h3>
      <p class="mx-auto mt-4 max-w-3xl text-ink-soft/85">{h.duoBridgeText}</p>
      <div class="mt-6"><Button href={L('/handpan-compagnon')} variant="primary">{h.duoBridgeCta}</Button></div>
    </div>
  </Section>

  <Section>
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="aspect-[4/3] overflow-hidden rounded-card"><img src="/images/hero-david.jpg" width="2400" height="1350" alt="David Lesage" class="h-full w-full object-cover object-top" loading="lazy" /></div>
      <div>
        <SectionHeading align="left" eyebrow={h.whyEyebrow} title={h.whyTitle} />
        <div class="mt-5 space-y-4 text-lg text-ink-soft/90"><p>{h.whyP1}</p><p>{h.whyP2}</p></div>
        <div class="mt-7"><Button href={L('/a-propos')} variant="ghost">{h.whyCta}</Button></div>
      </div>
    </div>
  </Section>

  <Section tone="ink">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-rust/20 px-4 py-1.5 text-xs font-700 uppercase tracking-widest text-gold">{h.showroomBadge}</p>
        <h2 class="mt-5 font-display text-3xl font-700 leading-tight md:text-4xl">{h.showroomTitle}</h2>
        <p class="mt-5 text-lg text-cream/80">{h.showroomText}</p>
        <ul class="mt-6 space-y-3 text-cream/90">
          {h.showroomArgs.map((a) => <li class="flex gap-3"><Icon name="lucide:check" class="mt-1 h-5 w-5 shrink-0 text-gold" /> {a}</li>)}
        </ul>

        {/* Dates réelles des prochains showcases. Sans elles, la section promettait
            un événement sans jamais dire quand — le visiteur devait changer de page. */}
        <div data-home-agenda class="mt-8 rounded-card border border-gold/30 bg-cream/5 p-5">
          <p class="flex items-center gap-2 text-xs font-700 uppercase tracking-widest text-gold">
            <Icon name="lucide:calendar-days" class="h-4 w-4" />
            {h.showroomDatesTitle}
          </p>
          <ul data-home-agenda-list class="mt-4 space-y-2">
            {showcases.map((e) => (
              <li data-event-iso={e.iso} class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-cream/10 pb-2 last:border-0 last:pb-0">
                <span class="font-600 text-cream first-letter:uppercase">{e.short}</span>
                <span class="text-sm text-cream/70">{e.start} – {e.end}</span>
              </li>
            ))}
          </ul>
          <p data-home-agenda-empty class:list={['text-sm text-cream/70', showcases.length > 0 && 'hidden']}>
            {h.showroomDatesEmpty}
          </p>
          {showcases.length > 0 && (
            <p class="mt-3 text-xs text-cream/60">{h.showroomDatesNote}</p>
          )}
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={L('/showroom')} variant="primary">{h.showroomCta1}</Button>
          <Button href={L('/showroom') + '#agenda'} variant="light">{h.showroomCta2}</Button>
        </div>
      </div>
      <div class="aspect-video overflow-hidden rounded-card">
        <video class="h-full w-full object-cover" autoplay muted loop playsinline poster="/images/localisation-showroom-poster.webp"><source src="/images/localisation-showroom.mp4" type="video/mp4" /></video>
      </div>
    </div>
  </Section>

  <Section id="communaute">
    <div class="rounded-card border border-ink/10 bg-cream-deep/50 p-8 text-center md:p-14">
      <SectionHeading eyebrow={h.communityEyebrow} title={h.communityTitle} intro={h.communityIntro} />
      <div class="mt-8 flex flex-col items-center gap-3">
        {/* ⚠️ NE PAS remettre un `mailto:` ici. Ce bouton ouvrait le logiciel de
            mail du visiteur (`newsletterMailto`) : la demande n'existait alors que
            dans la boîte de David, jamais en base. Au moins une personne réelle a
            écrit avec l'objet pré-rempli de ce bouton sans jamais apparaître dans
            `site_leads` (16/08/2026). Il passe désormais par le formulaire
            `BookingForm` → Edge Function `site-lead` → table `site_leads`. */}
        <a href={newsletterMailto(lang)} data-booking="showcase-waitlist" data-title={t.booking.newsTitle} data-intro={t.booking.newsIntro} class="rounded-full bg-rust px-8 py-4 font-700 text-cream shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-copper">{h.communityButton}</a>
        <p class="text-sm text-ink-soft/70">{h.communityNote}</p>
      </div>
    </div>
  </Section>

  <Section tone="cream-deep">
    <SectionHeading eyebrow={h.proofEyebrow} title={h.proofTitle} intro={h.proofIntro} />
    <div class="mx-auto mt-10 grid max-w-5xl gap-5 md:grid-cols-3">
      {homeVideos.map((id, i) => (
        <figure class="m-0">
          <YouTube id={id} title={h.proofVideos[i]} />
          <figcaption class="mt-3 text-sm font-600 text-ink-soft/85">{h.proofVideos[i]}</figcaption>
        </figure>
      ))}
    </div>
    {/* Deux playlists, deux boutons identiques : le son acoustique et le son
        électronique s'ouvrent de la même façon, sans hiérarchie. */}
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <button type="button" data-video-list={yishamaPlaylist} data-video-title={h.proofCtaYishama} class="inline-flex items-center justify-center gap-2 rounded-full border border-ink/20 px-6 py-3 text-sm font-700 text-ink transition-all duration-200 hover:-translate-y-0.5 hover:bg-ink/5">{h.proofCtaYishama}</button>
      <button type="button" data-video-list={playlistId} data-video-title={h.proofCta} class="inline-flex items-center justify-center gap-2 rounded-full border border-ink/20 px-6 py-3 text-sm font-700 text-ink transition-all duration-200 hover:-translate-y-0.5 hover:bg-ink/5">{h.proofCta}</button>
    </div>
  </Section>
  <VideoModal />
  {/* Formulaire d'inscription aux showcases (section #communaute). */}
  <BookingForm lang={lang} />
</Layout>

<script>
  // Filet de sécurité (même logique que la page showroom) : la page est statique,
  // donc une date déjà passée pourrait rester affichée si le site n'a pas été
  // rebuildé depuis. On la retire, et on bascule sur le message d'attente s'il
  // ne reste plus rien.
  const today = new Date().toISOString().slice(0, 10)
  const list = document.querySelector('[data-home-agenda-list]')
  const empty = document.querySelector('[data-home-agenda-empty]')

  list?.querySelectorAll<HTMLElement>('[data-event-iso]').forEach((row) => {
    if ((row.dataset.eventIso || '') < today) row.remove()
  })

  if (!list?.querySelectorAll('[data-event-iso]').length) {
    empty?.classList.remove('hidden')
  }
</script>
