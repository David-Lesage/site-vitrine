---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Button from '@/components/Button.astro'
import BookingForm from '@/components/BookingForm.astro'
import Lightbox from '@/components/Lightbox.astro'
import { Icon } from 'astro-icon/components'
import { site } from '@/data/site'
import { getDict } from '@/i18n/dict'
import { localizePath } from '@/i18n/utils'
import { courseLdJson, breadcrumbLdJson, faqLdJson } from '@/lib/ldJson'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const l = t.lessons
const L = (p: string) => localizePath(p, lang)
const pillarIcons = ['lucide:eye', 'lucide:brain', 'lucide:music']
const formulaIcons = ['lucide:user', 'lucide:user', 'lucide:users']
// Trois univers d'apprentissage (indexé sur l.universes)
const universeMeta = [
  { img: '/images/constel-mains.webp', icon: 'lucide:disc-3', href: L('/handpan-app') },
  { img: '/images/prod-nowgroove.jpg', icon: 'lucide:drum', href: L('/boutique') + '#formations' },
  { img: '/images/prod-gonilele-4.jpg', icon: 'lucide:music-2', href: L('/gonilele') },
]
const workshopsUrl = 'https://sites.google.com/lesagedavid.fr/now-groove/ateliers'
const schoolEmail = 'School@lesagedavid.fr'
---

<Layout title={l.title} description={l.description} image="/images/og-david.jpg" ldJSON={[courseLdJson({ name: l.heroTitle, description: l.description, url: '/cours' }), breadcrumbLdJson([{ name: t.common.nav.home, url: L('/') }, { name: t.common.nav.lessons, url: L('/cours') }]), faqLdJson(l.faq)]}>
  <!-- Bandeau Now Music Academy -->
  <section class="relative overflow-hidden bg-ink text-cream">
    <div class="absolute inset-0">
      <img src="/images/hero-david.webp" width="2400" height="1351" alt="" class="h-full w-full object-cover object-[72%_22%]" loading="eager" />
      {/* 🚨 `veil-hero-x-soft` (global.css) et non `bg-gradient-to-r` : le dégradé
          Tailwind v4 disparaît en silence sur les moteurs qui ignorent « in oklab »
          ou @property, et le titre crème se retrouve nu sur la photo. */}
      <div class="veil-hero-x-soft absolute inset-0"></div>
    </div>
    <div class="chroma-bar absolute inset-x-0 top-0 h-1"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 lg:px-8 lg:py-28">
      <div class="max-w-xl">
        <p class="text-xs font-700 uppercase tracking-[0.25em] text-gold">{l.heroEyebrow}</p>
        <h1 class="mt-4 font-display text-4xl font-700 leading-tight md:text-6xl">{l.heroTitle}</h1>
        <p class="mt-5 text-lg text-cream/85">{l.heroLead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#formules" variant="primary">{l.ctaBook}</Button>
          <Button href="#ateliers" variant="light">{l.ctaWorkshop}</Button>
        </div>
      </div>
    </div>
  </section>

  <Section>
    <SectionHeading eyebrow={l.universesEyebrow} title={l.universesTitle} />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {l.universes.map((u, i) => (
        <a href={universeMeta[i].href} class="group flex flex-col overflow-hidden rounded-card border border-ink/10 bg-cream-deep/40 transition-shadow hover:shadow-md">
          <div class="aspect-[4/3] overflow-hidden"><img src={universeMeta[i].img} width="800" height="600" alt={u.t} class="h-full w-full object-cover transition-transform group-hover:scale-105" loading="lazy" /></div>
          <div class="flex flex-1 flex-col p-6">
            <Icon name={universeMeta[i].icon} class="h-7 w-7 text-copper" />
            <h3 class="mt-3 font-display text-xl font-700">{u.t}</h3>
            <p class="mt-2 flex-1 text-ink-soft/85">{u.d}</p>
            <span class="mt-4 inline-flex items-center gap-1 font-700 text-rust group-hover:underline">{u.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </Section>

  <Section tone="cream-deep">
    <SectionHeading eyebrow={l.promiseEyebrow} title={l.promiseTitle} intro={l.promiseIntro} />
    {/* 📷 27/08/2026 — LA PREUVE DE LA PROMESSE, POSÉE JUSTE APRÈS ELLE.
        `promiseIntro` dit « J'utilise Handpan Constellation Studio en cours » ;
        la section ne montrait que trois cartes de texte. La photo arrive donc
        AVANT les trois piliers : on affirme, on prouve, puis on explique.
        C'est la seule photo du site d'un COURS RÉEL — la main d'un ÉLÈVE sur le
        Neotone, l'app ouverte en mode Logique avec l'explication d'un degré.
        ⚠️ Photo quasi carrée (1800×1930) : `max-w-2xl` l'empêche d'écraser la
        section. Aucun recadrage — le nom « Handpan Constellation Studio » est
        lisible à l'écran, c'est ce qui l'empêche de vieillir. */}
    <figure class="mx-auto mt-10 max-w-2xl">
      <img src="/images/app-cours-mode-logique.webp" width="1800" height="1930" alt={l.methodPhotoAlt} data-lb="cours-methode" class="w-full rounded-card border border-ink/10 shadow-lg" loading="lazy" />
      <figcaption class="mt-3 text-center text-sm text-ink-soft/70">{l.methodPhotoCaption}</figcaption>
    </figure>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {l.pillars.map((c, i) => (
        <div class="rounded-card border border-ink/10 bg-cream p-6"><Icon name={pillarIcons[i]} class="h-7 w-7 text-copper" /><h3 class="mt-3 font-display text-xl font-700">{c.t}</h3><p class="mt-2 text-ink-soft/85">{c.d}</p></div>
      ))}
    </div>
  </Section>

  <Section id="formules">
    <SectionHeading eyebrow={l.formulasEyebrow} title={l.formulasTitle} />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {l.formulas.map((f, i) => (
        <div class="flex flex-col rounded-card border border-ink/10 bg-cream-deep/40 p-6"><Icon name={formulaIcons[i]} class="h-7 w-7 text-copper" /><h3 class="mt-3 font-display text-xl font-700">{f.title}</h3><p class="mt-2 flex-1 text-ink-soft/85">{f.text}</p><p class="mt-4 font-display text-2xl font-700 text-rust">{f.price}</p></div>
      ))}
    </div>
    <div class="mt-10 text-center">
      {/* Réservation d'un cours : ENREGISTRÉE en base (source `private-session`),
          plus un simple `mailto:`. L'ancien lien ouvrait le logiciel de mail du
          visiteur — David recevait peut-être l'email, mais aucune demande de cours
          n'était tracée, ni relançable, ni exportable. */}
      <Button href={`mailto:${site.email}?subject=Reservation%20cours`} data-booking="private-session" data-title={t.booking.privateTitle} data-intro={t.booking.privateIntro} variant="primary">{l.ctaBook}</Button>
      <p class="mt-3 text-sm text-ink-soft/70">{l.footnote}</p>
    </div>
  </Section>

  <Section tone="ink" id="ateliers">
    <SectionHeading tone="light" eyebrow={l.workshopsEyebrow} title={l.workshopsTitle} intro={l.workshopsIntro} />
    <div class="mx-auto mt-8 max-w-2xl rounded-card border border-cream/10 bg-cream/5 p-8 text-center">
      <Icon name="lucide:calendar-clock" class="mx-auto h-10 w-10 text-gold" />
      <p class="mt-4 text-lg font-600 text-cream/90">{l.workshopsEmpty}</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={workshopsUrl} external variant="primary">{l.workshopsCta}</Button>
        <Button href={`mailto:${schoolEmail}?subject=Atelier%20de%20rythme%20calebasse`} variant="light">{l.ctaBook}</Button>
      </div>
      <p class="mt-5 text-sm text-cream/60">{l.workshopsContact} <a href={`mailto:${schoolEmail}`} class="font-700 text-gold underline">{schoolEmail}</a></p>
    </div>
  </Section>

  <Section id="faq">
    <SectionHeading eyebrow={l.faqEyebrow} title={l.faqTitle} />
    <div class="mx-auto mt-10 max-w-3xl space-y-3">
      {l.faq.map((item) => (
        <details class="group rounded-card border border-ink/10 bg-cream-deep/40 p-5">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-lg font-600 marker:content-none">{item.q}<Icon name="lucide:chevron-down" class="h-5 w-5 shrink-0 text-copper transition-transform group-open:rotate-180" /></summary>
          <p class="mt-3 text-ink-soft/85">{item.a}</p>
        </details>
      ))}
    </div>
  </Section>
  {/* La photo du cours (data-lb="cours-methode") s'ouvre en plein écran. */}
  <Lightbox labels={{ close: l.lightbox.close, zoom: l.lightbox.zoom }} />

  {/* Réservation de cours (section #formules) — enregistre la demande en base. */}
  <BookingForm lang={lang} />
</Layout>
