---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Button from '@/components/Button.astro'
import VideoGrid from '@/components/VideoGrid.astro'
import PricingTable from '@/components/PricingTable.astro'
import BetaNotice from '@/components/BetaNotice.astro'
import AppAccessSync from '@/components/AppAccessSync.astro'
import { Icon } from 'astro-icon/components'
import YouTube from '@/components/YouTube.astro'
import { chromaKeys, studioVideos, studioAcousticDemoVideoId } from '@/data/site'
import { appCta } from '@/lib/appAccess'
import { getDict } from '@/i18n/dict'
import { localizePath } from '@/i18n/utils'
import { softwareAppLdJson, breadcrumbLdJson, faqLdJson, videoObjectsLocal } from '@/lib/ldJson'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const st = t.studio
// Bêta fermée : les boutons « ouvrir l'app » pointent vers l'encadré #acces
// (en bas de page). L'état réel est resynchronisé côté client par AppAccessSync
// à partir de l'interrupteur Supabase de l'application.
const heroCta = appCta(st.ctaOpen, t.common.beta.ctaWaitlist)
const acoCta = appCta(st.versionAcoCta, t.common.beta.ctaWaitlist)
const waitCta = appCta(st.waitButton, t.common.beta.ctaWaitlist)
const L = (p: string) => localizePath(p, lang)
const emotions = t.common.emotions
const modeImgs = [
  { img: '/images/app-logique.webp', w: 1100, h: 1327 },
  { img: '/images/app-atlas.webp', w: 1100, h: 1202 },
  { img: '/images/app-creation.webp', w: 1100, h: 1109 },
  { img: '/images/app-midi.webp', w: 1100, h: 1041 },
]
const constelImgs = [
  { img: '/images/constel-polygone-thumb.webp', w: 1047, h: 963 },
  { img: '/images/constel-ouvert-thumb.webp', w: 1045, h: 944 },
  { img: '/images/constel-mains-thumb.webp', w: 1020, h: 954 },
]
const videoObjects = videoObjectsLocal(
  st.videos.map((v, i) => ({ name: v.t, description: v.d, thumbnail: studioVideos[i].poster, contentUrl: studioVideos[i].src }))
)
const ld = [
  softwareAppLdJson(),
  breadcrumbLdJson([{ name: t.common.nav.home, url: L('/') }, { name: t.common.nav.studio, url: L('/handpan-app') }]),
  faqLdJson(st.faq),
  ...videoObjects,
]
---

<Layout title={st.title} description={st.description} image="/images/og-handpan-compagnon.jpg" ldJSON={ld}>
  <section class="relative overflow-hidden bg-ink text-cream">
    <div class="chroma-bar absolute inset-x-0 top-0 h-1.5"></div>
    <div class="mx-auto max-w-4xl px-4 py-24 text-center lg:py-28">
      <p class="text-xs font-700 uppercase tracking-[0.2em] text-gold">{st.heroEyebrow}</p>
      <h1 class="mt-5 font-display text-4xl font-700 leading-tight md:text-6xl">{st.heroTitleA}<br /><span class="text-gradient-brand">{st.heroTitleB}</span></h1>
      {/* 🚨 PASTILLES « SUR QUEL INSTRUMENT » — posées AVANT le chapô, à dessein.
          Retour terrain du 22/08/2026 : un prof de handpan acoustique s'est
          auto-exclu parce qu'il n'a pas vu que l'app marchait sur son
          instrument. Ces deux pastilles répondent avant même qu'on lise une
          phrase. L'acoustique est la première — l'ordre est le message. */}
      <ul class="mx-auto mt-6 flex max-w-xl flex-wrap justify-center gap-2 md:gap-3">
        {st.heroBadges.map((b, i) => (
          <li class:list={[
            'inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm font-700',
            i === 0 ? 'border-gold/50 bg-gold/15 text-gold' : 'border-cream/25 bg-cream/5 text-cream/85',
          ]}>
            <Icon name={i === 0 ? 'lucide:circle-dot' : 'lucide:audio-waveform'} class="h-4 w-4" />{b}
          </li>
        ))}
      </ul>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-cream/80">{st.heroLead}</p>
      <div class="mt-9"><Button {...heroCta.attrs} variant="primary">{heroCta.label}</Button></div>
      <p data-when="closed" class="mx-auto mt-4 max-w-xl text-sm text-cream/60">{t.common.beta.badge} · {t.common.beta.title}</p>
    </div>
  </section>

  {/* ══ « SUR QUEL HANDPAN ÇA MARCHE ? » — 2ᵉ BLOC DE LA PAGE ══════════════
      🚨 DÉPLACÉ ICI LE 22/08/2026 (retour terrain, pas une intuition).
         Ce bloc était la 7ᵉ section sur 13 : le mot « acoustique » n'était
         plus lisible entre la dernière ligne du chapô (535 px à 375 px) et
         6 638 px. Un ambassadeur Neotone, prof de handpan ACOUSTIQUE, a
         répondu à David qu'il n'était pas concerné. Il l'était.
      ⚖️ ÉQUILIBRE, PAS RENVERSEMENT : la carte Neotone reste dans le même
         bloc, juste en dessous — le Neotone garde ses fonctions propres
         (MIDI temps réel) et reste le fer de lance de l'écosystème.
      🎨 Le ton passe de `ink` à `cream-deep` : le hero est déjà `bg-ink`,
         deux blocs sombres collés se seraient fondus en un seul.
      🎬 L'emplacement vidéo « À venir » vit ICI, au plus près de l'argument
         acoustique — pas en bas de page. Une seule ligne à changer dans
         src/data/site.ts (`studioAcousticDemoVideoId`) pour le remplacer. */}
  <Section tone="cream-deep" id="acoustique">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-xs font-700 uppercase tracking-[0.2em] text-copper">{st.versionAcoEyebrow}</p>
        <h2 class="mt-4 font-display text-3xl font-700 leading-tight md:text-4xl">{st.versionAcoTitle}</h2>
        <p class="mt-4 text-ink-soft/85">{st.versionAcoText}</p>
        <ul class="mt-6 space-y-3">
          {st.versionAcoBullets.map((b) => (
            <li class="flex gap-3 text-ink-soft/90"><span class="mt-1 text-copper">✦</span><span>{b}</span></li>
          ))}
        </ul>
        <div class="mt-7"><Button {...acoCta.attrs} variant="primary">{acoCta.label}</Button></div>
        {/* Passerelle vers le récit d'origine : l'app est née de mes deux Yishama. */}
        <p class="mt-5">
          <a href={L('/yishama')} class="inline-flex items-center gap-1.5 text-sm font-700 text-copper underline underline-offset-4 hover:text-rust">
            {st.versionAcoYishamaLink} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      {/* 📷 LA PREUVE, pas une illustration : photo réelle du showroom, déjà
          dans le dépôt (galerie /showroom). Un handpan ACOUSTIQUE Yishama sur
          son trépied, l'app au-dessus. Cadrée en 3/4 depuis le haut : le
          recadrage ne coupe que le bas du trépied. */}
      <figure class="m-0">
        <img src="/images/showroom-handpan-tablette.webp" width="1100" height="1955" alt={st.versionAcoPhotoCaption} class="aspect-[3/4] w-full rounded-card border border-ink/10 object-cover object-top shadow-lg" loading="lazy" />
        <figcaption class="mt-3 text-center text-sm text-ink-soft/70">{st.versionAcoPhotoCaption}</figcaption>
      </figure>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-start">
      <figure class="m-0">
        <img src="/images/app-acoustique.jpg" width="1634" height="802" alt={st.versionAcoCaption} class="w-full rounded-card border border-ink/10 shadow-sm" loading="lazy" />
        <figcaption class="mt-3 text-sm text-ink-soft/70">{st.versionAcoCaption}</figcaption>
      </figure>
      <div id="demo-acoustique">
        <p class="text-xs font-700 uppercase tracking-[0.2em] text-copper">{st.demoVideoEyebrow}</p>
        <div class="mt-5">
          {studioAcousticDemoVideoId ? (
            <YouTube id={studioAcousticDemoVideoId} title={st.demoVideoTitle} />
          ) : (
            <div class="relative grid aspect-video w-full place-items-center rounded-card border-2 border-dashed border-ink/25 bg-ink/5 px-6 text-center">
              <div>
                <span class="mx-auto grid h-16 w-16 place-items-center rounded-full border border-ink/15 bg-cream">
                  <Icon name="lucide:video" class="h-7 w-7 text-copper" />
                </span>
                <p class="mt-5 font-display text-xl font-700 md:text-2xl">{st.demoVideoTitle}</p>
                <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-copper/15 px-4 py-1.5 text-xs font-700 uppercase tracking-widest text-copper">
                  <Icon name="lucide:clock" class="h-4 w-4" /> {st.demoVideoSoon}
                </p>
              </div>
            </div>
          )}
        </div>
        <p class="mt-4 text-sm text-ink-soft/75">{st.demoVideoNote}</p>
      </div>
    </div>

    {/* ⚖️ Le Neotone garde sa carte, dans le MÊME bloc : la page dit « les
        deux », pas « l'un contre l'autre ». */}
    <div class="mt-12 rounded-card border border-ink/10 bg-cream p-7">
      <h3 class="font-display text-2xl font-700">{st.versionNeoTitle}</h3>
      <p class="mt-3 max-w-2xl text-ink-soft/85">{st.versionNeoText}</p>
      <div class="mt-5"><Button href={L('/le-neotone')} variant="ghost">{st.versionNeoCta}</Button></div>
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow={st.problemEyebrow} title={st.problemTitle} />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-card border border-ink/10 bg-cream-deep/40 p-6"><span class="font-display text-3xl font-700 text-copper">01</span><h3 class="mt-2 font-display text-xl font-700">{st.problem1Title}</h3><p class="mt-2 text-ink-soft/85">{st.problem1Text}</p></div>
      <div class="rounded-card border border-ink/10 bg-cream-deep/40 p-6"><span class="font-display text-3xl font-700 text-copper">02</span><h3 class="mt-2 font-display text-xl font-700">{st.problem2Title}</h3><p class="mt-2 text-ink-soft/85">{st.problem2Text}</p></div>
    </div>
  </Section>

  <Section tone="ink">
    <SectionHeading tone="light" eyebrow={st.chromaEyebrow} title={st.chromaTitle} intro={st.chromaIntro} />
    <div class="mt-10 grid grid-cols-7 gap-2 md:gap-4">
      {chromaKeys.map((ck, i) => (
        <div class="rounded-xl p-3 text-center text-ink" style={`background:${ck.color}`}><p class="font-display text-xl font-700">{ck.degree}</p><p class="text-xs font-700">{emotions[i]}</p></div>
      ))}
    </div>
    <p class="mt-6 text-center font-display text-lg font-600 text-gold">{st.chromaPunch}</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <figure class="overflow-hidden rounded-card border border-cream/10"><img src="/images/invisible-visible.webp" width="1500" height="1107" alt={st.chromaTitle} class="w-full object-cover" loading="lazy" /></figure>
      <figure class="overflow-hidden rounded-card border border-cream/10"><img src="/images/constel-polygone.webp" width="1400" height="992" alt={st.constelTitle} class="w-full object-cover" loading="lazy" /></figure>
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow={st.constelEyebrow} title={st.constelTitle} intro={st.constelIntro} />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {st.constellations.map((co, i) => (
        <figure class="overflow-hidden rounded-card border border-ink/10 bg-cream-deep/40">
          <img src={constelImgs[i].img} width={constelImgs[i].w} height={constelImgs[i].h} alt={co.t} class="aspect-square w-full object-cover object-left" loading="lazy" />
          <figcaption class="p-5"><p class="font-display text-lg font-700">{co.t}</p><p class="mt-1 text-sm text-ink-soft/85">{co.d}</p></figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <Section tone="cream-deep">
    <SectionHeading eyebrow={st.degEyebrow} title={st.degTitle} intro={st.degIntro} />
    <div class="mx-auto mt-10 flex max-w-3xl flex-wrap justify-center gap-3">
      {chromaKeys.map((ck, i) => (
        <span class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-cream px-4 py-2 font-700"><span class="h-3 w-3 rounded-full" style={`background:${ck.color}`}></span>{ck.degree} · {emotions[i]}</span>
      ))}
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow={st.modesEyebrow} title={st.modesTitle} intro={st.modesIntro} />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {st.modes.map((m, i) => (
        <div class="flex gap-5 rounded-card border border-ink/10 bg-cream-deep/40 p-5"><img src={modeImgs[i].img} width={modeImgs[i].w} height={modeImgs[i].h} alt={m.t} class="h-24 w-24 shrink-0 rounded-xl object-cover" loading="lazy" /><div><h3 class="font-display text-xl font-700">{m.t}</h3><p class="mt-1 text-sm text-ink-soft/85">{m.d}</p></div></div>
      ))}
    </div>
  </Section>

  {/* 🎨 `cream-deep` depuis le 22/08/2026 : le bloc acoustique ayant quitté
      cette place, « modes » et « contrib » se retrouvaient collés à ce récit
      sur trois fonds identiques. Le respirateur revient ici. */}
  <Section tone="cream-deep">
    <div class="mx-auto max-w-3xl">
      <SectionHeading align="left" eyebrow={st.storyEyebrow} title={st.storyTitle} />
      <div class="mt-6 space-y-4 text-lg text-ink-soft/90"><p>{st.storyP1}</p><p>{st.storyP2}</p><p set:html={st.storyP3}></p></div>
    </div>
  </Section>

  <Section id="communaute-app">
    <SectionHeading eyebrow={st.contribEyebrow} title={st.contribTitle} intro={st.contribIntro} />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {st.contribCards.map((c, i) => (
        <div class="rounded-card border border-ink/10 bg-cream-deep/40 p-6">
          <Icon name={['lucide:rocket', 'lucide:message-circle-heart', 'lucide:users'][i]} class="h-8 w-8 text-copper" />
          <h3 class="mt-3 font-display text-xl font-700">{c.t}</h3>
          <p class="mt-2 text-ink-soft/85">{c.d}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="ink" id="videos">
    <SectionHeading tone="light" eyebrow={st.videosEyebrow} title={st.videosTitle} intro={st.videosIntro} />
    <div class="mt-10">
      <VideoGrid items={st.videos.map((v, i) => ({ ...v, src: studioVideos[i].src, poster: studioVideos[i].poster }))} />
    </div>
  </Section>

  <Section id="faq">
    <SectionHeading eyebrow={st.faqEyebrow} title={st.faqTitle} />
    <div class="mx-auto mt-10 max-w-3xl space-y-3">
      {st.faq.map((item) => (
        <details class="group rounded-card border border-ink/10 bg-cream-deep/40 p-5">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-lg font-600 marker:content-none">{item.q}<Icon name="lucide:chevron-down" class="h-5 w-5 shrink-0 text-copper transition-transform group-open:rotate-180" /></summary>
          <p class="mt-3 text-ink-soft/85">{item.a}</p>
        </details>
      ))}
    </div>
  </Section>

  {/* Les tarifs viennent APRÈS la FAQ : on montre le prix une fois que tout
      le contenu et toutes les réponses ont été vus. */}
  <Section tone="cream-deep" id="tarifs">
    <SectionHeading eyebrow={st.priceEyebrow} title={st.priceTitle} intro={st.priceIntro} />
    <div class="mt-12"><PricingTable lang={lang} /></div>
  </Section>

  {/* Visible uniquement quand l'app est ouverte au public (interrupteur Supabase). */}
  <Section id="liste-attente" data-when="open">
    <div class="mx-auto max-w-2xl rounded-card border border-ink/10 bg-cream p-8 text-center md:p-12">
      <Icon name="lucide:sparkles" class="mx-auto h-9 w-9 text-copper" />
      <h2 class="mt-4 font-display text-2xl font-700 md:text-3xl">{st.waitTitle}</h2>
      <p class="mt-3 text-ink-soft/85">{st.waitText}</p>
      <div class="mt-7"><Button {...waitCta.attrs} variant="primary">{waitCta.label}</Button></div>
    </div>
  </Section>

  {/* Bêta fermée : encadré d'explication + liste d'attente, en bas de page.
      L'ancre #acces (cible de tous les boutons) vit dans BetaNotice. */}
  <Section data-when="closed">
    <BetaNotice lang={lang} />
  </Section>

  <AppAccessSync />
</Layout>
