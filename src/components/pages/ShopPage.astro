---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Button from '@/components/Button.astro'
import Carousel from '@/components/Carousel.astro'
import Lightbox from '@/components/Lightbox.astro'
import VideoModal from '@/components/VideoModal.astro'
import { Icon } from 'astro-icon/components'
import ShopCard from '@/components/ShopCard.astro'
import { categoryIds, categorySubs, products } from '@/data/shop'
import { site } from '@/data/site'
import { getDict } from '@/i18n/dict'
import { localizePath } from '@/i18n/utils'
import { itemListLdJson, breadcrumbLdJson } from '@/lib/ldJson'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const s = t.shop
const L = (p: string) => localizePath(p, lang)
const snipcartKey = import.meta.env.PUBLIC_SNIPCART_KEY || ''
const eur = (n: number) => n.toLocaleString(lang === 'en' ? 'en-GB' : 'fr-FR') + ' €'
const productCopy = s.products as Record<string, { name: string; description: string }>
const categoryCopy = s.categories as Record<string, { label: string; blurb: string }>
const subCopy = s.subcategories as Record<string, { label: string; blurb: string; more: string }>
// ⚖️ Mêmes icônes/couleurs que l'accueil et le showroom : acoustique = cuivre
// (circle-dot), électronique = rouille (audio-waveform). Même poids visuel,
// même encart « en savoir plus » en bas de colonne (mt-auto) pour que les deux
// univers se terminent à la même hauteur malgré 1 produit d'un côté et 2 de l'autre.
const subMeta: Record<string, { icon: string; href: string; chip: string; pill: string; accent: string; ring: string }> = {
  acoustique: { icon: 'lucide:circle-dot', href: '/yishama', chip: 'bg-copper/10 text-copper', pill: 'border-copper/40 text-copper hover:bg-copper hover:text-cream', accent: 'text-copper', ring: 'border-copper/30' },
  electronique: { icon: 'lucide:audio-waveform', href: '/le-neotone', chip: 'bg-rust/10 text-rust', pill: 'border-rust/40 text-rust hover:bg-rust hover:text-cream', accent: 'text-rust', ring: 'border-rust/30' },
}
const linkTags = s.linkTags as Record<string, string>
const linkCtas = s.linkCtas as Record<string, string>
const priceNotes = s.priceNotes as Record<string, string>
// Extrait l'identifiant YouTube d'une URL (watch?v=…, youtu.be/…, /embed/…)
const ytId = (u: string) => (u.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{6,})/) || [])[1] || ''
const pName = (id: string) => productCopy[id]
const catInfo = (id: string) => categoryCopy[id]
const hrefFor = (p: (typeof products)[number]) => (p.url.startsWith('/') ? L(p.url) : p.url)
const isExternal = (p: (typeof products)[number]) => !(p.url.startsWith('/') || p.url.startsWith('mailto:'))

const ld = [
  itemListLdJson(products.filter((p) => p.active).map((p) => ({ name: pName(p.id).name, url: p.url, image: p.image }))),
  breadcrumbLdJson([{ name: t.common.nav.home, url: L('/') }, { name: s.eyebrow, url: L('/boutique') }]),
]
---

<Layout title={s.title} description={s.description} ldJSON={ld}>
  <Section tone="ink" class="!py-16">
    <SectionHeading level={1} tone="light" eyebrow={s.eyebrow} title={s.title2} intro={s.intro} />
    <p class="mx-auto mt-6 max-w-2xl text-center text-cream/75">{s.ambassadorText}</p>
  </Section>


  {categoryIds.map((catId) => {
    const cat = catInfo(catId)
    const items = products.filter((p) => p.category === catId && (p.active || p.mode === 'soon'))
    const subs = categorySubs[catId]
    return (
      <Section id={catId} tone={catId === 'creations' ? 'cream-deep' : 'cream'} class="!py-10 lg:!py-12">
        {catId === 'creations' && (
          <span class="mb-4 inline-flex items-center gap-2 rounded-full bg-copper/15 px-4 py-1.5 text-xs font-700 uppercase tracking-widest text-copper"><Icon name="lucide:sparkles" class="h-4 w-4" /> {s.creationsBadge}</span>
        )}
        <SectionHeading align="left" eyebrow={cat.label} title={cat.label} intro={cat.blurb} />

        {subs && (
          <Fragment>
            {/* ⚖️ Sous-menu « deux univers » — même langage que l'accueil
                (#instruments) et le showroom (#deux-univers) : deux colonnes de
                largeur identique séparées par le rond « ET ». Acoustique ET
                électronique, jamais l'un au-dessus de l'autre. */}
            <nav class="mt-6 flex flex-wrap items-center gap-2" aria-label={cat.label}>
              <span class="mr-1 text-xs font-700 uppercase tracking-widest text-ink-soft/60">{s.subNavLabel}</span>
              {subs.map((sub) => (
                <a
                  href={`#${catId}-${sub}`}
                  class:list={['inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-xs font-700 uppercase tracking-widest transition-colors', subMeta[sub].pill]}
                >
                  <Icon name={subMeta[sub].icon} class="h-4 w-4" /> {subCopy[sub].label}
                </a>
              ))}
            </nav>

            <div class="mt-8 grid items-stretch gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-4">
              {subs.map((sub, i) => (
                <Fragment>
                  {i === 1 && (
                    <div class="flex items-center justify-center md:flex-col" aria-hidden="true">
                      <span class="h-px flex-1 bg-ink/15 md:h-full md:w-px md:flex-1"></span>
                      <span class="mx-4 my-0 grid h-12 w-12 shrink-0 place-items-center rounded-full border border-gold/50 bg-cream font-display text-sm font-700 uppercase tracking-widest text-copper shadow-sm md:mx-0 md:my-4">{lang === 'en' ? 'and' : 'et'}</span>
                      <span class="h-px flex-1 bg-ink/15 md:h-full md:w-px md:flex-1"></span>
                    </div>
                  )}
                  <div id={`${catId}-${sub}`} class="flex h-full flex-col scroll-mt-28">
                    <p class:list={['inline-flex w-fit items-center gap-2 rounded-full px-3 py-1 text-[11px] font-700 uppercase tracking-widest', subMeta[sub].chip]}>
                      <Icon name={subMeta[sub].icon} class="h-4 w-4" /> {subCopy[sub].label}
                    </p>
                    <p class="mt-3 text-sm text-ink-soft/85">{subCopy[sub].blurb}</p>
                    <div class="mt-5 grid items-start gap-6">
                      {items.filter((p) => p.sub === sub).map((p) => <ShopCard lang={lang} product={p} />)}
                    </div>
                    <div class="mt-auto pt-6">
                      <a
                        href={L(subMeta[sub].href)}
                        class:list={['flex items-center gap-1 rounded-card border bg-cream px-5 py-4 text-sm font-700 transition-all hover:gap-2 hover:shadow-md', subMeta[sub].ring, subMeta[sub].accent]}
                      >{subCopy[sub].more}</a>
                    </div>
                  </div>
                </Fragment>
              ))}
            </div>

            <p class="mt-8 rounded-xl bg-gold/10 px-5 py-4 text-sm leading-relaxed text-ink-soft/85" set:html={s.handpanNote} />
            <p class="mt-4"><a href={L('/handpan-compagnon')} class="inline-flex items-center gap-1 font-700 text-copper transition-all hover:gap-2">{s.handpanBridge}</a></p>
          </Fragment>
        )}

        {!subs && (
          <div class="mt-8 grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((p) => <ShopCard lang={lang} product={p} />)}
          </div>
        )}
      </Section>
    )
  })}

  <Section tone="cream-deep">
    <div class="rounded-card border border-ink/10 bg-cream p-8 text-center">
      <Icon name="lucide:messages-square" class="mx-auto h-9 w-9 text-copper" />
      <h2 class="mt-4 font-display text-2xl font-700">{s.adviceTitle}</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-soft/85">{s.adviceText}</p>
      <div class="mt-6"><Button href={L('/contact')} variant="primary">{s.adviceCta}</Button></div>
    </div>
  </Section>

  <Lightbox />
  <VideoModal />
</Layout>

<script>
  // Bouton « copier le code » (ex. réduction OKO) — lit le code au clic pour
  // rester correct même si la carte est re-rendue entre-temps.
  document.querySelectorAll('.shop-copy-code').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') || ''
      const copyLabel = btn.getAttribute('data-copy-label') || ''
      const copiedLabel = btn.getAttribute('data-copied-label') || ''
      try {
        await navigator.clipboard.writeText(code)
        btn.textContent = copiedLabel
        window.setTimeout(() => { btn.textContent = copyLabel }, 1800)
      } catch {
        // Presse-papier indisponible (contexte non sécurisé…) : le code reste lisible dans la carte.
      }
    })
  })
</script>
