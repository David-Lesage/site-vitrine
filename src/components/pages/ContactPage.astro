---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import { Icon } from 'astro-icon/components'
import TermsCheckbox from '@/components/TermsCheckbox.astro'
import { site, SITE_LEAD_KNOWS_CONTACT_SOURCES } from '@/data/site'
import { getDict } from '@/i18n/dict'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const ct = t.contact
// Textes d'état (envoi / succès / erreur / confidentialité) réutilisés tels quels
// depuis le formulaire de réservation : même promesse, mêmes mots, zéro doublon.
const bk = t.booking
const coords = [
  { icon: 'lucide:mail', t: ct.coords.email, v: site.email, href: `mailto:${site.email}` },
  { icon: 'lucide:phone', t: ct.coords.phone, v: site.phone, href: `tel:${site.phoneHref}` },
  { icon: 'lucide:map-pin', t: ct.coords.showroom, v: site.address, href: site.mapsUrl },
]
---

<Layout title={ct.title} description={ct.description}>
  <Section tone="ink" class="!py-16">
    <SectionHeading level={1} tone="light" eyebrow={ct.eyebrow} title={ct.title2} intro={ct.intro} />
  </Section>

  <Section>
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <div class="space-y-4">
          {coords.map((c) => (
            <a href={c.href} class="flex items-center gap-4 rounded-card border border-ink/10 bg-cream-deep/40 p-5 transition-colors hover:bg-cream-deep"><Icon name={c.icon} class="h-7 w-7 text-copper" /><div><p class="text-sm font-700 uppercase tracking-wide text-ink-soft/60">{c.t}</p><p class="font-display text-lg font-700">{c.v}</p></div></a>
          ))}
        </div>
        <div class="mt-6 flex gap-3">
          <a href={site.social.instagram} class="rounded-full border border-ink/15 px-4 py-2 text-sm font-600 hover:bg-ink/5" target="_blank" rel="noopener">Instagram</a>
          <a href={site.social.facebook} class="rounded-full border border-ink/15 px-4 py-2 text-sm font-600 hover:bg-ink/5" target="_blank" rel="noopener">Facebook</a>
          <a href={site.social.youtube} class="rounded-full border border-ink/15 px-4 py-2 text-sm font-600 hover:bg-ink/5" target="_blank" rel="noopener">YouTube</a>
        </div>
      </div>

      <form
        id="contact-form"
        class="rounded-card border border-ink/10 bg-cream-deep/40 p-6 md:p-8"
        name="contact"
        data-to={site.email}
        data-lang={lang}
        data-capture={SITE_LEAD_KNOWS_CONTACT_SOURCES ? '1' : ''}
        data-sending={bk.sending}
        data-submit={ct.form.submit}
        novalidate
      >
        <div class="grid gap-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-600">{ct.form.name}</span><input type="text" name="name" required class="mt-1 w-full rounded-xl border border-ink/20 bg-cream px-4 py-3 focus:border-copper focus:outline-none" /></label>
            <label class="block"><span class="text-sm font-600">{ct.form.email}</span><input type="email" name="email" required class="mt-1 w-full rounded-xl border border-ink/20 bg-cream px-4 py-3 focus:border-copper focus:outline-none" /></label>
          </div>
          <label class="block"><span class="text-sm font-600">{ct.form.subject}</span>
            <select name="subject" class="mt-1 w-full rounded-xl border border-ink/20 bg-cream px-4 py-3 focus:border-copper focus:outline-none">
              {ct.subjects.map((su) => <option>{su}</option>)}
            </select>
          </label>
          <label class="block"><span class="text-sm font-600">{ct.form.message}</span><textarea name="message" rows="5" required class="mt-1 w-full rounded-xl border border-ink/20 bg-cream px-4 py-3 focus:border-copper focus:outline-none"></textarea></label>
          {/* Conditions générales — même case, mêmes mots que partout ailleurs. */}
          <TermsCheckbox lang={lang} />
          <button type="submit" class="rounded-full bg-rust px-6 py-3 font-700 text-cream transition-colors hover:bg-copper disabled:opacity-60">{ct.form.submit}</button>
          <p data-ct-error class="hidden text-sm font-600 text-rust">{bk.error}</p>
          <p class="text-xs text-ink-soft/60">{ct.form.note} {site.email}.</p>
          <p class="text-xs text-ink-soft/60">{bk.privacy}</p>
        </div>
      </form>

      {/* Confirmation affichée À LA PLACE du formulaire une fois le message
          enregistré. Avant le 16/08/2026, l'envoi ouvrait le logiciel de mail du
          visiteur et la page ne disait rien : impossible de savoir si le message
          était parti, et RIEN n'était enregistré côté David. */}
      <div data-ct-success class="hidden rounded-card border border-ink/10 bg-cream-deep/40 p-6 text-center md:p-8">
        <p class="font-display text-xl font-700 text-ink">{bk.successTitle}</p>
        <p class="mt-3 text-ink-soft/85">{bk.successText}</p>
      </div>
    </div>
  </Section>

  <script>
    // ENREGISTREMENT DU MESSAGE (16/08/2026) — remplace l'ancien `mailto:`.
    //
    // Avant : à l'envoi, on ouvrait le logiciel de mail du visiteur avec un
    // message pré-rédigé. Le message n'existait donc QUE dans la boîte de David :
    // rien en base, rien de relançable, rien d'exportable — et si la personne
    // n'avait pas de client mail configuré (webmail, mobile), rien du tout.
    //
    // Maintenant : POST vers /api/subscribe (fonction Vercel) → Edge Function
    // `site-lead` → table `site_leads`, source `contact`. David reçoit toujours
    // une notification par email, et la personne un accusé de réception.
    //
    // REPLI : si l'appel échoue (réseau, API down), on retombe sur le `mailto:`
    // d'origine — le message part quand même. Jamais de cul-de-sac.
    const form = document.getElementById('contact-form') as HTMLFormElement | null
    const successEl = document.querySelector('[data-ct-success]') as HTMLElement | null
    const errorEl = form?.querySelector('[data-ct-error]') as HTMLElement | null

    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!form.reportValidity()) return
      const data = new FormData(form)
      const get = (k: string) => String(data.get(k) || '').trim()
      const to = form.dataset.to || ''
      const subject = `${get('subject')} — ${get('name')}`
      const body = [get('message'), '', '—', get('name'), get('email')].join('\n')
      const mailtoHref = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`

      // Le formulaire ne demande qu'un champ « Nom & prénom » : on ne coupe qu'au
      // PREMIER espace, le reste part en nom de famille (« Jean-Pierre De La Tour »
      // ne doit pas être tronqué). Un nom en un seul mot reste un prénom seul.
      const parts = get('name').split(/\s+/).filter(Boolean)

      // Tant que l'Edge Function ne connaît pas la source `contact`, on garde le
      // comportement d'avant AU MOT PRÈS (ouverture du logiciel de mail) : mieux
      // vaut l'ancien chemin qu'un accusé de réception qui raconterait n'importe
      // quoi à la personne. Voir SITE_LEAD_KNOWS_CONTACT_SOURCES (src/data/site.ts).
      if (!form.dataset.capture) { window.location.href = mailtoHref; return }

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      const label = btn?.textContent || form.dataset.submit || ''
      if (btn) { btn.disabled = true; btn.textContent = form.dataset.sending || label }
      errorEl?.classList.add('hidden')

      try {
        const r = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: get('email'),
            firstName: parts[0] || '',
            lastName: parts.slice(1).join(' '),
            // `site_leads` n'a pas de colonne « sujet » : on le met en tête du
            // message, ce qui le rend visible dans la notification ET dans les
            // exports, sans migration de schéma.
            message: [`[${get('subject')}]`, get('message')].filter(Boolean).join(' '),
            // Case obligatoire des conditions générales (bloquée en amont par
            // `reportValidity()`) : le serveur en fait l'horodatage opposable.
            termsAccepted: data.get('termsAccepted') !== null,
            source: 'contact',
            lang: form.dataset.lang || 'fr',
            page: location.pathname,
          }),
        })
        if (!r.ok) throw new Error('upstream')
        form.classList.add('hidden')
        successEl?.classList.remove('hidden')
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = label }
        errorEl?.classList.remove('hidden')
        window.location.href = mailtoHref
      }
    })
  </script>
</Layout>
