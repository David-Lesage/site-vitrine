---
// Formulaire de réservation / demande de contact.
// Remplace les anciens liens mailto : la demande est ENREGISTRÉE dans Supabase
// (table site_leads) avec sa raison (`source`), puis David reçoit une notification
// et la personne un accusé de réception.
//
// S'ouvre en modale au clic sur n'importe quel élément [data-booking="<source>"].
// Inclure UNE fois par page contenant de tels boutons.
import { getDict } from '@/i18n/dict'
import TermsCheckbox from '@/components/TermsCheckbox.astro'
import NewsCheckbox from '@/components/NewsCheckbox.astro'
import { durationLabel, priceLabel, priceGrid } from '@/lib/sessions'
import { sessionTypes, demoInstruments, showcaseInterests } from '@/data/site'
import { upcomingShowcases } from '@/lib/agenda'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const bk = getDict(lang).booking
// ── DEUX MENUS AU LIEU D'UN (18/08/2026, demande de David) ───────────────────
// Avant : UN menu « Quel rendez-vous ? » qui mélangeait le motif ET la durée
// (« Cours ou accompagnement individuel — 1h30 · 70 € »), soit 6 lignes.
// Maintenant, ses mots : « Garder le formulaire avec le menu déroulant "Quel
// rendez-vous souhaites-tu ?", le simplifier : 1 - Prendre un cours avec David.
// 2 - Démo privée et tester un instrument. Puis le choix du ou des instruments.
// Puis la durée (1h ou 1h30). »
//
// 🔑 AUCUN NOUVEAU CHAMP, AUCUNE NOUVELLE COLONNE : l'identifiant envoyé au
// serveur reste `sessionType` = « <motif>-<durée> » (`lesson-90`, `demo-60`…),
// exactement ceux de `sessionTypes` et de l'allowlist `ALLOWED_SESSION_TYPE` de
// l'Edge Function. Il est simplement RECOMPOSÉ à l'envoi à partir des deux
// menus (voir le <script> en bas). La durée était donc déjà en base, sous
// `session_type` — rien à migrer.
//
// ⚠️ Le motif `onboarding` (« prise en main ») n'est PLUS proposé : c'est un
// accompagnement, il est rattaché aux COURS. Il reste dans `sessionTypes`
// (tarif de la carte « Prise en main de ton instrument » sur /showroom) et dans
// l'allowlist serveur (lignes déjà en base, pages encore en cache).
const KIND_ORDER = ['lesson', 'demo'] as const
const kinds = KIND_ORDER.map((k) => ({ id: k, label: bk.sessionTypeNames[k] }))
// Durées proposées + tarifs : déduits de `sessionTypes`, jamais recopiés — la
// modale ne peut pas annoncer un prix que le formulaire ne pratique pas.
const durations = [...new Map(sessionTypes.map((s) => [s.minutes, s.price])).entries()]
  .sort((a, b) => a[0] - b[0])
  .map(([minutes, price], i, all) => ({
    value: String(minutes),
    // ★ sur la plus longue : c'est celle que David conseille pour une prise en main.
    label: `${durationLabel(minutes)} · ${priceLabel(price)}${i === all.length - 1 && bk.sessionTypeRecommended ? ` ${bk.sessionTypeRecommended}` : ''}`,
  }))
// « 1h · 50 € — 1h30 · 70 € » : la grille annoncée en clair dans la modale.
const grid = priceGrid()
const slots = [1, 2, 3]
// Motifs acceptant la visio (les cours) — lu par le script. On raisonne
// désormais par MOTIF et non par identifiant complet : la durée n'a aucune
// influence sur le fait qu'une séance puisse se tenir à distance.
const remoteKinds = [...new Set(sessionTypes.filter((s) => s.remote).map((s) => s.kind))].join(',')
// Dates de showcase à venir, transmises à l'Edge Function pour l'email de la
// LISTE D'ATTENTE (il les liste avec un lien d'inscription par date). Calculées
// depuis `agendaEvents` via `upcomingShowcases()` — exactement la même source
// que l'agenda affiché sur /showroom, donc l'email ne peut pas le contredire.
// ⚠ Filtrage « à venir » fait au BUILD (site statique) : l'Edge Function
// refiltre côté serveur, une page servie d'un cache ne peut pas produire un
// lien vers une date déjà passée.
const upcoming = JSON.stringify(
  upcomingShowcases(lang).map((e) => ({ date: e.iso, start: e.start, end: e.end })),
)
---

<div
  id="booking-modal"
  data-remote-kinds={remoteKinds}
  data-price-grid={grid}
  data-upcoming={upcoming}
  class="fixed inset-0 z-[100] hidden items-start justify-center overflow-y-auto bg-ink/80 p-4 py-10 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="relative w-full max-w-lg rounded-card bg-cream p-6 shadow-2xl md:p-8">
    <button class="bk-close absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-full text-2xl leading-none text-ink-soft hover:bg-ink/5" type="button" aria-label={bk.close}>×</button>

    <h2 class="pr-8 font-display text-2xl font-700" data-bk-title>{bk.defaultTitle}</h2>
    <p class="mt-2 text-sm text-ink-soft/85" data-bk-intro>{bk.defaultIntro}</p>

    {/* Rendez-vous individuel : ce qu'on peut venir y faire (n'importe quel
        instrument de la boutique, un micro, ou simplement un accompagnement)
        et le TARIF, écrits noir sur blanc avant de remplir quoi que ce soit.
        Le tarif vient de site.ts via `priceGrid()` : la modale ne peut pas
        annoncer un prix que le formulaire ne pratique pas. */}
    <div data-bk-vip class="mt-4 hidden rounded-xl border border-copper/25 bg-copper/5 p-4">
      <p class="text-sm font-700">{bk.vipTitle}</p>
      <p class="mt-1.5 text-xs leading-relaxed text-ink-soft/85">{bk.vipScope}</p>
      <div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="text-[11px] font-700 uppercase tracking-widest text-ink-soft/70">{bk.vipPriceLabel}</span>
        <span class="font-display text-lg font-700 text-rust">{grid}</span>
      </div>
      <p class="mt-1 text-xs text-ink-soft/70">{bk.vipPriceNote}</p>
    </div>

    <form id="booking-form" class="mt-5 grid gap-3" data-lang={lang} novalidate>
      <input type="hidden" name="source" value="showroom-visit" />
      <input type="hidden" name="eventDate" value="" />
      {/* Horaires de la séance de showcase choisie (issus de `agendaEvents`) :
          l'email de confirmation les annonce en clair, sans les recopier. */}
      <input type="hidden" name="eventStart" value="" />
      <input type="hidden" name="eventEnd" value="" />

      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-600">{bk.first}</span>
          <input type="text" name="firstName" autocomplete="given-name" required class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-sm font-600">{bk.last}</span>
          <input type="text" name="lastName" autocomplete="family-name" required class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none" />
        </label>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-600">{bk.email}</span>
          <input type="email" name="email" autocomplete="email" required class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none" />
        </label>
        <label class="block">
          <span class="text-sm font-600" data-bk-phone-label data-default={bk.phone} data-plain={bk.phonePlain}>{bk.phone}</span>
          <input type="tel" name="phone" autocomplete="tel" class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none" />
        </label>
      </div>

      <label class="block" data-bk-people>
        <span class="text-sm font-600">{bk.people}</span>
        <input type="number" name="peopleCount" min="1" max="20" value="1" class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none" />
      </label>

      {/* SHOWCASE UNIQUEMENT — « pour quel(s) instrument(s) viens-tu ? ».
          Choix multiples, aucun obligatoire : ça sert à David pour préparer la
          séance et pour cibler ses emails ensuite, pas à filtrer l'inscription.
          ⚠️ Champ et colonne DISTINCTS du fieldset `instruments` plus bas : ce
          dernier est ignoré côté serveur dès que `sessionType` est vide, ce qui
          est toujours le cas pour un showcase. Options : src/data/site.ts. */}
      <fieldset data-bk-showcase-interests class="rounded-xl border border-ink/15 bg-cream-deep/20 p-4">
        <legend class="px-1 text-sm font-600">{bk.showcaseInterestsLabel}</legend>
        <p class="text-xs text-ink-soft/70">{bk.showcaseInterestsHint}</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          {showcaseInterests.map((id) => (
            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg bg-cream px-3 py-2 text-sm">
              <input type="checkbox" name="showcaseInterests" value={id} class="h-4 w-4 shrink-0 accent-rust" />
              {bk.showcaseInterestNames[id]}
            </label>
          ))}
        </div>
      </fieldset>

      {/* MOTIF du rendez-vous — deux choix, ni plus ni moins (voir l'en-tête).
          ⚠️ Le champ s'appelle `sessionKind` : `sessionType` (motif + durée) est
          recomposé à l'envoi. Ne pas renommer sans lire le <script> en bas. */}
      <label class="block" data-bk-session>
        <span class="text-sm font-600">{bk.sessionType}</span>
        <select name="sessionKind" required class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none">
          <option value="">{bk.sessionTypeChoose}</option>
          {kinds.map((k) => <option value={k.id}>{k.label}</option>)}
        </select>
        <span class="mt-2 block rounded-lg bg-gold/10 px-3 py-2 text-xs leading-relaxed text-ink-soft/85">{bk.sessionTypeHint}</span>
      </label>

      {/* Demande de code de remise Neotone : modèle + pays de livraison, ce que
          Neotone réclame à David pour enregistrer la vente. */}
      <div data-bk-discount class="grid gap-3">
        <label class="block">
          <span class="text-sm font-600">{bk.discountModel}</span>
          <select name="neotoneModel" class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none">
            <option value="">{bk.discountModelChoose}</option>
            {(['one', 'mutant', 'undecided'] as const).map((id) => (
              <option value={id}>{bk.discountModelNames[id]}</option>
            ))}
          </select>
        </label>
        <label class="block">
          <span class="text-sm font-600">{bk.discountCountry}</span>
          <input type="text" name="country" autocomplete="country-name" placeholder={bk.discountCountryPlaceholder} class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none" />
        </label>
        <p class="text-xs text-ink-soft/70">{bk.discountNote}</p>

        <label class="block">
          <span class="text-sm font-600">{bk.socialLabel}</span>
          <span class="mt-0.5 block text-xs text-ink-soft/70">{bk.socialHint}</span>
          <input type="text" name="socialAccount" placeholder={bk.socialPlaceholder} class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none" />
        </label>

        <label class="block">
          <span class="text-sm font-600">{bk.discoveryLabel}</span>
          <select name="discoveryChannel" class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none">
            <option value="">{bk.discoveryChoose}</option>
            {(['youtube', 'instagram', 'facebook', 'showcase', 'word-of-mouth', 'search', 'neotone-site', 'other'] as const).map((id) => (
              <option value={id}>{bk.discoveryNames[id]}</option>
            ))}
          </select>
        </label>

        {/* Questions facultatives : créer du lien, pas filtrer. Aucune n'est `required`. */}
        <fieldset class="rounded-xl border border-ink/15 bg-cream-deep/20 p-4">
          <legend class="px-1 text-sm font-600">{bk.curiousTitle}</legend>
          <p class="text-xs text-ink-soft/70">{bk.curiousHint}</p>
          <label class="mt-3 block">
            <span class="text-xs font-600 text-ink-soft/80">{bk.playingSinceLabel}</span>
            <select name="playingSince" class="mt-1 w-full rounded-lg border border-ink/20 bg-cream px-3 py-2 text-sm focus:border-copper focus:outline-none">
              <option value="">{bk.playingSinceChoose}</option>
              {(['none', 'under-1', '1-3', 'over-3'] as const).map((id) => (
                <option value={id}>{bk.playingSinceNames[id]}</option>
              ))}
            </select>
          </label>
          <label class="mt-3 block">
            <span class="text-xs font-600 text-ink-soft/80">{bk.dreamLabel}</span>
            <input type="text" name="dream" placeholder={bk.dreamPlaceholder} class="mt-1 w-full rounded-lg border border-ink/20 bg-cream px-3 py-2 text-sm focus:border-copper focus:outline-none" />
          </label>
        </fieldset>

        {/* Ce qui se passe après l'envoi — annoncé AVANT, pour qu'il n'y ait
            aucune surprise : c'est Neotone qui reprend la main. */}
        <div class="rounded-xl border border-copper/25 bg-copper/5 p-4">
          <p class="text-sm font-700">{bk.discountNextTitle}</p>
          <ol class="mt-2 space-y-1.5 text-xs leading-relaxed text-ink-soft/85">
            <li class="flex gap-2"><span aria-hidden="true" class="text-copper">1.</span><span set:html={bk.discountNext1} /></li>
            <li class="flex gap-2"><span aria-hidden="true" class="text-copper">2.</span><span set:html={bk.discountNext2} /></li>
            <li class="flex gap-2"><span aria-hidden="true" class="text-copper">3.</span><span set:html={bk.discountNext3} /></li>
          </ol>
        </div>
      </div>

      {/* Cours seulement : une démonstration ne se fait pas en visio.
          ⚠️ Placé AVANT les instruments (18/08/2026) : pour un cours, la question
          des instruments à préparer ne se pose que si on se voit au showroom. */}
      <fieldset data-bk-format class="rounded-xl border border-ink/15 bg-cream-deep/20 p-4">
        <legend class="px-1 text-sm font-600">{bk.formatLabel}</legend>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          {[['in-person', bk.formatInPerson], ['remote', bk.formatRemote]].map(([v, label]) => (
            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg bg-cream px-3 py-2 text-sm">
              <input type="radio" name="sessionFormat" value={v} class="h-4 w-4 shrink-0 accent-rust" />
              {label}
            </label>
          ))}
        </div>
      </fieldset>

      {/* Quels instruments préparer. Posé pour les DEUX motifs depuis le
          18/08/2026 (« puis le choix du ou des instruments ») : on vient les
          TOUCHER, donc la question disparaît si la personne choisit la visio.
          ⚠️ Côté serveur, `instruments` n'est retenu que si `sessionType` est
          renseigné et que le format n'est pas « remote » — d'où le masquage. */}
      <fieldset data-bk-instruments class="rounded-xl border border-ink/15 bg-cream-deep/20 p-4">
        <legend class="px-1 text-sm font-600">{bk.instrumentsLabel}</legend>
        <p class="text-xs text-ink-soft/70">{bk.instrumentsHint}</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          {demoInstruments.map((id) => (
            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg bg-cream px-3 py-2 text-sm">
              <input type="checkbox" name="instruments" value={id} class="h-4 w-4 shrink-0 accent-rust" />
              {bk.instrumentNames[id]}
            </label>
          ))}
        </div>
      </fieldset>

      {/* DURÉE (18/08/2026) — 1h ou 1h30, avec son tarif. Dernière question du
          rendez-vous, comme David l'a décrite. Les valeurs sont des MINUTES :
          elles forment la seconde moitié de `sessionType` (`lesson-90`…). */}
      <div data-bk-duration class="rounded-xl border border-ink/15 bg-cream-deep/20 p-4">
        <label class="block">
          <span class="text-sm font-600">{bk.durationLabel}</span>
          <select name="sessionDuration" required class="mt-1 w-full rounded-lg border border-ink/20 bg-cream px-3 py-2.5 text-sm focus:border-copper focus:outline-none">
            <option value="">{bk.sessionTypeChoose}</option>
            {durations.map((d) => <option value={d.value}>{d.label}</option>)}
          </select>
        </label>
        <p class="mt-2 rounded-lg bg-gold/10 px-3 py-2 text-xs leading-relaxed text-ink-soft/85">{bk.durationHint}</p>
      </div>

      {/* Créneaux proposés par la personne : c'est elle qui propose, David valide. */}
      <fieldset data-bk-slots class="rounded-xl border border-ink/15 bg-cream-deep/20 p-4">
        <legend class="px-1 text-sm font-600">{bk.slotsTitle}</legend>
        <p class="text-xs text-ink-soft/70">{bk.slotsHint}</p>
        <div class="mt-3 space-y-2">
          {slots.map((n) => (
            <div class="grid grid-cols-[auto_1fr_auto] items-center gap-2 sm:grid-cols-[3.5rem_1fr_auto]">
              <span class="text-xs font-600 text-ink-soft/70">{bk.slotLabel.replace('{n}', String(n))}</span>
              <input type="date" name={`slotDate${n}`} aria-label={`${bk.slotLabel.replace('{n}', String(n))} — ${bk.slotDate}`} class="w-full rounded-lg border border-ink/20 bg-cream px-3 py-2 text-sm focus:border-copper focus:outline-none" />
              <input type="time" name={`slotTime${n}`} aria-label={`${bk.slotLabel.replace('{n}', String(n))} — ${bk.slotTime}`} class="rounded-lg border border-ink/20 bg-cream px-3 py-2 text-sm focus:border-copper focus:outline-none" />
            </div>
          ))}
        </div>
        <p data-bk-slots-error class="mt-2 hidden text-sm font-600 text-rust">{bk.slotsRequired}</p>
      </fieldset>

      {/* Conditions : annoncées avant l'envoi, et rappelées dans l'email d'accusé.
          Les points 3 et 4 posent le cadre d'annulation — dit clairement, et
          avec bienveillance : on a tous des imprévus. */}
      <div data-bk-terms class="rounded-xl border border-copper/25 bg-copper/5 p-4">
        <p class="text-sm font-700">{bk.termsTitle}</p>
        <ul class="mt-2 space-y-1.5 text-xs leading-relaxed text-ink-soft/85">
          <li class="flex gap-2"><span aria-hidden="true" class="text-copper">1.</span>{bk.terms1}</li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-copper">2.</span>{bk.terms2}</li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-copper">3.</span>{bk.terms3}</li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-copper">4.</span>{bk.terms4}</li>
        </ul>
      </div>

      <label class="block">
        <span class="text-sm font-600" data-bk-message-label data-default={bk.message} data-free={bk.freeMessageLabel}>{bk.message}</span>
        <span data-bk-message-hint class="mt-1 hidden block text-xs text-ink-soft/70">{bk.freeMessageHint}</span>
        <textarea name="message" rows="3" placeholder={bk.messagePlaceholder} class="mt-1 w-full rounded-xl border border-ink/20 bg-cream-deep/30 px-4 py-3 focus:border-copper focus:outline-none"></textarea>
      </label>

      {/* DROIT À L'IMAGE — photos ET vidéos (19/08/2026, demande de David).
          Trois réponses possibles, dont « oui mais visage flouté » : David
          photographie et filme ses showcases et en publie une partie sur le
          site ; sans cette question il floute tout par précaution et se prive
          des vraies photos de groupe.

          🔑 FORME RETENUE — TROIS BOUTONS RADIO, AUCUN `checked`, PAS DE
          `required`. Un consentement ne se présume jamais : une option
          pré-sélectionnée (ou un menu déroulant dont on ne voit pas les
          options) ferait passer un défaut pour une réponse. Les trois options
          sont visibles d'un coup d'œil, donc la personne DÉCOUVRE qu'elle peut
          demander le floutage — c'est précisément la demande de David.
          L'absence de réponse est traitée comme un REFUS, jamais comme un
          accord : c'est dit à la personne (`imageNone`), c'est ce que fait
          l'Edge Function (rien d'enregistré → `image_consent` NULL), et c'est
          écrit dans le COMMENT ON COLUMN de la base.

          ⚠️ Bloc masqué ET désactivé par `toggleBlock()` sur les motifs qui ne
          sont pas une venue physique : rien ne part alors dans l'envoi. Voir
          IMAGE_CONSENT_SOURCES dans le <script> en bas. */}
      <fieldset data-bk-image class="rounded-xl border border-ink/15 bg-cream-deep/20 p-4">
        <legend class="px-1 text-sm font-600">{bk.imageTitle}</legend>
        <p class="text-sm font-600 text-ink">
          {bk.imageQuestion}
          <span class="ml-1 whitespace-nowrap rounded-full bg-ink/10 px-2 py-0.5 text-[11px] font-600 uppercase tracking-wide text-ink-soft/80">{bk.imageOptional}</span>
        </p>
        <p class="mt-1 text-xs leading-relaxed text-ink-soft/75">{bk.imageWhy}</p>
        <div class="mt-3 grid gap-2">
          {[['yes', bk.imageYes], ['blurred', bk.imageBlurred], ['no', bk.imageNo]].map(([v, label]) => (
            <label class="flex cursor-pointer items-start gap-2.5 rounded-lg bg-cream px-3 py-2 text-sm">
              <input type="radio" name="imageConsent" value={v} class="mt-0.5 h-4 w-4 shrink-0 accent-rust" />
              {label}
            </label>
          ))}
        </div>
        <p class="mt-2 text-xs leading-relaxed text-ink-soft/75">{bk.imageNone}</p>
      </fieldset>

      {/* Conditions générales — case OBLIGATOIRE, identique sur tous les
          formulaires du site. Volontairement placée juste avant le bouton :
          c'est le dernier geste avant l'envoi. */}
      <TermsCheckbox lang={lang} class="mt-1" />

      {/* Nouveautés — case FACULTATIVE, jamais pré-cochée, juste sous la case
          obligatoire. Accepter les conditions générales ne vaut pas accord pour
          recevoir de la prospection : c'est CETTE case-là qui le dit, et elle
          ne bloque jamais l'envoi. */}
      <NewsCheckbox lang={lang} />

      <button type="submit" data-sending={bk.sending} class="mt-1 rounded-full bg-rust px-6 py-3.5 font-700 text-cream shadow-sm transition-colors hover:bg-copper disabled:opacity-60">{bk.submit}</button>
      <p data-bk-error class="hidden text-sm font-600 text-rust">{bk.error}</p>
      <p class="text-xs text-ink-soft/70">{bk.privacy}</p>
    </form>

    <div data-bk-success class="hidden py-6 text-center">
      <p class="font-display text-xl font-700 text-ink">{bk.successTitle}</p>
      <p class="mt-3 text-ink-soft/85">{bk.successText}</p>
      <button type="button" class="bk-close mt-6 rounded-full bg-rust px-6 py-3 font-700 text-cream hover:bg-copper">{bk.successClose}</button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('booking-modal')
  const form = document.getElementById('booking-form') as HTMLFormElement | null
  const success = modal?.querySelector('[data-bk-success]') as HTMLElement
  const titleEl = modal?.querySelector('[data-bk-title]') as HTMLElement
  const introEl = modal?.querySelector('[data-bk-intro]') as HTMLElement
  const peopleEl = modal?.querySelector('[data-bk-people]') as HTMLElement
  const sessionEl = modal?.querySelector('[data-bk-session]') as HTMLElement
  const slotsEl = modal?.querySelector('[data-bk-slots]') as HTMLElement
  const slotsErrEl = modal?.querySelector('[data-bk-slots-error]') as HTMLElement
  const termsEl = modal?.querySelector('[data-bk-terms]') as HTMLElement
  const vipEl = modal?.querySelector('[data-bk-vip]') as HTMLElement
  const discountEl = modal?.querySelector('[data-bk-discount]') as HTMLElement
  const instrumentsEl = modal?.querySelector('[data-bk-instruments]') as HTMLElement
  // Showcase uniquement — « pour quel(s) instrument(s) viens-tu ? » (17/08/2026)
  const showcaseInterestsEl = modal?.querySelector('[data-bk-showcase-interests]') as HTMLElement
  const formatEl = modal?.querySelector('[data-bk-format]') as HTMLElement
  // Durée du rendez-vous (18/08/2026) — bloc distinct du motif : c'est la
  // dernière question posée, après les instruments.
  const durationEl = modal?.querySelector('[data-bk-duration]') as HTMLElement
  // Droit à l'image — photos ET vidéos (19/08/2026).
  const imageEl = modal?.querySelector('[data-bk-image]') as HTMLElement
  const kindSelect = modal?.querySelector('select[name="sessionKind"]') as HTMLSelectElement | null

  // MOTIFS QUI POSENT LA QUESTION DU DROIT À L'IMAGE.
  // Critère : la personne VIENT PHYSIQUEMENT dans un lieu où David photographie
  // et filme. Elle n'a aucun sens ailleurs — commander un micro, demander un
  // code de remise ou écrire un message ne met personne devant un objectif, et
  // poser la question quand même reviendrait à collecter un consentement dont
  // on n'a pas l'usage.
  //  · showcase-booking → le showcase au showroom : c'est LE cas d'usage (les
  //    photos de groupe que David s'interdit aujourd'hui) ;
  //  · private-session  → rendez-vous individuel au showroom (cours ou démo) ;
  //  · showroom-visit   → ancien motif de venue au showroom : plus aucun bouton
  //    ne l'émet, mais il reste la valeur par défaut du champ caché et des
  //    lignes en base le portent. L'inclure coûte zéro et évite un trou.
  // EXCLUS volontairement : showcase-waitlist (on demande des DATES, on ne vient
  // pas), neotone-discount, contact, gonilele-order, beta-waitlist.
  // ⚠️ Cette liste doit rester IDENTIQUE à IMAGE_CONSENT_SOURCES de
  // supabase/functions/site-lead/index.ts, qui rejette la valeur ailleurs.
  const IMAGE_CONSENT_SOURCES = ['showcase-booking', 'private-session', 'showroom-visit']
  // Motifs acceptant la visio (les cours) — la liste vient de site.ts via un
  // attribut de données : une expression Astro ne s'interpole pas dans un <script>.
  const REMOTE_KINDS = (modal?.dataset.remoteKinds || '').split(',').filter(Boolean)

  // Dates de showcase à venir, posées au build dans `data-upcoming`. Même raison
  // que ci-dessus : une expression Astro ne s'interpole pas dans un <script>.
  // Un JSON cassé ne doit jamais empêcher une réservation → repli sur [].
  let upcoming: { date: string; start: string; end: string }[] = []
  try { upcoming = JSON.parse(modal?.dataset.upcoming || '[]') } catch { upcoming = [] }
  const errEl = modal?.querySelector('[data-bk-error]') as HTMLElement
  let lastFocused: HTMLElement | null = null

  // Un bloc masqué ne doit jamais participer à l'envoi : on désactive ses champs
  // (sinon une valeur invisible partirait quand même) et on les remet à zéro.
  //
  // 🐞 CORRIGÉ le 17/08/2026 — « remettre à zéro » n'est PAS `value = ''`.
  // Sur une case à cocher ou un bouton radio, `value` n'est pas ce que la
  // personne a saisi : c'est l'IDENTIFIANT de l'option (`neotone`, `gonilele`,
  // `in-person`…). L'écraser détruisait donc l'option elle-même, définitivement
  // — et `syncSessionBlocks()` masque ces blocs à CHAQUE ouverture de la modale.
  // Conséquence réelle en production : les instruments cochés pour une
  // démonstration privée partaient en chaînes vides, l'Edge Function les
  // rejetait par allowlist, et RIEN n'était enregistré. Ce qu'il faut remettre à
  // zéro sur une case, c'est `checked`.
  function toggleBlock(el: HTMLElement | null, show: boolean) {
    if (!el) return
    el.classList.toggle('hidden', !show)
    el.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((f) => {
      f.disabled = !show
      if (!show) {
        if (f instanceof HTMLInputElement && (f.type === 'checkbox' || f.type === 'radio')) f.checked = false
        else f.value = ''
      }
    })
  }

  /**
   * Le rendez-vous individuel se remplit dans l'ORDRE DEMANDÉ PAR DAVID :
   *   motif → (cours : présentiel ou visio) → instruments → durée.
   *  · cours  → présentiel ou visio ; une démonstration, elle, se fait forcément
   *    au showroom (on vient toucher les instruments) ;
   *  · instruments → dès qu'un motif est choisi, SAUF si la personne a demandé
   *    la visio : cocher des instruments qu'on ne touchera pas n'a pas de sens,
   *    et le serveur ne les enregistrerait pas ;
   *  · durée → dès qu'un motif est choisi.
   * Tant qu'aucun motif n'est choisi, rien de tout ça ne s'affiche.
   */
  function syncSessionBlocks() {
    const paid = sessionEl && !sessionEl.classList.contains('hidden')
    const kind = paid ? (kindSelect?.value || '') : ''
    toggleBlock(formatEl, REMOTE_KINDS.includes(kind))
    // Lu APRÈS le basculement ci-dessus : masquer le bloc décoche ses boutons.
    const format = (modal?.querySelector('input[name="sessionFormat"]:checked') as HTMLInputElement | null)?.value || ''
    toggleBlock(instrumentsEl, !!kind && format !== 'remote')
    toggleBlock(durationEl, !!kind)
    // Droit à l'image : uniquement si la personne vient sur place. Recalculé
    // ici (et pas seulement à l'ouverture) parce qu'un cours EN VISIO ne met
    // personne devant un objectif — la question disparaît alors, et le bloc
    // masqué est désactivé, donc rien ne part dans l'envoi.
    const source = (form?.elements.namedItem('source') as HTMLInputElement | null)?.value || ''
    toggleBlock(imageEl, IMAGE_CONSENT_SOURCES.includes(source) && format !== 'remote')
  }

  kindSelect?.addEventListener('change', syncSessionBlocks)
  // « Visio » retire la question des instruments, « présentiel » la ramène.
  modal?.querySelectorAll('input[name="sessionFormat"]').forEach((r) => r.addEventListener('change', syncSessionBlocks))

  function open(trigger: HTMLElement) {
    if (!modal || !form) return
    lastFocused = document.activeElement as HTMLElement
    const source = trigger.getAttribute('data-booking') || 'showroom-visit'
    ;(form.elements.namedItem('source') as HTMLInputElement).value = source
    ;(form.elements.namedItem('eventDate') as HTMLInputElement).value = trigger.getAttribute('data-event-date') || ''
    ;(form.elements.namedItem('eventStart') as HTMLInputElement).value = trigger.getAttribute('data-event-start') || ''
    ;(form.elements.namedItem('eventEnd') as HTMLInputElement).value = trigger.getAttribute('data-event-end') || ''
    if (titleEl) titleEl.textContent = trigger.getAttribute('data-title') || titleEl.textContent
    if (introEl) introEl.textContent = trigger.getAttribute('data-intro') || introEl.textContent
    // Chaque motif n'expose que ce qui le concerne :
    //  · showcase-booking → la date est fixée, on demande juste le nombre de personnes ;
    //  · showroom-visit / private-session → c'est la personne qui propose ses créneaux ;
    //  · private-session seul expose le MENU des motifs (avec son tarif détaillé).
    // Les deux rendez-vous individuels (venue au showroom ET rendez-vous
    // individuel) sont payants : ils annoncent tous deux la grille tarifaire,
    // ce qu'on peut venir y faire, et le cadre d'annulation.
    const isPaid = source === 'private-session'
    const isDiscount = source === 'neotone-discount'
    const isVip = isPaid || source === 'showroom-visit'
    const needsSlots = isVip
    const isShowcase = source === 'showcase-booking'
    toggleBlock(peopleEl, isShowcase)
    // La question « pour quel(s) instrument(s) ? » n'a de sens que pour une
    // place de showcase : ailleurs, c'est le motif lui-même qui la porte.
    toggleBlock(showcaseInterestsEl, isShowcase)
    toggleBlock(sessionEl, isPaid)
    toggleBlock(discountEl, isDiscount)
    // « Sans limite de caractère » : on agrandit visiblement la zone de texte et on
    // annonce qu'on lit tout, pour que la personne ose écrire.
    const msgEl = form.querySelector('textarea[name="message"]') as HTMLTextAreaElement | null
    if (msgEl) msgEl.rows = isDiscount ? 8 : 3
    // Message PRÉ-REMPLI (`data-prefill`) : reprend la petite liste de questions
    // qu'un ancien lien `mailto:` glissait dans le corps de l'email (commande
    // Gonilélé, collaboration…). Sans ça, brancher ces boutons sur ce formulaire
    // ferait PERDRE de l'information à David, pas seulement le lien mailto.
    // On ne réécrit QUE ce qu'on a nous-même déposé : ce que la personne a tapé
    // est intouchable, même si elle change de motif sans fermer la modale.
    if (msgEl) {
      const prefill = (trigger.getAttribute('data-prefill') || '').replace(/\\n/g, '\n')
      if (msgEl.value === (form.dataset.bkPrefill || '')) msgEl.value = prefill
      form.dataset.bkPrefill = prefill
    }
    const msgLabel = modal?.querySelector('[data-bk-message-label]') as HTMLElement | null
    if (msgLabel) msgLabel.textContent = (isDiscount ? msgLabel.dataset.free : msgLabel.dataset.default) || msgLabel.textContent
    modal?.querySelector('[data-bk-message-hint]')?.classList.toggle('hidden', !isDiscount)
    // Neotone a besoin du téléphone pour émettre le code : pas de « facultatif » ici.
    const phoneLabel = modal?.querySelector('[data-bk-phone-label]') as HTMLElement | null
    if (phoneLabel) phoneLabel.textContent = (isDiscount ? phoneLabel.dataset.plain : phoneLabel.dataset.default) || phoneLabel.textContent
    toggleBlock(slotsEl, needsSlots)
    // Blocs purement informatifs (aucun champ) → simple affichage/masquage.
    vipEl?.classList.toggle('hidden', !isVip)
    termsEl?.classList.toggle('hidden', !isVip)
    slotsErrEl?.classList.add('hidden')
    // DROIT À L'IMAGE : la réponse ne survit JAMAIS à la fermeture de la modale.
    // Les autres champs, eux, restent remplis — c'est confortable et sans
    // conséquence. Un consentement, non : sinon un « oui » donné pour un
    // showcase repartirait tout seul avec une demande de rendez-vous ouverte
    // deux minutes plus tard, sans que personne ne l'ait choisi pour celle-là.
    // ⚠️ Ici et NULLE PART ailleurs : `syncSessionBlocks()` s'exécute à chaque
    // changement de motif ou de format, et effacerait la réponse en cours de
    // saisie (`toggleBlock` ne décoche, lui, que ce qu'il masque).
    modal?.querySelectorAll<HTMLInputElement>('input[name="imageConsent"]').forEach((r) => { r.checked = false })
    syncSessionBlocks()

    // On ne peut pas proposer un créneau dans le passé.
    const today = new Date().toISOString().slice(0, 10)
    form.querySelectorAll<HTMLInputElement>('input[type="date"]').forEach((d) => { d.min = today })

    form.classList.remove('hidden')
    success?.classList.add('hidden')
    errEl?.classList.add('hidden')
    modal.classList.remove('hidden')
    modal.classList.add('flex')
    modal.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
  }

  function close() {
    if (!modal) return
    modal.classList.add('hidden')
    modal.classList.remove('flex')
    modal.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
    if (lastFocused?.focus) lastFocused.focus()
  }

  document.querySelectorAll<HTMLElement>('[data-booking]').forEach((el) => {
    el.addEventListener('click', (e) => { e.preventDefault(); open(el) })
  })
  modal?.querySelectorAll('.bk-close').forEach((b) => b.addEventListener('click', close))
  modal?.addEventListener('click', (e) => { if (e.target === modal) close() })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) close()
  })

  // LIEN PROFOND `?rdv=prive` — ouvre directement le formulaire de RENDEZ-VOUS
  // INDIVIDUEL. C'est la cible du bouton « Réserver un rendez-vous individuel »
  // des emails : sans ça, le lien ne faisait que défiler jusqu'à #agenda et la
  // personne devait retrouver le bon bouton elle-même.
  // On réutilise le déclencheur DÉJÀ présent sur la page (`open()` inchangé) :
  // aucun chemin de code spécifique, donc aucun risque pour le parcours payant.
  try {
    const params = new URLSearchParams(location.search)

    if (params.get('rdv') === 'prive') {
      const trigger = document.querySelector<HTMLElement>('[data-booking="private-session"]')
      if (trigger) {
        document.getElementById('agenda')?.scrollIntoView()
        open(trigger)
      }
    }

    // LIEN PROFOND `?showcase=AAAA-MM-JJ` — cible des boutons « Réserver cette
    // date » de l'email envoyé à la liste d'attente. On réutilise le bouton DÉJÀ
    // présent dans l'agenda pour cette date : la modale s'ouvre donc avec la
    // date, les horaires et le titre exacts, sans aucun code parallèle.
    // Si la date n'existe plus sur la page (showcase passé, agenda modifié), on
    // ne laisse PAS la personne devant une ancre morte : on ouvre la liste
    // d'attente pour qu'elle soit prévenue des prochaines dates.
    const wanted = params.get('showcase')
    if (wanted) {
      document.getElementById('agenda')?.scrollIntoView()
      const exact = document.querySelector<HTMLElement>(
        `[data-booking="showcase-booking"][data-event-date="${CSS.escape(wanted)}"]`,
      )
      const fallback = document.querySelector<HTMLElement>('[data-booking="showcase-waitlist"]')
      const trigger = exact || fallback
      if (trigger) open(trigger)
    }
  } catch { /* URL exotique : on ne casse jamais la page pour ça */ }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (!form.reportValidity()) return
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement
    const data = new FormData(form)
    const get = (k: string) => String(data.get(k) || '').trim()

    // Créneaux proposés : une date SANS heure (ou l'inverse) est ignorée — un
    // créneau incomplet ne veut rien dire, autant ne pas l'envoyer.
    const preferredSlots = [1, 2, 3]
      .map((n) => [get(`slotDate${n}`), get(`slotTime${n}`)])
      .filter(([d, t]) => d && t)
      .map(([d, t]) => `${d}T${t}`)

    // `sessionType` = « <motif>-<durée> » (`lesson-90`, `demo-60`…). Recomposé
    // ici à partir des deux menus : c'est l'identifiant que connaissent
    // `sessionTypes` (site.ts) ET l'allowlist de l'Edge Function. Aucun des deux
    // menus rempli à moitié ne produit d'identifiant — les deux sont `required`
    // quand ils sont visibles, donc ce cas ne se présente que si le bloc est
    // masqué (tous les autres motifs du formulaire), et vaut alors `null`.
    const sessionKind = get('sessionKind')
    const sessionMinutes = get('sessionDuration')
    const sessionType = sessionKind && sessionMinutes ? `${sessionKind}-${sessionMinutes}` : null

    const source = get('source')
    if (source === 'private-session' && preferredSlots.length === 0) {
      slotsErrEl?.classList.remove('hidden')
      ;(form.querySelector('input[name="slotDate1"]') as HTMLInputElement | null)?.focus()
      return
    }
    slotsErrEl?.classList.add('hidden')

    const label = btn.textContent
    btn.disabled = true
    btn.textContent = btn.getAttribute('data-sending') || '…'
    errEl?.classList.add('hidden')

    try {
      const r = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: get('firstName'),
          lastName: get('lastName'),
          email: get('email'),
          phone: get('phone'),
          message: get('message'),
          peopleCount: get('peopleCount') ? Number(get('peopleCount')) : null,
          eventDate: get('eventDate') || null,
          eventStart: get('eventStart') || null,
          eventEnd: get('eventEnd') || null,
          // Grille tarifaire du RDV individuel, calculée par priceGrid() au build :
          // l'email ne peut donc pas annoncer un prix différent du formulaire.
          priceGrid: modal?.dataset.priceGrid || null,
          // Dates de showcase à venir — l'email de la LISTE D'ATTENTE les liste
          // avec un lien d'inscription par date. Toujours transmis (même vide :
          // une liste vide est une information, « aucune date prévue »), l'Edge
          // Function ne s'en sert que pour `showcase-waitlist`.
          upcomingEvents: upcoming,
          neotoneModel: get('neotoneModel') || null,
          socialAccount: get('socialAccount') || null,
          discoveryChannel: get('discoveryChannel') || null,
          playingSince: get('playingSince') || null,
          dream: get('dream') || null,
          country: get('country') || null,
          sessionType,
          sessionFormat: get('sessionFormat') || null,
          instruments: data.getAll('instruments').map(String),
          // Showcase : instruments pour lesquels la personne vient. Champ et
          // colonne distincts d'`instruments` ci-dessus (voir data/site.ts).
          showcaseInterests: data.getAll('showcaseInterests').map(String),
          // Consentement aux conditions générales (case obligatoire) : c'est le
          // serveur qui l'horodate, le navigateur n'envoie que le fait.
          termsAccepted: data.get('termsAccepted') !== null,
          // Nouveautés (case FACULTATIVE) : toujours envoyé, y compris à false —
          // un refus est une information, pas une absence de réponse.
          newsOptIn: data.get('newsOptIn') !== null,
          // DROIT À L'IMAGE — 'yes' | 'blurred' | 'no', ou `null`.
          // `null` couvre DEUX cas qui appellent la même conduite : la question
          // n'a pas été posée (bloc masqué → radios désactivées → FormData ne
          // les voit pas), ou elle l'a été et personne n'a répondu. Dans les
          // deux cas : PAS d'accord, donc on ne publie rien. Un `null` ne doit
          // JAMAIS être relu comme un oui.
          imageConsent: String(data.get('imageConsent') || '') || null,
          preferredSlots,
          source,
          lang: form.dataset.lang || 'fr',
          page: location.pathname,
        }),
      })
      if (!r.ok) throw new Error('failed')
      form.classList.add('hidden')
      success?.classList.remove('hidden')
    } catch {
      errEl?.classList.remove('hidden')
    } finally {
      btn.disabled = false
      btn.textContent = label
    }
  })
</script>
