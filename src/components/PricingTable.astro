---
// Grille d'accès : Gratuit · Essentiel (3,49 € TTC / mois, 1 mois d'essai) · Studio et Prof « À venir ».
// Décision David 14/10/2026. Montant Essentiel figé au build depuis Stripe (repli 3,49 €),
// rafraîchi côté client ; Studio/Prof restent « À venir » quelle que soit la réponse de Stripe.
import Button from '@/components/Button.astro'
import { appCta } from '@/lib/appAccess'
import { getDict } from '@/i18n/dict'
import { formatAmount, fetchPricesAtBuild } from '@/lib/prices'
import { numberLocale } from '@/i18n/utils'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang).studio
const locale = numberLocale(lang)

const prices = await fetchPricesAtBuild()
const coming = ['studio', 'prof'] as const
// Bêta fermée : les prix restent affichés, mais les boutons mènent à l'encadré
// #acces (liste d'attente / candidature bêta) au lieu d'ouvrir l'application.
// Le script AppAccessSync peut rebasculer ces boutons en accès direct.
const cta = getDict(lang).common.beta
// Bêta fermée : UNE SEULE porte d'entrée pour toutes les formules (gratuite
// comprise) → même libellé, même cible #acces. En état ouvert, chaque bouton
// retrouve son libellé et sa destination d'origine.
const freeCta = appCta(t.priceFreeCta, cta.ctaWaitlist)
const planCta = appCta(t.priceCta, cta.ctaWaitlist)
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  <!-- Gratuit (sans prix) -->
  <div class="flex flex-col rounded-card border border-ink/10 bg-cream-deep/40 p-6">
    <h3 class="font-display text-xl font-700">{t.priceFree.name}</h3>
    <p class="mt-3 flex-1 text-sm text-ink-soft/85">{t.priceFree.blurb}</p>
    <div class="mt-6"><Button {...freeCta.attrs} variant="ghost" class="w-full justify-center">{freeCta.label}</Button></div>
  </div>

  <!-- Essentiel : 3,49 € TTC / mois, 1 mois d'essai -->
  <div class="relative flex flex-col rounded-card border border-copper bg-cream p-6 shadow-sm">
    <span class="absolute -top-3 left-6 rounded-full bg-rust px-3 py-1 text-xs font-700 text-cream">{t.priceTrial}</span>
    <h3 class="font-display text-xl font-700">{t.priceTiers.essential.name}</h3>
    <p class="mt-3 font-display text-3xl font-700">
      <span class="price-amount" data-plan="essential">{formatAmount(prices.essential, locale)}</span>
      <span class="text-base font-600 text-ink-soft/70"> {t.priceTtc} {t.pricePerMonth}</span>
    </p>
    <p class="mt-3 flex-1 text-sm text-ink-soft/85">{t.priceTiers.essential.blurb}</p>
    <a
      href={planCta.attrs.href}
      target={planCta.attrs.external ? '_blank' : undefined}
      rel={planCta.attrs.external ? 'noopener' : undefined}
      data-app-cta
      data-open-href={planCta.attrs['data-open-href']}
      data-open-label={planCta.attrs['data-open-label']}
      data-closed-href={planCta.attrs['data-closed-href']}
      data-closed-label={planCta.attrs['data-closed-label']}
      class="mt-6 block w-full rounded-full bg-rust px-5 py-3 text-center font-700 text-cream transition-colors hover:bg-copper"
    >{planCta.label}</a>
  </div>

  <!-- Studio et Prof : « À venir », sans prix -->
  {coming.map((plan) => (
    <div class="flex flex-col rounded-card border border-dashed border-ink/15 bg-cream-deep/20 p-6">
      <h3 class="font-display text-xl font-700">{t.priceTiers[plan].name}</h3>
      <p class="mt-3 font-display text-2xl font-700 text-ink-soft/70">{t.priceComing}</p>
    </div>
  ))}
</div>
<p data-when="closed" class="mx-auto mt-6 max-w-2xl rounded-card border border-copper/30 bg-copper/5 p-4 text-center text-sm text-ink-soft/90">{cta.priceClosedNote}</p>
<p class="mt-6 text-center text-xs text-ink-soft/65">{t.priceNote}</p>

<script define:vars={{ locale }}>
  // Rafraîchit les montants en direct depuis Stripe via la route serverless
  // same-origin /api/prices (pas de contrainte CORS). Échec silencieux : on
  // garde alors les montants figés au build.
  ;(async () => {
    try {
      const res = await fetch('/api/prices', { headers: { Accept: 'application/json' } })
      if (!res.ok) return
      const data = await res.json()
      const fmt = (p) => {
        if (!p || p.amount == null) return null
        const sym = p.currency === 'eur' ? '€' : p.currency === 'usd' ? '$' : (p.currency || '').toUpperCase()
        const n = Number.isInteger(p.amount) ? p.amount.toLocaleString(locale) : p.amount.toLocaleString(locale, { minimumFractionDigits: 2 })
        return n + ' ' + sym
      }
      // Seul l'Essentiel a un prix ; Studio/Prof restent « À venir » quoi que renvoie Stripe.
      const label = fmt(data.essential)
      if (label) document.querySelectorAll('.price-amount[data-plan="essential"]').forEach((el) => { el.textContent = label })
    } catch {
      /* CORS / réseau : on garde les montants figés au build */
    }
  })()
</script>
