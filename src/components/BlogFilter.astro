---
import type { Lang } from '@/i18n/config'
import {
  BLOG_CATEGORIES,
  allLabel,
  categoryLabel,
  filterLabel,
  type BlogCategory,
} from '@/lib/blogCategories'

interface Props {
  lang: Lang
  /** Articles déjà filtrés par langue (sert à compter + masquer les catégories vides). */
  posts: { data: { category: BlogCategory } }[]
}

const { lang, posts } = Astro.props

const counts = new Map<BlogCategory, number>()
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)

// Une catégorie sans article n'a pas de puce : un filtre qui ne renvoie rien
// est pire que pas de filtre.
const chips = [
  { slug: 'all', label: allLabel(lang), count: posts.length },
  ...BLOG_CATEGORIES.filter((c) => counts.has(c)).map((c) => ({
    slug: c as string,
    label: categoryLabel(c, lang),
    count: counts.get(c)!,
  })),
]
---

<div
  class="mt-10 flex flex-wrap justify-center gap-2"
  role="group"
  aria-label={filterLabel(lang)}
  data-blog-filter
>
  {chips.map((chip) => (
    <button
      type="button"
      data-filter={chip.slug}
      aria-pressed={chip.slug === 'all' ? 'true' : 'false'}
      class="inline-flex items-center gap-1.5 rounded-full border border-ink/20 px-3 py-1.5 text-xs font-600 text-ink-soft transition-colors hover:bg-ink/5 aria-pressed:border-rust aria-pressed:bg-rust aria-pressed:text-cream sm:px-4 sm:py-2 sm:text-sm"
    >
      {chip.label}
      <span class="text-xs opacity-60">{chip.count}</span>
    </button>
  ))}
</div>

<script>
  // Filtre par catégorie — statique + un peu de JS. Sans JS, tous les articles
  // restent visibles (les puces ne font simplement rien).
  const bar = document.querySelector<HTMLElement>('[data-blog-filter]')
  const grid = document.querySelector<HTMLElement>('[data-blog-grid]')
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]')

  if (bar && grid) {
    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'))
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-category]'))

    const apply = (slug: string, pushUrl: boolean) => {
      const known = chips.some((c) => c.dataset.filter === slug)
      const active = known ? slug : 'all'

      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(chip.dataset.filter === active))
      }

      let shown = 0
      for (const card of cards) {
        const match = active === 'all' || card.dataset.category === active
        // style inline plutôt que l'attribut `hidden` ou la classe `.hidden` :
        // les utilitaires Tailwind `flex`/`grid` des cartes gagneraient sinon
        // sur le `display:none` du preflight.
        card.style.display = match ? '' : 'none'
        if (match) shown++
      }
      if (empty) empty.style.display = shown > 0 ? 'none' : ''

      if (pushUrl) {
        const url = new URL(window.location.href)
        if (active === 'all') url.searchParams.delete('c')
        else url.searchParams.set('c', active)
        history.replaceState(null, '', url.pathname + url.search + url.hash)
      }
    }

    bar.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]')
      if (chip?.dataset.filter) apply(chip.dataset.filter, true)
    })

    // Lien profond : /blog?c=logique ouvre directement la bonne catégorie.
    const initial = new URL(window.location.href).searchParams.get('c')
    if (initial) apply(initial, false)
  }
</script>
