---
import { models, countries, woods, woodNames } from '@/data/neotone'
import { site } from '@/data/site'
import { getDict, fr } from '@/i18n/dict'
import type { Lang } from '@/i18n/config'
import type { StockLine } from '@/lib/stock'
import { numberLocale } from '@/i18n/utils'

interface Props {
  lang: Lang
  /** Stock physique figé au build (vue `stock_pieces_public`). Vide = aucune restriction. */
  stock?: StockLine[]
}
const { lang, stock = [] } = Astro.props
const t = getDict(lang)
const c = t.data.calc
const bkd = t.booking

// `es.ts` est GÉNÉRÉ : tant que les clés `stock*` du calculateur n'y sont pas,
// on retombe sur le français explicitement plutôt que d'afficher « undefined ».
const cFr = fr.data.calc as unknown as Record<string, string>
const cAny = c as unknown as Record<string, string>
const sl = (key: string) => cAny[key] || cFr[key] || ''

const modelLabels: Record<string, string> = { one: 'Neotone¹', mutant: 'Neotone¹ Mutant' }
const DEFAULT_MODEL = 'mutant'

// Données injectées côté client
const calcData = {
  models: Object.fromEntries(models.map((m) => [m.id, { label: modelLabels[m.id], note: t.data.modelNotes[m.id], woods: m.woods }])),
  woodLabels: Object.fromEntries(woods.map((w) => [w.key, woodNames[w.key][lang]])),
  countries: Object.fromEntries(countries.map((co) => [co.code, { name: co.name[lang], vat: co.vat, eu: co.eu, note: co.note ? co.note[lang] : '' }])),
  i18n: {
    discountLabel: c.discountLabel,
    vat: c.vat,
    finalTTC: c.finalTTC,
    finalIncluded: c.finalIncluded,
    finalShowroom: c.finalShowroom,
    finalB2B: c.finalB2B,
    finalB2BNote: c.finalB2BNote,
    finalExtUE: c.finalExtUE,
    finalExtUENote: c.finalExtUENote,
    b2bNote: c.b2bNote,
    savings: c.savings,
    savingsB2B: c.savingsB2B,
    savingsB2BNote: c.savingsB2BNote,
    modeOnlineShort: c.modeOnlineShort,
    modeShowroomShort: c.modeShowroomShort,
    stockOut: sl('stockOut'),
    stockExpected: sl('stockExpected'),
    stockAdjusted: sl('stockAdjusted'),
  },
  // ── 📦 Disponibilité physique au showroom (demande de David, 22/09/2026) ──
  // « que la personne voie son choix limité directement au niveau du choix des
  // bois sur lesquels elle peut cliquer ». S'applique UNIQUEMENT au mode
  // « Je viens au showroom » : en livraison, tous les bois restent commandables.
  // Tableau VIDE (état du 22/09/2026, vue sans ligne) ⇒ aucune restriction.
  stock: stock.map((l) => ({ model: l.model, wood: l.wood, status: l.status, arrival: l.arrival })),
  locale: numberLocale(lang),
}
---

<div class="overflow-hidden rounded-card border border-ink/10 bg-cream-deep/40 shadow-sm">
  <div class="grid lg:grid-cols-5">
    <!-- Contrôles -->
    <div class="space-y-8 p-6 lg:col-span-3 lg:p-8">
      <fieldset>
        <legend class="text-xs font-700 uppercase tracking-widest text-copper">{c.modeQuestion}</legend>
        <div class="mt-3 grid gap-3 sm:grid-cols-2" role="radiogroup" aria-label={c.modeQuestion}>
          <button type="button" class="calc-mode rounded-xl border-2 border-ink/15 p-4 text-left" data-mode="online" aria-checked="false" role="radio">
            <span class="block font-700">{c.modeOnline}</span>
            <span class="block text-sm text-ink-soft/80">{c.modeOnlineSub}</span>
          </button>
          <button type="button" class="calc-mode rounded-xl border-2 border-copper bg-copper/10 p-4 text-left" data-mode="showroom" aria-checked="true" role="radio">
            <span class="block font-700">{c.modeShowroom}</span>
            <span class="block text-sm text-ink-soft/80">{c.modeShowroomSub}</span>
          </button>
        </div>
      </fieldset>

      {/* Affiché seulement si le choix courant a dû être déplacé parce que la
          pièce n'est pas au showroom. Jamais visible quand la vue est vide. */}
      <p id="calc-stock-notice" class="rounded-xl border border-copper/30 bg-copper/10 px-4 py-3 text-sm text-ink-soft/90" hidden></p>

      <fieldset>
        <legend class="text-xs font-700 uppercase tracking-widest text-copper">{c.step1}</legend>
        <div class="mt-3 grid gap-3 sm:grid-cols-2" role="radiogroup" aria-label={c.step1}>
          {/* Par défaut (David, 21/09/2026) : « Je viens au showroom » + « Neotone¹ Mutant ».
              Doit rester aligné avec DEFAULT_MODEL et `state` dans le script ci-dessous. */}
          {models.map((m) => (
            <button type="button" class:list={['calc-model rounded-xl border-2 p-4 text-left', m.id === DEFAULT_MODEL ? 'border-copper bg-copper/10' : 'border-ink/15']} data-model={m.id} aria-checked={m.id === DEFAULT_MODEL ? 'true' : 'false'} role="radio">
              <span class="block font-display text-lg font-700">{modelLabels[m.id]}</span>
              <span class="block text-sm text-ink-soft/80">{t.data.modelNotes[m.id]}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-xs font-700 uppercase tracking-widest text-copper">{c.step2}</legend>
        <div class="mt-3 flex flex-wrap gap-4" role="radiogroup" aria-label={c.step2}>
          {woods.map((w, i) => (
            <button type="button" class="calc-wood flex flex-col items-center gap-1.5" data-wood={w.key} aria-checked={i === 0 ? 'true' : 'false'} role="radio">
              <span class="calc-wood-disc"><img src={w.img} width="570" height="420" alt={woodNames[w.key][lang]} loading="lazy" /></span>
              <span class="text-xs font-600">{woodNames[w.key][lang]}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-xs font-700 uppercase tracking-widest text-copper">{c.step3}</legend>
        <label class="sr-only" for="calc-country">{c.step3}</label>
        <select id="calc-country" class="mt-3 w-full rounded-xl border-2 border-ink/15 bg-cream px-4 py-3 font-600 focus:border-copper focus:outline-none">
          {countries.map((co) => (
            <option value={co.code}>{co.name[lang]}{co.eu ? ` — ${c.vatStd} ${co.vat.toString().replace('.', ',')} %` : ` — ${c.noVat}`}</option>
          ))}
        </select>
        <label class="mt-3 flex items-start gap-3 text-sm text-ink-soft/85">
          <input type="checkbox" id="calc-b2b" class="mt-1" />
          <span>{c.b2b}</span>
        </label>
      </fieldset>
    </div>

    <!-- Récapitulatif -->
    <div class="bg-ink p-6 text-cream lg:col-span-2 lg:p-8">
      <p class="text-xs font-700 uppercase tracking-widest text-gold">{c.recap}</p>
      <p id="calc-selection" class="mt-2 font-display text-xl font-700"></p>
      <dl class="mt-6 space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-cream/70">{c.basePrice}</dt><dd id="calc-base" class="font-600"></dd></div>
        <div class="flex justify-between gap-4"><dt id="calc-discount-label" class="text-cream/70"></dt><dd id="calc-discount" class="font-600 text-gold"></dd></div>
        <div class="flex justify-between gap-4 border-t border-cream/15 pt-3"><dt class="text-cream/70">{c.subtotal}</dt><dd id="calc-subtotal" class="font-600"></dd></div>
        <div id="calc-vat-wrap" class="flex justify-between gap-4"><dt id="calc-vat-label" class="text-cream/70"></dt><dd id="calc-vat" class="font-600"></dd></div>
      </dl>
      <div class="mt-6 border-t border-cream/15 pt-5">
        <p id="calc-final-label" class="text-xs font-600 uppercase tracking-widest text-gold"></p>
        <p id="calc-final" class="mt-1 font-display text-4xl font-700"></p>
        <p id="calc-final-note" class="mt-1 text-xs text-cream/60"></p>
      </div>
      <p class="mt-4 inline-flex max-w-full flex-wrap items-center gap-x-2 rounded-lg bg-rust/20 px-3 py-2 text-sm text-gold">
        <span id="calc-savings-label">{c.savings}</span> <span id="calc-savings" class="font-700"></span>
      </p>
      {/* Note affichée UNIQUEMENT en B2B intracommunautaire : elle sépare la remise
          (gain réel) de la TVA non facturée (non avancée, mais récupérable de toute
          façon) — sans quoi le montant total se lirait comme une pure réduction. */}
      <p id="calc-savings-note" class="mt-2 text-xs leading-relaxed text-cream/55"></p>
      <p id="calc-extra-note" class="mt-4 text-xs leading-relaxed text-cream/55"></p>
      {/* Ouvre le formulaire de demande de code (modale BookingForm) au lieu d'un
          mailto : la demande est enregistrée et David reçoit tout ce que Neotone
          lui réclame — modèle et pays de livraison compris. */}
      {/* ⚠️ Les `data-calc-*` sont RÉÉCRITS à chaque render() ci-dessous : c'est
          par eux que le choix déjà fait ici voyage jusqu'à la modale, qui ne
          repose donc plus la question du modèle (demande de David, 22/09/2026).
          `data-calc-recap` est la phrase affichée ; les autres sont les valeurs
          envoyées au serveur (noms de champs INCHANGÉS). */}
      <button
        id="calc-get-code"
        type="button"
        data-booking="neotone-discount"
        data-title={bkd.discountTitle}
        data-intro={bkd.discountIntro}
        class="mt-6 block w-full rounded-full bg-rust px-5 py-3 text-center font-700 text-cream transition-colors hover:bg-copper"
      >{c.getCode}</button>
    </div>
  </div>
</div>

<script type="application/json" id="calc-data" set:html={JSON.stringify(calcData)}></script>

<script>
  const dataEl = document.getElementById('calc-data')
  if (dataEl) {
    const DATA = JSON.parse(dataEl.textContent || '{}')
    const L = DATA.i18n
    const state = { model: 'mutant', wood: 'frene', country: 'FR', b2b: false, mode: 'showroom' }
    const locale = document.documentElement.lang === 'en' ? 'en-GB' : 'fr-FR'

    const fmtEUR = (n: number) => new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n) + ' €'
    const fmtVAT = (v: number) => (v === Math.floor(v) ? v + ' %' : v.toString().replace('.', ',') + ' %')
    const $ = (id: string) => document.getElementById(id)

    function compute() {
      const basePrice = DATA.models[state.model].woods[state.wood]
      const discountRate = state.mode === 'showroom' ? 0.07 : 0.05
      const discount = basePrice * discountRate
      const subtotalHT = basePrice - discount
      const country = DATA.countries[state.country]
      let vatRate = 0, vatAmount = 0, finalTTC = subtotalHT
      if (country.eu && !state.b2b) {
        vatRate = country.vat
        vatAmount = subtotalHT * (vatRate / 100)
        finalTTC = subtotalHT + vatAmount
      }
      // « Tu économises » = toujours l'écart avec le PRIX CATALOGUE que paierait un
      // particulier du même pays (base HT + TVA locale s'il y en a une).
      //   · UE, particulier : (1+v)P − (1+v)(P−remise) = remise × (1+v)   ← inchangé
      //   · UE, B2B         : (1+v)P − (P−remise)      = remise + v×P     ← ajout
      //   · hors UE         : P − (P−remise)           = remise           ← inchangé
      // Les deux composantes du cas B2B sont exactes vis-à-vis de cette référence :
      // la remise (remise) et la TVA contenue dans le prix catalogue (v×P). Elles
      // n'ont PAS la même nature (voir savingsB2BNote) — d'où la note en dessous.
      const catalogTTC = country.eu ? basePrice * (1 + country.vat / 100) : basePrice
      const b2bEU = country.eu && state.b2b
      const savingsVat = b2bEU ? basePrice * (country.vat / 100) : 0
      const savings = country.eu && !state.b2b ? discount * (1 + vatRate / 100) : discount + savingsVat
      // Exprimé sur la même base que la remise déjà affichée (le prix HT de base) :
      // 7 % de remise + 20 % de TVA = 27 %.
      // Math.round : 0.07 * 100 vaut 7.000000000000001 en flottant (déjà arrondi
      // ailleurs pour l'étiquette « Remise −7 % »).
      const discountPct = Math.round(discountRate * 100)
      const savingsRate = discountPct + (b2bEU ? country.vat : 0)
      return { basePrice, discount, discountRate, discountPct, subtotalHT, vatRate, vatAmount, finalTTC, savings, savingsRate, catalogTTC, b2bEU, country }
    }

    function syncTrigger() {
      const btn = $('calc-get-code')
      if (!btn) return
      const modeLabel = state.mode === 'showroom' ? L.modeShowroomShort : L.modeOnlineShort
      btn.dataset.calcModel = state.model
      btn.dataset.calcWood = state.wood
      btn.dataset.calcMode = state.mode
      btn.dataset.calcCountry = DATA.countries[state.country].name
      btn.dataset.calcRecap = [
        // On ne garde que le début de la note (« 10 notes ») : la suite
        // (« · sans écran ») se confondrait avec les séparateurs du récap.
        `${DATA.models[state.model].label} — ${String(DATA.models[state.model].note).split(' · ')[0]}`,
        DATA.woodLabels[state.wood],
        modeLabel,
        DATA.countries[state.country].name,
      ].join(' · ')
    }

    function render() {
      // AVANT compute() : si la sélection courante n'est pas au showroom, elle
      // est recalée ici — le prix et le récapitulatif restent donc justes.
      applyAvailability()
      const r = compute()
      syncTrigger()
      $('calc-selection')!.textContent = `${DATA.models[state.model].label} — ${DATA.woodLabels[state.wood]}`
      $('calc-base')!.textContent = fmtEUR(r.basePrice)
      $('calc-discount-label')!.textContent = `${L.discountLabel} −${Math.round(r.discountRate * 100)} %`
      $('calc-discount')!.textContent = '− ' + fmtEUR(r.discount)
      $('calc-subtotal')!.textContent = fmtEUR(r.subtotalHT)

      const vatWrap = $('calc-vat-wrap')!
      if (r.country.eu && !state.b2b) {
        vatWrap.style.display = ''
        $('calc-vat-label')!.textContent = `${L.vat} ${r.country.name} ${fmtVAT(r.vatRate)}`
        $('calc-vat')!.textContent = fmtEUR(r.vatAmount)
        $('calc-final-label')!.textContent = L.finalTTC
        $('calc-final-note')!.textContent = L.finalIncluded
        $('calc-extra-note')!.innerHTML = ''
      } else if (state.b2b) {
        vatWrap.style.display = 'none'
        $('calc-final-label')!.textContent = L.finalB2B
        $('calc-final-note')!.textContent = L.finalB2BNote
        $('calc-extra-note')!.innerHTML = L.b2bNote
      } else {
        vatWrap.style.display = 'none'
        $('calc-final-label')!.textContent = L.finalExtUE
        $('calc-final-note')!.textContent = L.finalExtUENote
        $('calc-extra-note')!.innerHTML = r.country.note || ''
      }
      if (state.mode === 'showroom') $('calc-final-note')!.textContent = L.finalShowroom

      const finalEl = $('calc-final')!
      finalEl.classList.remove('price-update')
      void finalEl.offsetWidth
      finalEl.textContent = fmtEUR(r.finalTTC)
      finalEl.classList.add('price-update')
      const savingsNote = $('calc-savings-note')!
      if (r.b2bEU) {
        $('calc-savings-label')!.textContent = L.savingsB2B
        $('calc-savings')!.textContent = `${fmtEUR(r.savings)} (−${fmtVAT(r.savingsRate)})`
        savingsNote.style.display = ''
        savingsNote.textContent = L.savingsB2BNote
          .replace('{discountRate}', fmtVAT(r.discountPct))
          .replace('{vatRate}', fmtVAT(r.country.vat))
          .replace('{catalog}', fmtEUR(r.catalogTTC))
          .replace('{discount}', fmtEUR(r.discount))
      } else {
        $('calc-savings-label')!.textContent = L.savings
        $('calc-savings')!.textContent = fmtEUR(r.savings)
        savingsNote.style.display = 'none'
        savingsNote.textContent = ''
      }
    }

    // ══ 📦 DISPONIBILITÉ AU SHOWROOM ═════════════════════════════════════════
    // Règle (demande de David, 22/09/2026) :
    //  · « Je me fais livrer »  → AUCUNE restriction, tous les bois cliquables.
    //  · « Je viens au showroom » → seuls les couples modèle+bois réellement
    //    `disponible` restent cliquables ; les autres sont grisés, non
    //    cliquables et portent une mention honnête (« pas en stock au
    //    showroom », ou « attendu le … » si la pièce est en transit).
    //  · Liste de stock VIDE (état du 22/09/2026) ou injoignable → on ne
    //    restreint RIEN : un stock inconnu ne doit jamais empêcher un achat.
    type StockRow = { model: string; wood: string; status: 'disponible' | 'en_transit'; arrival: string | null }
    let stock: StockRow[] = Array.isArray(DATA.stock) ? DATA.stock : []
    const stockLocale = DATA.locale || locale

    const restrict = () => state.mode === 'showroom' && stock.length > 0

    /** null = aucune pièce connue pour ce couple. */
    function availOf(model: string, wood: string): StockRow | null {
      const rows = stock.filter((r) => r.model === model && r.wood === wood)
      const ready = rows.find((r) => r.status === 'disponible')
      if (ready) return ready
      const transit = rows
        .filter((r) => r.status === 'en_transit')
        .sort((a, b) => (a.arrival ?? '9999').localeCompare(b.arrival ?? '9999'))[0]
      return transit ?? null
    }

    const woodKeys = (model: string) => Object.keys(DATA.models[model].woods)
    const isWoodOk = (model: string, wood: string) => availOf(model, wood)?.status === 'disponible'
    const isModelOk = (model: string) => woodKeys(model).some((w) => isWoodOk(model, w))

    function fmtDate(iso: string | null): string | null {
      if (!iso) return null
      const d = new Date(`${iso}T12:00:00Z`)
      if (Number.isNaN(d.getTime())) return null
      return new Intl.DateTimeFormat(stockLocale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d)
    }

    /** La pièce en transit la plus proche pour un modèle (toutes essences). */
    function soonestOf(model: string): StockRow | null {
      return woodKeys(model)
        .map((w) => availOf(model, w))
        .filter((r): r is StockRow => r !== null && r.status === 'en_transit')
        .sort((a, b) => (a.arrival ?? '9999').localeCompare(b.arrival ?? '9999'))[0] ?? null
    }

    /** Mention discrète sous un bouton indisponible. */
    function unavailableText(row: StockRow | null): string {
      if (row && row.status === 'en_transit') {
        const d = fmtDate(row.arrival)
        if (d) return String(L.stockExpected).replace('{date}', d)
      }
      return String(L.stockOut)
    }

    function setBtnState(btn: HTMLButtonElement, ok: boolean, note: string) {
      let tag = btn.querySelector<HTMLElement>('.calc-avail')
      if (ok) {
        btn.removeAttribute('aria-disabled')
        btn.classList.remove('opacity-40', 'cursor-not-allowed', 'grayscale')
        tag?.remove()
        return
      }
      btn.setAttribute('aria-disabled', 'true')
      btn.classList.add('opacity-40', 'cursor-not-allowed', 'grayscale')
      if (!tag) {
        tag = document.createElement('span')
        tag.className = 'calc-avail mt-1 block text-[0.65rem] leading-tight text-ink-soft/70'
        btn.appendChild(tag)
      }
      tag.textContent = note
    }

    /** Applique le grisage et, si besoin, recale la sélection courante. */
    function applyAvailability(): boolean {
      const on = restrict()
      let adjusted = false

      if (on && !isModelOk(state.model)) {
        const fallback = Object.keys(DATA.models).find((m) => isModelOk(m))
        if (fallback) { state.model = fallback; adjusted = true }
      }
      if (on && isModelOk(state.model) && !isWoodOk(state.model, state.wood)) {
        const fallback = woodKeys(state.model).find((w) => isWoodOk(state.model, w))
        if (fallback) { state.wood = fallback; adjusted = true }
      }

      document.querySelectorAll<HTMLButtonElement>('.calc-model').forEach((btn) => {
        const m = btn.dataset.model!
        const ok = !on || isModelOk(m)
        setBtnState(btn, ok, unavailableText(on ? soonestOf(m) : null))
        btn.setAttribute('aria-checked', m === state.model ? 'true' : 'false')
        btn.classList.toggle('border-copper', m === state.model)
        btn.classList.toggle('bg-copper/10', m === state.model)
        btn.classList.toggle('border-ink/15', m !== state.model)
      })

      document.querySelectorAll<HTMLButtonElement>('.calc-wood').forEach((btn) => {
        const w = btn.dataset.wood!
        const ok = !on || isWoodOk(state.model, w)
        setBtnState(btn, ok, unavailableText(on ? availOf(state.model, w) : null))
        btn.setAttribute('aria-checked', w === state.wood ? 'true' : 'false')
      })

      const notice = $('calc-stock-notice')!
      if (adjusted) { notice.textContent = L.stockAdjusted; notice.hidden = false }
      else { notice.hidden = true; notice.textContent = '' }
      return adjusted
    }

    /**
     * Mise à jour en direct : la page dispatche `neotone:stock` avec les lignes
     * normalisées de la vue publique (voir NeotonePage.astro). Un tableau vide
     * remet le calculateur sans aucune restriction.
     */
    document.addEventListener('neotone:stock', (e) => {
      const rows = (e as CustomEvent).detail
      stock = Array.isArray(rows) ? rows : []
      render()
    })

    function bindGroup(selector: string, key: 'model' | 'wood' | 'mode', attr: string) {
      document.querySelectorAll<HTMLButtonElement>(selector).forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.getAttribute('aria-disabled') === 'true') return
          document.querySelectorAll<HTMLButtonElement>(selector).forEach((b) => {
            b.classList.remove('border-copper', 'bg-copper/10')
            b.classList.add('border-ink/15')
            b.setAttribute('aria-checked', 'false')
          })
          btn.classList.add('border-copper', 'bg-copper/10')
          btn.classList.remove('border-ink/15')
          btn.setAttribute('aria-checked', 'true')
          ;(state as any)[key] = btn.dataset[attr]
          render()
        })
      })
    }
    bindGroup('.calc-mode', 'mode', 'mode')
    bindGroup('.calc-model', 'model', 'model')
    bindGroup('.calc-wood', 'wood', 'wood')

    ;($('calc-country') as HTMLSelectElement).addEventListener('change', (e) => { state.country = (e.target as HTMLSelectElement).value; render() })
    ;($('calc-b2b') as HTMLInputElement).addEventListener('change', (e) => { state.b2b = (e.target as HTMLInputElement).checked; render() })
    render()
  }
</script>
