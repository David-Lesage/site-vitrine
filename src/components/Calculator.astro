---
import { models, countries, woods, woodNames } from '@/data/neotone'
import { site } from '@/data/site'
import { getDict, fr } from '@/i18n/dict'
import type { Lang } from '@/i18n/config'
import type { StockLine } from '@/lib/stock'
import { numberLocale } from '@/i18n/utils'

interface Props {
  lang: Lang
  /** Stock physique figé au build (Google Sheet de David, voir src/lib/stock.ts). Vide = état inconnu, rien d'affiché. Ne bloque jamais le calcul. */
  stock?: StockLine[]
}
const { lang, stock = [] } = Astro.props
const t = getDict(lang)
const c = t.data.calc
const bkd = t.booking

// `es.ts` est GÉNÉRÉ : tant que les clés `stock*` du calculateur n'y sont pas,
// on retombe sur le français explicitement plutôt que d'afficher « undefined ».
const cFr = fr.data.calc as unknown as Record<string, string>
const cAny = c as unknown as Record<string, string>
const sl = (key: string) => cAny[key] || cFr[key] || ''
// Deux parcours Neotone (21/10/2026) : intitulé du bouton et de la modale selon
// le mode. Même repli FR que `billing` dans BookingForm (es.ts est généré).
// Pastilles d'état du stock (25/10/2026) : clés partagées avec la page
// (namespace `neotone`), même repli FR.
const nFr = fr.neotone as unknown as Record<string, string>
const nAny = t.neotone as unknown as Record<string, string>
const nl = (key: string) => nAny[key] || nFr[key] || ''
const pp = { ...fr.booking.purchase, ...((bkd as { purchase?: Partial<typeof fr.booking.purchase> }).purchase ?? {}) }

const modelLabels: Record<string, string> = { one: 'Neotone¹', mutant: 'Neotone¹ Mutant' }
const DEFAULT_MODEL = 'mutant'

// Données injectées côté client
const calcData = {
  models: Object.fromEntries(models.map((m) => [m.id, { label: modelLabels[m.id], note: t.data.modelNotes[m.id], woods: m.woods }])),
  woodLabels: Object.fromEntries(woods.map((w) => [w.key, woodNames[w.key][lang]])),
  countries: Object.fromEntries(countries.map((co) => [co.code, { name: co.name[lang], vat: co.vat, eu: co.eu, note: co.note ? co.note[lang] : '' }])),
  i18n: {
    discountLabel: c.discountLabel,
    vat: c.vat,
    finalTTC: c.finalTTC,
    finalIncluded: c.finalIncluded,
    finalShowroom: c.finalShowroom,
    finalB2B: c.finalB2B,
    finalB2BNote: c.finalB2BNote,
    finalExtUE: c.finalExtUE,
    finalExtUENote: c.finalExtUENote,
    b2bNote: c.b2bNote,
    savings: c.savings,
    savingsB2B: c.savingsB2B,
    savingsB2BNote: c.savingsB2BNote,
    // `sl()` : repli FR si la clé manque dans une langue (es.ts est généré).
    modeOnlineShort: sl('modeOnlineShort'),
    modeShowroomShort: sl('modeShowroomShort'),
    // Bouton + titre + intro de la modale, par mode (21/10/2026).
    buyShowroomButton: pp.showroomButton,
    buyShowroomTitle: pp.showroomTitle,
    buyShowroomIntro: pp.showroomIntro,
    buyOnlineButton: pp.onlineButton,
    buyOnlineTitle: pp.onlineTitle,
    buyOnlineIntro: pp.onlineIntro,
    // ── 📦 Trois états de stock (David, 25/10/2026) — voir le bloc #calc-stock-status.
    stockStateIn: sl('stockStateIn'),
    stockStateInSub: sl('stockStateInSub'),
    stockStateTransit: sl('stockStateTransit'),
    stockStateTransitSoon: sl('stockStateTransitSoon'),
    stockStateTransitSub: sl('stockStateTransitSub'),
    stockStateOut: sl('stockStateOut'),
    stockStateOutSub: sl('stockStateOutSub'),
    stockTagIn: sl('stockTagIn'),
    stockTagTransit: sl('stockTagTransit'),
    stockTagOut: sl('stockTagOut'),
    // Pastilles (David, 25/10/2026 : « très clair même sans cliquer »).
    pills: {
      in: nl('stockPillIn'),
      soon: nl('stockPillSoon'),
      soonDate: nl('stockPillSoonDate'),
      soonMonth: nl('stockPillSoonMonth'),
      order: nl('stockPillOrder'),
    },
    stockOnlineAlsoIn: nl('stockOnlineAlsoIn'),
    stockOnlineSwitch: nl('stockOnlineSwitch'),
  },
  // ── 📦 Disponibilité physique au showroom ─────────────────────────────────
  // 25/10/2026 (David) : « même si l'instrument n'est pas en stock au showroom,
  // la personne [doit pouvoir] calculer le prix ». Le stock NE BLOQUE PLUS
  // RIEN (avant : bois grisés et non cliquables en mode showroom) : il
  // INFORME, pour le couple modèle + bois choisi, en trois états.
  // `stockKnown` = la source a répondu (au build : au moins une pièce lue).
  // Source inconnue (vide au build, injoignable) ⇒ aucun état affiché.
  stock: stock.map((l) => ({ model: l.model, wood: l.wood, status: l.status, arrival: l.arrival, arrivalLabel: l.arrivalLabel })),
  stockKnown: stock.length > 0,
  lang,
  locale: numberLocale(lang),
}
---

<div class="overflow-hidden rounded-card border border-ink/10 bg-cream-deep/40 shadow-sm">
  <div class="grid lg:grid-cols-5">
    <!-- Contrôles -->
    <div class="space-y-8 p-6 lg:col-span-3 lg:p-8">
      <fieldset>
        <legend class="text-xs font-700 uppercase tracking-widest text-copper">{c.modeQuestion}</legend>
        <div class="mt-3 grid gap-3 sm:grid-cols-2" role="radiogroup" aria-label={c.modeQuestion}>
          <button type="button" class="calc-mode rounded-xl border-2 border-ink/15 p-4 text-left" data-mode="online" aria-checked="false" role="radio">
            <span class="block font-700">{c.modeOnline}</span>
            <span class="block text-sm text-ink-soft/80">{c.modeOnlineSub}</span>
          </button>
          <button type="button" class="calc-mode rounded-xl border-2 border-copper bg-copper/10 p-4 text-left" data-mode="showroom" aria-checked="true" role="radio">
            <span class="block font-700">{c.modeShowroom}</span>
            <span class="block text-sm text-ink-soft/80">{c.modeShowroomSub}</span>
          </button>
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-xs font-700 uppercase tracking-widest text-copper">{c.step1}</legend>
        <div class="mt-3 grid gap-3 sm:grid-cols-2" role="radiogroup" aria-label={c.step1}>
          {/* Par défaut (David, 21/09/2026) : « Je viens au showroom » + « Neotone¹ Mutant ».
              Doit rester aligné avec DEFAULT_MODEL et `state` dans le script ci-dessous. */}
          {models.map((m) => (
            <button type="button" class:list={['calc-model rounded-xl border-2 p-4 text-left', m.id === DEFAULT_MODEL ? 'border-copper bg-copper/10' : 'border-ink/15']} data-model={m.id} aria-checked={m.id === DEFAULT_MODEL ? 'true' : 'false'} role="radio">
              <span class="block font-display text-lg font-700">{modelLabels[m.id]}</span>
              <span class="block text-sm text-ink-soft/80">{t.data.modelNotes[m.id]}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-xs font-700 uppercase tracking-widest text-copper">{c.step2}</legend>
        {/* Tuiles (25/10/2026) : la SÉLECTION = bordure cuivre de la tuile (comme
            les modèles) ; le STOCK = anneau rouille autour de la vignette + pastille
            pleine « ✓ En stock à Paris ». Deux signaux distincts, jamais confondus.
            2 colonnes à 390 px pour que la pastille tienne sur une ligne. */}
        <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3" role="radiogroup" aria-label={c.step2}>
          {woods.map((w, i) => (
            <button type="button" class:list={['calc-wood flex min-h-11 flex-col items-center gap-1.5 rounded-xl border-2 px-2 pb-2.5 pt-3 text-center', i === 0 ? 'border-copper bg-copper/10' : 'border-ink/15']} data-wood={w.key} aria-checked={i === 0 ? 'true' : 'false'} role="radio">
              <span class="calc-wood-disc"><img src={w.img} width="570" height="420" alt="" loading="lazy" /></span>
              <span class="text-sm font-700">{woodNames[w.key][lang]}</span>
            </button>
          ))}
        </div>
        {/* ── 📦 ÉTAT DU STOCK pour le couple modèle + bois choisi (25/10/2026) ──
            Trois états : disponible au showroom · arrive au showroom (période
            écrite dans le Sheet, colonne L) · pas en stock = sur commande.
            Rempli par `renderStock()`. Caché tant que la source n'a pas répondu :
            on n'affiche jamais un stock inventé. Le bouton « Faire la demande »
            ouvre le formulaire (source `neotone-stock-request`) avec le choix. */}
        <div id="calc-stock-status" data-state="" class="mt-4 rounded-xl border-2 px-4 py-3 text-sm data-[state=in]:border-rust/45 data-[state=in]:bg-rust/[0.07] data-[state=out]:border-ink/15 data-[state=out]:bg-cream data-[state=transit]:border-gold/60 data-[state=transit]:bg-gold/10" aria-live="polite" hidden>
          <p id="calc-stock-status-head" class="flex flex-wrap items-center gap-2 font-700 text-ink"></p>
          <p id="calc-stock-status-sub" class="mt-1.5 text-ink-soft/85"></p>
          {/* Mode « en ligne » + couple aussi au showroom : bascule vers le showroom. */}
          <button
            id="calc-stock-switch"
            type="button"
            class="mt-3 inline-flex min-h-11 items-center rounded-full border-2 border-rust px-5 py-2 font-700 text-rust transition-colors hover:bg-rust hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-copper"
            hidden
          >{nl('stockOnlineSwitch')}</button>
          <button
            id="calc-stock-request"
            type="button"
            data-booking="neotone-stock-request"
            data-title={sl('stockRequestTitle')}
            data-intro={sl('stockRequestIntro')}
            class="mt-3 inline-flex min-h-11 items-center rounded-full border-2 border-rust px-5 py-2 font-700 text-rust transition-colors hover:bg-rust hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-copper"
            hidden
          >{sl('stockRequestButton')}</button>
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-xs font-700 uppercase tracking-widest text-copper">{c.step3}</legend>
        <label class="sr-only" for="calc-country">{c.step3}</label>
        <select id="calc-country" class="mt-3 w-full rounded-xl border-2 border-ink/15 bg-cream px-4 py-3 font-600 focus:border-copper focus:outline-none">
          {countries.map((co) => (
            <option value={co.code}>{co.name[lang]}{co.eu ? ` — ${c.vatStd} ${co.vat.toString().replace('.', ',')} %` : ` — ${c.noVat}`}</option>
          ))}
        </select>
        <label class="mt-3 flex items-start gap-3 text-sm text-ink-soft/85">
          <input type="checkbox" id="calc-b2b" class="mt-1" />
          <span>{c.b2b}</span>
        </label>
      </fieldset>
    </div>

    <!-- Récapitulatif -->
    <div class="bg-ink p-6 text-cream lg:col-span-2 lg:p-8">
      <p class="text-xs font-700 uppercase tracking-widest text-gold">{c.recap}</p>
      <p id="calc-selection" class="mt-2 font-display text-xl font-700"></p>
      <dl class="mt-6 space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-cream/70">{c.basePrice}</dt><dd id="calc-base" class="font-600"></dd></div>
        <div class="flex justify-between gap-4"><dt id="calc-discount-label" class="text-cream/70"></dt><dd id="calc-discount" class="font-600 text-gold"></dd></div>
        <div class="flex justify-between gap-4 border-t border-cream/15 pt-3"><dt class="text-cream/70">{c.subtotal}</dt><dd id="calc-subtotal" class="font-600"></dd></div>
        <div id="calc-vat-wrap" class="flex justify-between gap-4"><dt id="calc-vat-label" class="text-cream/70"></dt><dd id="calc-vat" class="font-600"></dd></div>
      </dl>
      <div class="mt-6 border-t border-cream/15 pt-5">
        <p id="calc-final-label" class="text-xs font-600 uppercase tracking-widest text-gold"></p>
        <p id="calc-final" class="mt-1 font-display text-4xl font-700"></p>
        <p id="calc-final-note" class="mt-1 text-xs text-cream/60"></p>
      </div>
      <p class="mt-4 inline-flex max-w-full flex-wrap items-center gap-x-2 rounded-lg bg-rust/20 px-3 py-2 text-sm text-gold">
        <span id="calc-savings-label">{c.savings}</span> <span id="calc-savings" class="font-700"></span>
      </p>
      {/* Note affichée UNIQUEMENT en B2B intracommunautaire : elle sépare la remise
          (gain réel) de la TVA non facturée (non avancée, mais récupérable de toute
          façon) — sans quoi le montant total se lirait comme une pure réduction. */}
      <p id="calc-savings-note" class="mt-2 text-xs leading-relaxed text-cream/55"></p>
      <p id="calc-extra-note" class="mt-4 text-xs leading-relaxed text-cream/55"></p>
      {/* Ouvre le formulaire de demande de code (modale BookingForm) au lieu d'un
          mailto : la demande est enregistrée et David reçoit tout ce que Neotone
          lui réclame — modèle et pays de livraison compris. */}
      {/* ⚠️ Les `data-calc-*` sont RÉÉCRITS à chaque render() ci-dessous : c'est
          par eux que le choix déjà fait ici voyage jusqu'à la modale, qui ne
          repose donc plus la question du modèle (demande de David, 22/09/2026).
          `data-calc-recap` est la phrase affichée ; les autres sont les valeurs
          envoyées au serveur (noms de champs INCHANGÉS). */}
      {/* 21/10/2026 — libellé, titre et intro RÉÉCRITS par mode dans
          syncTrigger() (« Acheter au showroom » / « Achat en ligne : code »).
          Rendu initial = mode showroom, celui de `state` par défaut. */}
      <button
        id="calc-get-code"
        type="button"
        data-booking="neotone-discount"
        data-title={pp.showroomTitle}
        data-intro={pp.showroomIntro}
        class="mt-6 block w-full rounded-full bg-rust px-5 py-3 text-center font-700 text-cream transition-colors hover:bg-copper"
      >{pp.showroomButton}</button>
    </div>
  </div>
</div>

<script type="application/json" id="calc-data" set:html={JSON.stringify(calcData)}></script>

<script>
  import { stockPillHtml, transitPillText, type PillKind, type StockPillLabels } from '@/lib/stock'
  import { formatArrivalLabel } from '@/lib/stockSource.js'
  const dataEl = document.getElementById('calc-data')
  if (dataEl) {
    const DATA = JSON.parse(dataEl.textContent || '{}')
    const L = DATA.i18n
    const state = { model: 'mutant', wood: 'frene', country: 'FR', b2b: false, mode: 'showroom' }
    const locale = document.documentElement.lang === 'en' ? 'en-GB' : 'fr-FR'

    const fmtEUR = (n: number) => new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n) + ' €'
    const fmtVAT = (v: number) => (v === Math.floor(v) ? v + ' %' : v.toString().replace('.', ',') + ' %')
    const $ = (id: string) => document.getElementById(id)

    function compute() {
      const basePrice = DATA.models[state.model].woods[state.wood]
      const discountRate = state.mode === 'showroom' ? 0.07 : 0.05
      const discount = basePrice * discountRate
      const subtotalHT = basePrice - discount
      const country = DATA.countries[state.country]
      let vatRate = 0, vatAmount = 0, finalTTC = subtotalHT
      if (country.eu && !state.b2b) {
        vatRate = country.vat
        vatAmount = subtotalHT * (vatRate / 100)
        finalTTC = subtotalHT + vatAmount
      }
      // « Tu économises » = toujours l'écart avec le PRIX CATALOGUE que paierait un
      // particulier du même pays (base HT + TVA locale s'il y en a une).
      //   · UE, particulier : (1+v)P − (1+v)(P−remise) = remise × (1+v)   ← inchangé
      //   · UE, B2B         : (1+v)P − (P−remise)      = remise + v×P     ← ajout
      //   · hors UE         : P − (P−remise)           = remise           ← inchangé
      // Les deux composantes du cas B2B sont exactes vis-à-vis de cette référence :
      // la remise (remise) et la TVA contenue dans le prix catalogue (v×P). Elles
      // n'ont PAS la même nature (voir savingsB2BNote) — d'où la note en dessous.
      const catalogTTC = country.eu ? basePrice * (1 + country.vat / 100) : basePrice
      const b2bEU = country.eu && state.b2b
      const savingsVat = b2bEU ? basePrice * (country.vat / 100) : 0
      const savings = country.eu && !state.b2b ? discount * (1 + vatRate / 100) : discount + savingsVat
      // Exprimé sur la même base que la remise déjà affichée (le prix HT de base) :
      // 7 % de remise + 20 % de TVA = 27 %.
      // Math.round : 0.07 * 100 vaut 7.000000000000001 en flottant (déjà arrondi
      // ailleurs pour l'étiquette « Remise −7 % »).
      const discountPct = Math.round(discountRate * 100)
      const savingsRate = discountPct + (b2bEU ? country.vat : 0)
      // ── Les DEUX variantes, pour le formulaire (21/10/2026) ───────────────
      // Le récapitulatif du formulaire doit pouvoir basculer en hors taxes si
      // la personne saisit un n° de TVA alors que la case B2B n'est pas cochée
      // ici (et inversement). Il ne recalcule rien : il lit ces valeurs, qui
      // sont EXACTEMENT celles que ce calculateur affiche dans chaque cas
      // (mêmes formules que ci-dessus, case cochée ou non).
      const stdVatRate = country.eu ? country.vat : 0
      const stdVatAmount = subtotalHT * (stdVatRate / 100)
      const stdTotalTTC = subtotalHT + stdVatAmount
      const stdSavings = country.eu ? discount * (1 + stdVatRate / 100) : discount
      const b2bSavings = country.eu ? discount + basePrice * (country.vat / 100) : discount
      const b2bSavingsRate = discountPct + (country.eu ? country.vat : 0)
      return { basePrice, discount, discountRate, discountPct, subtotalHT, vatRate, vatAmount, finalTTC, savings, savingsRate, catalogTTC, b2bEU, country,
        stdVatRate, stdVatAmount, stdTotalTTC, stdSavings, b2bSavings, b2bSavingsRate }
    }

    /**
     * Arrondi au centime IDENTIQUE à l'affichage : même moteur que fmtEUR
     * (Intl, 2 décimales), sans séparateur de milliers. Ni Math.round(n*100)
     * ni toFixed ne conviennent : sur 120,395 (99,50 × 1,21) ils donnent
     * 120,39 quand le calculateur affiche 120,40 (vérifié le 21/10/2026).
     */
    const centsFmt = new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2, useGrouping: false })
    const cents = (n: number) => Number(centsFmt.format(n))

    function syncTrigger(r: ReturnType<typeof compute>) {
      const btn = $('calc-get-code')
      if (!btn) return
      const modeLabel = state.mode === 'showroom' ? L.modeShowroomShort : L.modeOnlineShort
      btn.dataset.calcModel = state.model
      btn.dataset.calcWood = state.wood
      btn.dataset.calcMode = state.mode
      // Deux parcours (21/10/2026) : showroom = achat sur place (−7 %),
      // en ligne = demande de code de réduction (−5 %). La modale lit
      // `data-title` / `data-intro` à l'ouverture.
      const showroom = state.mode === 'showroom'
      btn.textContent = showroom ? L.buyShowroomButton : L.buyOnlineButton
      btn.dataset.title = showroom ? L.buyShowroomTitle : L.buyOnlineTitle
      btn.dataset.intro = showroom ? L.buyShowroomIntro : L.buyOnlineIntro
      btn.dataset.calcCountry = DATA.countries[state.country].name
      btn.dataset.calcRecap = [
        // On ne garde que le début de la note (« 10 notes ») : la suite
        // (« · sans écran ») se confondrait avec les séparateurs du récap.
        `${DATA.models[state.model].label} — ${String(DATA.models[state.model].note).split(' · ')[0]}`,
        DATA.woodLabels[state.wood],
        modeLabel,
        DATA.countries[state.country].name,
      ].join(' · ')
      // ── MONTANTS DU CALCULATEUR → formulaire → mails (21/10/2026) ─────────
      // Demande de David : « rappeler le prix, le modèle choisi, l'économie
      // faite grâce au 5 ou 7 % et les −20 % si autoliquidation ». SOURCE
      // UNIQUE = compute() : le formulaire et l'Edge Function `site-lead`
      // affichent ces nombres tels quels, sans rien recalculer.
      //   std*  = particulier (TVA du pays si UE) ; b2b* = case B2B cochée.
      btn.dataset.calcPrice = JSON.stringify({
        basePrice: cents(r.basePrice),
        discountPct: r.discountPct,
        discount: cents(r.discount),
        subtotalHT: cents(r.subtotalHT),
        vatRate: r.stdVatRate,
        vatAmount: cents(r.stdVatAmount),
        totalTTC: cents(r.stdTotalTTC),
        savings: cents(r.stdSavings),
        b2bSavings: cents(r.b2bSavings),
        b2bSavingsRate: r.b2bSavingsRate,
        catalogTTC: cents(r.catalogTTC),
        eu: !!r.country.eu,
        b2b: state.b2b,
        countryCode: state.country,
      })
    }

    function render() {
      // Le stock informe, il ne recale plus rien (25/10/2026).
      renderStock()
      const r = compute()
      syncTrigger(r)
      $('calc-selection')!.textContent = `${DATA.models[state.model].label} — ${DATA.woodLabels[state.wood]}`
      $('calc-base')!.textContent = fmtEUR(r.basePrice)
      $('calc-discount-label')!.textContent = `${L.discountLabel} −${Math.round(r.discountRate * 100)} %`
      $('calc-discount')!.textContent = '− ' + fmtEUR(r.discount)
      $('calc-subtotal')!.textContent = fmtEUR(r.subtotalHT)

      const vatWrap = $('calc-vat-wrap')!
      if (r.country.eu && !state.b2b) {
        vatWrap.style.display = ''
        $('calc-vat-label')!.textContent = `${L.vat} ${r.country.name} ${fmtVAT(r.vatRate)}`
        $('calc-vat')!.textContent = fmtEUR(r.vatAmount)
        $('calc-final-label')!.textContent = L.finalTTC
        $('calc-final-note')!.textContent = L.finalIncluded
        $('calc-extra-note')!.innerHTML = ''
      } else if (state.b2b) {
        vatWrap.style.display = 'none'
        $('calc-final-label')!.textContent = L.finalB2B
        $('calc-final-note')!.textContent = L.finalB2BNote
        $('calc-extra-note')!.innerHTML = L.b2bNote
      } else {
        vatWrap.style.display = 'none'
        $('calc-final-label')!.textContent = L.finalExtUE
        $('calc-final-note')!.textContent = L.finalExtUENote
        $('calc-extra-note')!.innerHTML = r.country.note || ''
      }
      if (state.mode === 'showroom') $('calc-final-note')!.textContent = L.finalShowroom

      const finalEl = $('calc-final')!
      finalEl.classList.remove('price-update')
      void finalEl.offsetWidth
      finalEl.textContent = fmtEUR(r.finalTTC)
      finalEl.classList.add('price-update')
      const savingsNote = $('calc-savings-note')!
      if (r.b2bEU) {
        $('calc-savings-label')!.textContent = L.savingsB2B
        $('calc-savings')!.textContent = `${fmtEUR(r.savings)} (−${fmtVAT(r.savingsRate)})`
        savingsNote.style.display = ''
        savingsNote.textContent = L.savingsB2BNote
          .replace('{discountRate}', fmtVAT(r.discountPct))
          .replace('{vatRate}', fmtVAT(r.country.vat))
          .replace('{catalog}', fmtEUR(r.catalogTTC))
          .replace('{discount}', fmtEUR(r.discount))
      } else {
        $('calc-savings-label')!.textContent = L.savings
        $('calc-savings')!.textContent = fmtEUR(r.savings)
        savingsNote.style.display = 'none'
        savingsNote.textContent = ''
      }
    }

    // ══ 📦 DISPONIBILITÉ AU SHOWROOM (refonte 25/10/2026) ═════════════════════
    // David : « même si l'instrument n'est pas en stock au showroom, la
    // personne [doit pouvoir] calculer le prix ». Donc :
    //  · TOUS les modèles et TOUS les bois restent cliquables, dans les deux
    //    modes : le prix se calcule toujours ;
    //  · le stock INFORME : une petite mention sous chaque bouton, et un bloc
    //    d'état pour le couple choisi (disponible / arrive / sur commande) ;
    //  · source inconnue (rien lu au build, /api/stock injoignable) → aucune
    //    mention : jamais de stock inventé.
    type StockRow = { model: string; wood: string; status: 'disponible' | 'en_transit'; arrival: string | null; arrivalLabel?: string | null }
    let stock: StockRow[] = Array.isArray(DATA.stock) ? DATA.stock : []
    let stockKnown: boolean = DATA.stockKnown === true
    const stockLocale = DATA.locale || locale
    const LANG: string = DATA.lang || 'fr'

    /** null = aucune pièce connue pour ce couple (= sur commande). */
    function availOf(model: string, wood: string): StockRow | null {
      const rows = stock.filter((r) => r.model === model && r.wood === wood)
      const ready = rows.find((r) => r.status === 'disponible')
      if (ready) return ready
      const transit = rows
        .filter((r) => r.status === 'en_transit')
        .sort((a, b) => (a.arrival ?? '9999').localeCompare(b.arrival ?? '9999'))
      // Une période connue (colonne L) l'emporte sur « sans période ».
      return transit.find((r) => r.arrivalLabel) ?? transit[0] ?? null
    }
    type StockState = 'in' | 'transit' | 'out'
    const stateOf = (row: StockRow | null): StockState => (!row ? 'out' : row.status === 'disponible' ? 'in' : 'transit')
    const woodKeys = (model: string) => Object.keys(DATA.models[model].woods)
    function modelState(model: string): StockState {
      const st = woodKeys(model).map((w) => stateOf(availOf(model, w)))
      return st.includes('in') ? 'in' : st.includes('transit') ? 'transit' : 'out'
    }

    function fmtDate(iso: string | null): string | null {
      if (!iso) return null
      const d = new Date(`${iso}T12:00:00Z`)
      if (Number.isNaN(d.getTime())) return null
      return new Intl.DateTimeFormat(stockLocale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d)
    }
    const PILLS: StockPillLabels = L.pills
    /** Texte de la pastille d'un couple (« En stock à Paris », « Arrive le 9-13 nov. », « Sur commande »). */
    function pillText(row: StockRow | null): string {
      const st = stateOf(row)
      if (st === 'in') return PILLS.in
      if (st === 'transit') return transitPillText(PILLS, row!.arrivalLabel ?? null, row!.arrival, LANG, stockLocale)
      return PILLS.order
    }

    /**
     * Pastille sous un bouton (jamais bloquante). '' = rien.
     * `data-stock` sur le bouton porte l'anneau / le relief (voir global.css,
     * `.calc-wood[data-stock=…]`, `.calc-model[data-stock=in]`).
     */
    function setTag(btn: HTMLButtonElement, text: string, st: PillKind | '') {
      let tag = btn.querySelector<HTMLElement>('.calc-avail')
      if (!text || !st) {
        tag?.remove()
        delete btn.dataset.stock
        return
      }
      if (!tag) {
        tag = document.createElement('span')
        btn.appendChild(tag)
      }
      btn.dataset.stock = st
      tag.className = 'calc-avail mt-2 flex' + (btn.classList.contains('calc-wood') ? ' justify-center' : '')
      tag.innerHTML = stockPillHtml(st, text)
    }

    function renderStock() {
      // Mode « achat en ligne » (choix du 25/10/2026) : tout bois, tout modèle se
      // commande en ligne et est livré ; l'état du showroom n'y change rien. On
      // n'affiche donc AUCUNE pastille (sinon « Sur commande » partout, ce qui
      // ferait croire à un délai ou à un manque). Seule exception utile : si le
      // couple choisi est AUSSI au showroom, un encart secondaire le dit et
      // propose de basculer vers l'achat au showroom (−7 %).
      const showroom = state.mode === 'showroom'
      document.querySelectorAll<HTMLButtonElement>('.calc-model').forEach((btn) => {
        const m = btn.dataset.model!
        const st = modelState(m)
        // Modèle : « En stock à Paris » si au moins un bois est disponible ;
        // « Arrive bientôt » si au moins un arrive (sans date : plusieurs bois).
        const text = st === 'in' ? PILLS.in : st === 'transit' ? PILLS.soon : PILLS.order
        setTag(btn, stockKnown && showroom ? text : '', stockKnown && showroom ? st : '')
      })
      document.querySelectorAll<HTMLButtonElement>('.calc-wood').forEach((btn) => {
        const row = availOf(state.model, btn.dataset.wood!)
        setTag(btn, stockKnown && showroom ? pillText(row) : '', stockKnown && showroom ? stateOf(row) : '')
      })

      const box = $('calc-stock-status')!
      const head = $('calc-stock-status-head')!
      const sub = $('calc-stock-status-sub')!
      const reqBtn = $('calc-stock-request') as HTMLButtonElement
      const switchBtn = $('calc-stock-switch') as HTMLButtonElement
      if (!stockKnown) { box.hidden = true; box.dataset.state = ''; return }
      const row = availOf(state.model, state.wood)
      const st = stateOf(row)

      if (!showroom) {
        reqBtn.hidden = true
        if (st !== 'in') { box.hidden = true; box.dataset.state = ''; return }
        box.hidden = false
        box.dataset.state = 'in'
        head.innerHTML = stockPillHtml('in', PILLS.in)
        sub.textContent = L.stockOnlineAlsoIn
        switchBtn.hidden = false
        return
      }

      switchBtn.hidden = true
      const when = arrivalText(row)
      // Phrase complète (pour la demande envoyée à David) ; à l'écran, la
      // pastille porte l'état (en stock / arrive), le texte plein reste pour « sur commande ».
      const full =
        st === 'in' ? L.stockStateIn
        : st === 'transit' ? (when ? String(L.stockStateTransit).replace('{period}', when) : L.stockStateTransitSoon)
        : L.stockStateOut
      box.hidden = false
      box.dataset.state = st
      head.innerHTML = st === 'out' ? '' : stockPillHtml(st, pillText(row))
      if (st === 'out') head.textContent = L.stockStateOut
      sub.textContent = st === 'in' ? L.stockStateInSub : st === 'transit' ? L.stockStateTransitSub : L.stockStateOutSub
      // « Faire la demande » : seulement quand le couple n'est PAS au showroom.
      reqBtn.hidden = st === 'in'
      const label = `${DATA.models[state.model].label} — ${DATA.woodLabels[state.wood]}`
      reqBtn.dataset.calcModel = state.model
      reqBtn.dataset.calcWood = state.wood
      reqBtn.dataset.calcMode = state.mode
      reqBtn.dataset.calcRecap = [label, full].join(' · ')
    }

    /** Période (longue) ou date d'arrivée lisible, ou null — pour la phrase complète. */
    function arrivalText(row: StockRow | null): string | null {
      if (!row || row.status !== 'en_transit') return null
      return formatArrivalLabel(row.arrivalLabel ?? null, LANG) ?? fmtDate(row.arrival)
    }

    $('calc-stock-switch')?.addEventListener('click', () => {
      state.mode = 'showroom'
      syncModeButtons()
      render()
    })

    /**
     * Mise à jour en direct : la page dispatche `neotone:stock` après avoir lu
     * /api/stock (voir NeotonePage.astro). `detail` = { lines, known } — un
     * simple tableau (ancien format) reste accepté.
     */
    document.addEventListener('neotone:stock', (e) => {
      const d = (e as CustomEvent).detail
      if (Array.isArray(d)) { stock = d; stockKnown = d.length > 0 }
      else if (d && typeof d === 'object') { stock = Array.isArray(d.lines) ? d.lines : []; stockKnown = d.known === true }
      render()
    })

    /** Synchronise l'aspect des deux boutons de mode avec `state.mode`. */
    function syncModeButtons() {
      document.querySelectorAll<HTMLButtonElement>('.calc-mode').forEach((b) => {
        const on = b.dataset.mode === state.mode
        b.classList.toggle('border-copper', on)
        b.classList.toggle('bg-copper/10', on)
        b.classList.toggle('border-ink/15', !on)
        b.setAttribute('aria-checked', on ? 'true' : 'false')
      })
    }

    /**
     * Liens venus des cartes « Deux modèles » (section #modeles, 09/10/2026) :
     * `<a href="#calculateur" data-goto-calc-mode="online" data-goto-calc-model="one">`.
     * « Pas en stock actuellement — disponible à l'achat en ligne (−5 %) » place
     * le calculateur en livraison sur CE modèle ; « à essayer au showroom » le
     * place en showroom. Le défilement vers #calculateur reste celui du lien.
     */
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest<HTMLElement>('[data-goto-calc-mode]')
      if (!a) return
      const mode = a.dataset.gotoCalcMode
      const model = a.dataset.gotoCalcModel
      if (mode === 'online' || mode === 'showroom') state.mode = mode
      if (model && DATA.models[model]) state.model = model
      syncModeButtons()
      render()
    })

    function bindGroup(selector: string, key: 'model' | 'wood' | 'mode', attr: string) {
      document.querySelectorAll<HTMLButtonElement>(selector).forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll<HTMLButtonElement>(selector).forEach((b) => {
            b.classList.remove('border-copper', 'bg-copper/10')
            b.classList.add('border-ink/15')
            b.setAttribute('aria-checked', 'false')
          })
          btn.classList.add('border-copper', 'bg-copper/10')
          btn.classList.remove('border-ink/15')
          btn.setAttribute('aria-checked', 'true')
          ;(state as any)[key] = btn.dataset[attr]
          render()
        })
      })
    }
    bindGroup('.calc-mode', 'mode', 'mode')
    bindGroup('.calc-model', 'model', 'model')
    bindGroup('.calc-wood', 'wood', 'wood')

    ;($('calc-country') as HTMLSelectElement).addEventListener('change', (e) => { state.country = (e.target as HTMLSelectElement).value; render() })
    ;($('calc-b2b') as HTMLInputElement).addEventListener('change', (e) => { state.b2b = (e.target as HTMLInputElement).checked; render() })
    render()
  }
</script>
