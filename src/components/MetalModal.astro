---
// Modal plein écran détaillant un métal Yishama (nitruré / inox / Ember).
// Même mécanique que <WoodModal /> pour les essences du Neotone.
// 🖼️ 09/2026 — la fenêtre montre désormais LA VRAIE PHOTO de l'acier
// (même source de vérité que les cartes de la page : `metals[].photo`
// dans src/data/yishama.ts, jamais recopiée en dur ici). Les clichés
// sont sur fond NOIR et la modale sur fond crème → cadre sombre à bords
// arrondis plutôt qu'un détourage. Clic sur la photo = agrandissement,
// délégué à la <Lightbox /> DÉJÀ présente sur la page (groupe
// `data-lb="metal-modal"`), donc aucun second mécanisme à écrire.
// Données injectées côté client. Inclure une fois sur la page.
import { metals } from '@/data/yishama'
import { getDict } from '@/i18n/dict'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const y = t.yishama
const d = t.data

const metalData = Object.fromEntries(
  metals.map((m) => [
    m.key,
    {
      name: d.metalNames[m.key],
      en: d.metalEnNames[m.key],
      tag: d.metalTags[m.key],
      desc: d.metalDescriptions[m.key],
      sound: d.metalSound[m.key],
      care: d.metalCare[m.key],
      best: d.metalBest[m.key],
      grad: m.grad,
      photo: m.photo,
      alt: y.metalPhotoAlts[m.key],
    },
  ])
)
const firstPhoto = metals[0].photo
const labels = { eyebrow: y.metalModalEyebrow, sound: y.metalLabelSound, care: y.metalLabelCare, best: y.metalLabelBest, close: y.metalModalClose, zoom: y.lightbox.zoom }
---

<div id="metal-modal" class="wood-modal" data-zoom-label={labels.zoom} role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="metal-modal-title">
  <div class="wood-modal-content">
    <button class="wood-modal-close" type="button" aria-label={labels.close}>×</button>
    <div class="wood-modal-eyebrow">{labels.eyebrow}</div>
    <div class="metal-modal-head">
      <span class="metal-modal-photo-frame">
        <img
          id="metal-modal-photo"
          class="metal-modal-photo"
          src={firstPhoto}
          width="800"
          height="800"
          alt=""
          data-lb="metal-modal"
          aria-label={labels.zoom}
          decoding="async"
        />
      </span>
      <div>
        <h3 class="wood-modal-title" id="metal-modal-title">…</h3>
        <div class="wood-modal-en" id="metal-modal-en">…</div>
        <span class="wood-modal-supp" id="metal-modal-tag">…</span>
      </div>
    </div>
    <p class="wood-modal-desc" id="metal-modal-desc">…</p>
    <dl class="metal-facts">
      <div><dt>{labels.sound}</dt><dd id="metal-modal-sound">…</dd></div>
      <div><dt>{labels.care}</dt><dd id="metal-modal-care">…</dd></div>
      <div><dt>{labels.best}</dt><dd id="metal-modal-best">…</dd></div>
    </dl>
    <p class="metal-modal-source">{y.metalSource}</p>
  </div>
</div>

<script type="application/json" id="metal-data" set:html={JSON.stringify(metalData)}></script>

<script>
  const dataEl = document.getElementById('metal-data')
  const modal = document.getElementById('metal-modal')
  if (dataEl && modal) {
    const metals = JSON.parse(dataEl.textContent || '{}')
    const elPhoto = document.getElementById('metal-modal-photo') as HTMLImageElement
    const zoomLabel = modal.getAttribute('data-zoom-label') || ''
    // La lightbox partagée de la page (z-index 10000 > 9999 de la modale).
    const lightbox = document.getElementById('lightbox')
    const lbOpen = () => !!lightbox && lightbox.classList.contains('is-open')
    const elTitle = document.getElementById('metal-modal-title')!
    const elEn = document.getElementById('metal-modal-en')!
    const elTag = document.getElementById('metal-modal-tag')!
    const elDesc = document.getElementById('metal-modal-desc')!
    const elSound = document.getElementById('metal-modal-sound')!
    const elCare = document.getElementById('metal-modal-care')!
    const elBest = document.getElementById('metal-modal-best')!
    const closeBtn = modal.querySelector<HTMLElement>('.wood-modal-close')!
    let lastFocused: HTMLElement | null = null

    // Pas de `loading="lazy"` (la modale est masquée au chargement : l'image
    // n'arriverait qu'au moment du clic, cadre noir le temps du transfert).
    // On précharge aussi les deux autres photos, sans dépendance.
    Object.keys(metals).forEach((k) => { const im = new Image(); im.src = metals[k].photo })

    function openMetal(key: string) {
      const m = metals[key]
      if (!m) return
      lastFocused = document.activeElement as HTMLElement
      elPhoto.src = m.photo
      elPhoto.alt = m.alt
      elPhoto.setAttribute('aria-label', m.alt ? m.alt + ' — ' + zoomLabel : zoomLabel)
      elTitle.textContent = m.name
      elEn.textContent = m.en
      elTag.textContent = m.tag
      elDesc.textContent = m.desc
      elSound.textContent = m.sound
      elCare.textContent = m.care
      elBest.textContent = m.best
      modal!.classList.add('is-open')
      modal!.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
      setTimeout(() => closeBtn.focus(), 50)
    }
    function closeMetal() {
      modal!.classList.remove('is-open')
      modal!.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus()
    }
    document.querySelectorAll<HTMLElement>('.wood-card[data-metal]').forEach((card) => {
      card.addEventListener('click', () => openMetal(card.dataset.metal || ''))
    })
    closeBtn.addEventListener('click', closeMetal)
    modal.addEventListener('click', (e) => { if (e.target === modal && !lbOpen()) closeMetal() })
    // Échap : l'agrandissement d'abord, la fenêtre ensuite. La lightbox a son
    // propre écouteur Escape ; ici on s'efface tant qu'elle est ouverte, sinon
    // une seule pression fermerait les deux d'un coup.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return
      if (lbOpen()) return
      if (modal.classList.contains('is-open')) closeMetal()
    }, true) // capture : passe AVANT l'écouteur (bulle) de la lightbox, sinon
             // elle aurait déjà retiré `is-open` et le test ci-dessus serait faux.
    // En se fermant, la lightbox remet `body.overflow` à vide — alors que la
    // fenêtre de l'acier, elle, est toujours ouverte. On rebloque le défilement.
    if (lightbox) {
      let wasOpen = false
      new MutationObserver(() => {
        const now = lbOpen()
        if (wasOpen && !now && modal.classList.contains('is-open')) {
          document.body.style.overflow = 'hidden'
        }
        wasOpen = now
      }).observe(lightbox, { attributes: true, attributeFilter: ['class'] })
    }
  }
</script>

<style>
  /* Cadre sombre : les photos Yishama sont sur fond noir, la modale sur fond
     crème. Le cadre assume ce noir (bords arrondis) au lieu de détourer. */
  .metal-modal-photo-frame {
    display: block;
    flex: 0 0 auto;
    width: clamp(112px, 20vw, 176px);
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    overflow: hidden;
    background: #0b0b0b;
    box-shadow: 0 10px 24px rgba(31, 22, 17, 0.24);
  }
  .metal-modal-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
  }
</style>
