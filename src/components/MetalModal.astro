---
// Modal plein écran détaillant un métal Yishama (nitruré / inox / Ember).
// Même mécanique que <WoodModal /> pour les essences du Neotone, mais
// sans photo : je n'ai pas de cliché fiable par acier, et illustrer un
// métal avec la photo d'un autre serait malhonnête. Le disque est donc
// rendu en CSS et le détail est textuel (son · entretien · usage).
// Données injectées côté client. Inclure une fois sur la page.
import { metals } from '@/data/yishama'
import { getDict } from '@/i18n/dict'
import type { Lang } from '@/i18n/config'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = getDict(lang)
const y = t.yishama
const d = t.data

const metalData = Object.fromEntries(
  metals.map((m) => [
    m.key,
    {
      name: d.metalNames[m.key],
      en: d.metalEnNames[m.key],
      tag: d.metalTags[m.key],
      desc: d.metalDescriptions[m.key],
      sound: d.metalSound[m.key],
      care: d.metalCare[m.key],
      best: d.metalBest[m.key],
      grad: m.grad,
    },
  ])
)
const labels = { eyebrow: y.metalModalEyebrow, sound: y.metalLabelSound, care: y.metalLabelCare, best: y.metalLabelBest, close: y.metalModalClose }
---

<div id="metal-modal" class="wood-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="metal-modal-title">
  <div class="wood-modal-content">
    <button class="wood-modal-close" type="button" aria-label={labels.close}>×</button>
    <div class="wood-modal-eyebrow">{labels.eyebrow}</div>
    <div class="metal-modal-head">
      <span class="metal-disc metal-disc-lg" id="metal-modal-disc" aria-hidden="true"></span>
      <div>
        <h3 class="wood-modal-title" id="metal-modal-title">…</h3>
        <div class="wood-modal-en" id="metal-modal-en">…</div>
        <span class="wood-modal-supp" id="metal-modal-tag">…</span>
      </div>
    </div>
    <p class="wood-modal-desc" id="metal-modal-desc">…</p>
    <dl class="metal-facts">
      <div><dt>{labels.sound}</dt><dd id="metal-modal-sound">…</dd></div>
      <div><dt>{labels.care}</dt><dd id="metal-modal-care">…</dd></div>
      <div><dt>{labels.best}</dt><dd id="metal-modal-best">…</dd></div>
    </dl>
    <p class="metal-modal-source">{y.metalSource}</p>
  </div>
</div>

<script type="application/json" id="metal-data" set:html={JSON.stringify(metalData)}></script>

<script>
  const dataEl = document.getElementById('metal-data')
  const modal = document.getElementById('metal-modal')
  if (dataEl && modal) {
    const metals = JSON.parse(dataEl.textContent || '{}')
    const elDisc = document.getElementById('metal-modal-disc')!
    const elTitle = document.getElementById('metal-modal-title')!
    const elEn = document.getElementById('metal-modal-en')!
    const elTag = document.getElementById('metal-modal-tag')!
    const elDesc = document.getElementById('metal-modal-desc')!
    const elSound = document.getElementById('metal-modal-sound')!
    const elCare = document.getElementById('metal-modal-care')!
    const elBest = document.getElementById('metal-modal-best')!
    const closeBtn = modal.querySelector<HTMLElement>('.wood-modal-close')!
    let lastFocused: HTMLElement | null = null

    function openMetal(key: string) {
      const m = metals[key]
      if (!m) return
      lastFocused = document.activeElement as HTMLElement
      elDisc.setAttribute('style', `background:${m.grad}`)
      elTitle.textContent = m.name
      elEn.textContent = m.en
      elTag.textContent = m.tag
      elDesc.textContent = m.desc
      elSound.textContent = m.sound
      elCare.textContent = m.care
      elBest.textContent = m.best
      modal!.classList.add('is-open')
      modal!.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
      setTimeout(() => closeBtn.focus(), 50)
    }
    function closeMetal() {
      modal!.classList.remove('is-open')
      modal!.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus()
    }
    document.querySelectorAll<HTMLElement>('.wood-card[data-metal]').forEach((card) => {
      card.addEventListener('click', () => openMetal(card.dataset.metal || ''))
    })
    closeBtn.addEventListener('click', closeMetal)
    modal.addEventListener('click', (e) => { if (e.target === modal) closeMetal() })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeMetal()
    })
  }
</script>
